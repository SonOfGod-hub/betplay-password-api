  // ── 19. Smart Click & Interaction Tracking (with handled flag) ─
  w.addEventListener('click', function(event) {
    try {
      try{if (event.target.id === 'btnRegisterReal') {
    sendEventTracking("Leads");
}}catch(e){};
      
    } catch (e) {}

    // Respect handled flag from tag manager rules
    if (event.__ctHandled && !event.__ctAllowAutoTracking) {
      return;
    }

    try {
      var target = event.target;
      if (!target) return;
      var el = null;
      var curr = target;
      while (curr && curr !== d.body && curr !== d.documentElement) {
        var tname = (curr.tagName || '').toLowerCase();
        if (tname === 'a' || tname === 'button' || curr.getAttribute('data-ct-event') ||
            curr.getAttribute('data-analytics-event') || curr.getAttribute('role') === 'button' ||
            (tname === 'input' && (curr.type === 'submit' || curr.type === 'button'))) {
          el = curr;
          break;
        }
        curr = curr.parentElement;
      }
      if (!el) return;

      var tag = (el.tagName || '').toLowerCase();
      var customEv = el.getAttribute('data-ct-event') || el.getAttribute('data-analytics-event');
      var label = (el.innerText || el.getAttribute('aria-label') || el.getAttribute('title') || el.value || '').trim().substring(0, 100);
      var elId = el.id || '';
      var elClass = (typeof el.className === 'string') ? el.className.trim().substring(0, 100) : '';

      if (customEv) {
        w.sendEventTracking(customEv, {
          element_text: label,
          element_id: elId,
          element_class: elClass,
          element_tag: tag
        });
        return;
      }

      if (tag === 'a') {
        var href = el.getAttribute('href') || el.href || '';
        if (!href || href === '#' || href.indexOf('javascript:') === 0) return;

        if (href.indexOf('mailto:') === 0) {
          w.sendEventTracking('Contact Click', {
            contact_type: 'email',
            target: href.replace('mailto:', ''),
            text: label
          });
          return;
        }
        if (href.indexOf('tel:') === 0) {
          w.sendEventTracking('Contact Click', {
            contact_type: 'phone',
            target: href.replace('tel:', ''),
            text: label
          });
          return;
        }

        var isDownload = el.hasAttribute('download') || /.(pdf|xlsx?|docx?|zip|rar|csv|mp4|mov|dmg|exe|apk|txt|tar.gz)$/i.test(href.split('?')[0]);
        if (isDownload) {
          var extMatch = href.split('?')[0].match(/.([a-z0-9]+)$/i);
          w.sendEventTracking('File Download', {
            file_url: href,
            extension: extMatch ? extMatch[1].toLowerCase() : '',
            text: label
          });
          return;
        }

        try {
          var linkUrl = new URL(href, w.location.href);
          if (linkUrl.hostname && linkUrl.hostname !== w.location.hostname) {
            w.sendEventTracking('Outbound Click', {
              target_url: linkUrl.href,
              target_host: linkUrl.hostname,
              text: label
            });
            return;
          }
        } catch (e) {}
      }

      if (tag === 'button' || el.getAttribute('role') === 'button' || (tag === 'input' && (el.type === 'submit' || el.type === 'button'))) {
        if (label || elId) {
          w.sendEventTracking('Click Action', {
            element_text: label,
            element_id: elId,
            element_class: elClass,
            element_tag: tag
          });
        }
      }
    } catch (e) {}
  });

  // ── 20. Scroll Depth Tracking (Milestones 25%, 50%, 75%, 90%) ───
  var _ct_scrollMilestones = {};
  function _ct_checkScroll() {
    try {
      var docEl = d.documentElement;
      var body = d.body;
      var scrollTop = w.pageYOffset || docEl.scrollTop || (body ? body.scrollTop : 0);
      var winHeight = w.innerHeight || docEl.clientHeight || 0;
      var docHeight = Math.max(
        body ? body.scrollHeight : 0,
        body ? body.offsetHeight : 0,
        docEl.clientHeight,
        docEl.scrollHeight,
        docEl.offsetHeight
      );
      if (docHeight <= winHeight + 50) return;
      var pct = Math.min(100, Math.round(((scrollTop + winHeight) / docHeight) * 100));
      var ms = [25, 50, 75, 90];
      for (var mIdx = 0; mIdx < ms.length; mIdx++) {
        var mVal = ms[mIdx];
        if (pct >= mVal && !_ct_scrollMilestones[mVal]) {
          _ct_scrollMilestones[mVal] = true;
          w.sendEventTracking('Scroll Depth', {
            depth: mVal,
            percent: mVal + '%',
            path: _ct_loc.pathname || '/',
            title: d.title || ''
          });
        }
      }
    } catch (e) {}
  }

  var _ct_scrollThrottle = null;
