(function(w, d) {
  'use strict';

  // ── 1. Container / Account Guard & Multi-Instance Support ──────
  var _ct_aid = "667f0fb3b836e386827a1572";
  w.__CT_CONTAINERS__ = w.__CT_CONTAINERS__ || {};
  if (_ct_aid && w.__CT_CONTAINERS__[_ct_aid]) {
    return;
  }
  if (_ct_aid) {
    w.__CT_CONTAINERS__[_ct_aid] = true;
  }
  w.__CT_ANALYTICS_INITIALIZED__ = true;

  var _ct_sdk_version = '2.6.0';
  var _ct_api = 'https://ctag.containermedia.net/api';
  var _ct_iapi = 'https://adstudio.containermedia.net/api';
  var _ct_fetch = (typeof w.fetch === 'function') ? w.fetch.bind(w) : null;
  var _ct_debug = !!(w.__CT_DEBUG__ || (w.location && (w.location.search || '').indexOf('ct_debug=1') !== -1));

  // ── 2. Observability & Telemetry Metrics ────────────────────────
  var _ct_metrics = {
    events_created: 0,
    events_queued: 0,
    events_sent: 0,
    events_deduplicated: 0,
    events_dropped: 0,
    events_persisted: 0,
    events_recovered: 0,
    batches_sent: 0,
    batches_failed: 0,
    batches_retried: 0,
    queue_size: 0,
    critical_store_size: 0
  };
  w.__CT_METRICS__ = _ct_metrics;

  function _ct_log() {
    if (_ct_debug && w.console && typeof w.console.log === 'function') {
      var args = ['[CTAG v' + _ct_sdk_version + ']'];
      for (var i = 0; i < arguments.length; i++) args.push(arguments[i]);
      w.console.log.apply(w.console, args);
    }
  }

  // ── 3. Storage Layer (Memory fallback + throttled activity) ────
  var _ct_mem = {};
  var _ct_storage = {
    get: function(k, ss) {
      try {
        var s = ss ? w.sessionStorage : w.localStorage;
        return s ? s.getItem(k) : _ct_mem[k];
      } catch (e) {
        return _ct_mem[k] || null;
      }
    },
    set: function(k, v, ss) {
      try {
        var s = ss ? w.sessionStorage : w.localStorage;
        if (s) s.setItem(k, v);
      } catch (e) {}
      _ct_mem[k] = v;
    },
    remove: function(k, ss) {
      try {
        var s = ss ? w.sessionStorage : w.localStorage;
        if (s) s.removeItem(k);
      } catch (e) {}
      delete _ct_mem[k];
    }
  };

  var _ct_lastActWritten = 0;
  function _ct_updateActivity(ts) {
    var now = ts || Date.now();
    _ct_mem['CT_LAST_ACT'] = String(now);
    if (now - _ct_lastActWritten > 30000) {
      _ct_lastActWritten = now;
      _ct_storage.set('CT_LAST_ACT', String(now));
    }
  }

  // ── 4. UUID & Safe Serialization ──────────────────────────────
  function _ct_uuid() {
    try {
      if (w.crypto && typeof w.crypto.randomUUID === 'function') return w.crypto.randomUUID();
      return '10000000-1000-4000-8000-100000000000'.replace(/[018]/g, function(c) {
        var r = w.crypto.getRandomValues(new Uint8Array(1))[0];
        return (c ^ (r & (15 >> (c / 4)))).toString(16);
      });
    } catch (e) {}
    return 'ct-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 9) + '-' + Math.random().toString(36).substring(2, 9);
  }

  function _ct_safeStringify(obj) {
    try {
      return JSON.stringify(obj);
    } catch (e) {
      try {
        var seen = [];
        return JSON.stringify(obj, function(k, v) {
          if (typeof v === 'object' && v !== null) {
            if (seen.indexOf(v) !== -1) return undefined;
            seen.push(v);
          }
          return v;
        });
      } catch (e2) {
        return '{}';
      }
    }
  }

  // ── 5. Query Parameters & URL Sanitizer ────────────────────────
  var _ct_allowedQueryParams = {
    'utm_source':1,'utm_medium':1,'utm_campaign':1,'utm_term':1,'utm_content':1,'utm_id':1,
    'ctgid':1,'gclid':1,'dclid':1,'wbraid':1,'gbraid':1,'fbclid':1,'_fbc':1,'msclkid':1,
    'ttclid':1,'twclid':1,'li_fat_id':1,'sccid':1,'epik':1,'rdt_cid':1,'ttd_clkid':1,
    'tdid':1,'xandr_uid':1,'anj_uid':1,'sa_cid':1,'prp_click_id':1,'gum':1,'adtk':1,
    'is_click_id':1,'btag':1,'afid':1,'aff_click_id':1
  };

  function _ct_sanitizeUrl(rawUrl) {
    if (!rawUrl) return '';
    try {
      var parts = rawUrl.split('#')[0].split('?');
      var base = parts[0];
      var qs = parts[1];
      if (!qs) return base;
      var pairs = qs.split('&');
      var clean = [];
      for (var i = 0; i < pairs.length; i++) {
        if (!pairs[i]) continue;
        var eq = pairs[i].indexOf('=');
        var k = eq !== -1 ? pairs[i].substring(0, eq) : pairs[i];
        var v = eq !== -1 ? pairs[i].substring(eq + 1) : '';
        var decK = '';
        try { decK = decodeURIComponent(k).toLowerCase(); } catch (e) { decK = k.toLowerCase(); }
        if (_ct_allowedQueryParams[decK]) {
          clean.push(k + '=' + v);
        }
      }
      return clean.length > 0 ? base + '?' + clean.join('&') : base;
    } catch (e) {
      return (rawUrl || '').split('#')[0].split('?')[0];
    }
  }

  function normalizeNavigationUrl(rawUrl, preserveHash) {
    if (!rawUrl) return '';
    try {
      var urlObj = new URL(rawUrl, w.location ? w.location.href : 'http://localhost');
      var path = urlObj.pathname || '/';
      if (preserveHash && urlObj.hash) {
        path += urlObj.hash;
      }
      return path;
    } catch (e) {
      return (rawUrl || '').split('?')[0];
    }
  }

  // ── 6. Identity Separation: anonymous_id vs user_id ────────────
  var _ct_layer = w.containerLayer = w.containerLayer || [];
  if (!_ct_layer[0]) _ct_layer.push({});
  _ct_layer[0].events = _ct_layer[0].events || [];

  // anonymous_id is permanent and immutable for CTAG
  var _ct_anon_id = _ct_storage.get('CT_ANON_ID') || _ct_storage.get('CTUUID');
  if (!_ct_anon_id) {
    _ct_anon_id = _ct_uuid();
    _ct_storage.set('CT_ANON_ID', _ct_anon_id);
    _ct_storage.set('CTUUID', _ct_anon_id); // legacy fallback
  }

  // user_id is separate, nullable, and set upon resolution
  var _ct_user_id = _ct_storage.get('CT_USER_ID') || null;
  _ct_layer[0].userid = _ct_user_id || _ct_anon_id;

  var _ct_account = _ct_aid || _ct_storage.get('CTID') || '';
  if (_ct_account) _ct_storage.set('CTID', _ct_account);

  var _ct_now = Date.now();
  var _ct_sid = _ct_storage.get('CTSID', true);
  var _ct_lastAct = parseInt(_ct_storage.get('CT_LAST_ACT') || '0', 10);
  var _ct_snum = parseInt(_ct_storage.get('CT_SNUM') || '1', 10);

  if (!_ct_sid || (_ct_now - _ct_lastAct > 1800000)) {
    _ct_sid = _ct_uuid();
    _ct_storage.set('CTSID', _ct_sid, true);
    if (_ct_lastAct > 0) {
      _ct_snum++;
      _ct_storage.set('CT_SNUM', _ct_snum.toString());
    }
  }
  _ct_updateActivity(_ct_now);

  // ── 7. Query Parameters & Click IDs Extraction ─────────────────
  function _ct_extractParams(searchStr) {
    var qp = {};
    var s = searchStr || '';
    if (s) {
      var pairs = s.replace(/^[?#&]/, '').split('&');
      for (var i = 0; i < pairs.length; i++) {
        if (!pairs[i]) continue;
        var eq = pairs[i].indexOf('=');
        var rk = eq !== -1 ? pairs[i].substring(0, eq) : pairs[i];
        var rv = eq !== -1 ? pairs[i].substring(eq + 1) : '';
        var k = '', v = '';
        try { k = decodeURIComponent(rk); } catch (e) { k = rk; }
        try { v = decodeURIComponent(rv.split('+').join(' ')); } catch (e) { v = rv; }
        if (k) qp[k] = v;
      }
    }
    return qp;
  }

  var _ct_loc = w.location || { href: '', pathname: '', search: '', hostname: '' };
  var _ct_qp = _ct_extractParams(_ct_loc.search);

  var _ct_incomingGid = _ct_qp['ctgid'] || '';
  var _ct_gid = _ct_incomingGid || _ct_storage.get('CTGID') || '';
  if (_ct_incomingGid) _ct_storage.set('CTGID', _ct_incomingGid);

  function _ct_buildUtm(qp) {
    return {
      source:   qp['utm_source']   || '',
      medium:   qp['utm_medium']   || '',
      campaign: qp['utm_campaign'] || '',
      term:     qp['utm_term']     || '',
      content:  qp['utm_content']  || '',
      id:       qp['utm_id']       || ''
    };
  }
  var _ct_utm = _ct_buildUtm(_ct_qp);

  function _ct_buildClicks(qp, incomingGid) {
    return {
      gclid:        qp['gclid']        || '',
      dclid:        qp['dclid']        || '',
      wbraid:       qp['wbraid']       || '',
      gbraid:       qp['gbraid']       || '',
      fbclid:       qp['fbclid']       || '',
      _fbc:         qp['_fbc']         || '',
      msclkid:      qp['msclkid']      || '',
      ttclid:       qp['ttclid']       || '',
      twclid:       qp['twclid']       || '',
      li_fat_id:    qp['li_fat_id']    || '',
      ScCid:        qp['ScCid']        || '',
      epik:         qp['epik']         || '',
      rdt_cid:      qp['rdt_cid']      || '',
      ttd_clkid:    qp['ttd_clkid']    || '',
      tdid:         qp['tdid']         || '',
      xandr_uid:    qp['xandr_uid']    || '',
      anj_uid:      qp['anj_uid']      || '',
      sa_cid:       qp['sa_cid']       || '',
      prp_click_id: qp['prp_click_id'] || '',
      gum:          qp['gum']          || '',
      adtk:         qp['adtk']         || '',
      is_click_id:  qp['is_click_id']  || '',
      btag:         qp['btag']         || '',
      afid:         qp['afid']         || '',
      aff_click_id: qp['aff_click_id'] || '',
      ctgid:        incomingGid        || ''
    };
  }
  var _ct_clicks = _ct_buildClicks(_ct_qp, _ct_incomingGid);

  var _ct_ref = d.referrer || '';
  var _ct_refHost = '';
  if (_ct_ref) {
    try {
      _ct_refHost = (new URL(_ct_ref)).hostname;
    } catch (e) {
      _ct_refHost = _ct_ref.split('/')[2] || '';
    }
  }
  var _ct_isExtRef = !!(_ct_refHost && _ct_refHost !== _ct_loc.hostname);

  // ── 8. Multi-Touch Channel Detection ───────────────────────────
  function _ct_detectChannel(utm, clicks, refHost, isExt) {
    var s = (utm.source || '').toLowerCase();
    var m = (utm.medium || '').toLowerCase();

    var isSocialSource = /facebook|instagram|twitter|t.co|linkedin|tiktok|pinterest|reddit|snapchat|youtube/i.test(s) ||
                         /facebook|instagram|twitter|t.co|linkedin|tiktok|pinterest|reddit|snapchat|youtube/i.test(refHost);

    if (clicks.gclid || clicks.wbraid || clicks.gbraid || clicks.msclkid) return 'Paid Search';
    if (clicks.fbclid || clicks._fbc || clicks.ttclid || clicks.twclid || clicks.li_fat_id || clicks.ScCid || clicks.epik || clicks.rdt_cid) return 'Paid Social';
    if (clicks.dclid || clicks.ttd_clkid || clicks.tdid || clicks.xandr_uid || clicks.anj_uid || clicks.sa_cid || clicks.prp_click_id || clicks.gum || clicks.adtk || clicks.is_click_id) return 'Programmatic';
    if (clicks.btag || clicks.afid || clicks.aff_click_id) return 'Affiliate';

    if (m === 'paidsocial' || m === 'paid_social' || m === 'social-paid' || m === 'social_paid') return 'Paid Social';
    if (m === 'cpc' || m === 'ppc' || m === 'paidsearch' || m === 'paid-search') {
      return isSocialSource ? 'Paid Social' : 'Paid Search';
    }
    if (m === 'display' || m === 'programmatic' || m === 'banner' || m === 'native' || m === 'cpm') return 'Programmatic';
    if (m === 'email' || m === 'newsletter') return 'Email';
    if (m === 'affiliate' || m === 'cpa' || m === 'cpl' || m === 'aff') return 'Affiliate';

    if (refHost) {
      if (/google|bing|yahoo|duckduckgo|ecosia|baidu|yandex/i.test(refHost)) return 'Organic Search';
      if (isSocialSource) return 'Organic Social';
      if (/stackadapt|propellerads|xandr|appnexus|thetradedesk|adsrvr|criteo|amazon-adsystem|advertising.amazon|doubleclick|googlesyndication/i.test(refHost)) return 'Programmatic';
      if (isExt) return 'Referral';
    }
    if (utm.source) return 'Campaign (' + utm.source + ')';
    return 'Direct';
  }

  var _ct_channel = _ct_detectChannel(_ct_utm, _ct_clicks, _ct_refHost, _ct_isExtRef);

  function _ct_buildTouch(utm, clicks, channel, ref, loc, refHost, isExt) {
    return {
      ts: new Date().toISOString(),
      source: utm.source || (isExt ? refHost : 'direct'),
      medium: utm.medium || (clicks.gclid || clicks.fbclid || clicks.msclkid ? 'cpc' : (isExt ? 'referral' : 'none')),
      campaign: utm.campaign || '',
      term: utm.term || '',
      content: utm.content || '',
      utm_id: utm.id || '',
      channel: channel,
      referrer: _ct_sanitizeUrl(ref),
      landing: _ct_sanitizeUrl(loc.href),
      gclid: clicks.gclid,
      dclid: clicks.dclid,
      wbraid: clicks.wbraid,
      gbraid: clicks.gbraid,
      fbclid: clicks.fbclid,
      _fbc: clicks._fbc,
      msclkid: clicks.msclkid,
      ttclid: clicks.ttclid,
      twclid: clicks.twclid,
      li_fat_id: clicks.li_fat_id,
      ScCid: clicks.ScCid,
      epik: clicks.epik,
      rdt_cid: clicks.rdt_cid,
      ttd_clkid: clicks.ttd_clkid,
      tdid: clicks.tdid,
      xandr_uid: clicks.xandr_uid,
      anj_uid: clicks.anj_uid,
      sa_cid: clicks.sa_cid,
      prp_click_id: clicks.prp_click_id,
      gum: clicks.gum,
      adtk: clicks.adtk,
      is_click_id: clicks.is_click_id,
      btag: clicks.btag,
      afid: clicks.afid,
      aff_click_id: clicks.aff_click_id,
      ctgid: clicks.ctgid
    };
  }

  var _ct_currentTouch = _ct_buildTouch(_ct_utm, _ct_clicks, _ct_channel, _ct_ref, _ct_loc, _ct_refHost, _ct_isExtRef);

  // ── 9. AttributionManager & Numeric attribution_version ───────
  var _ct_attrVer = parseInt(_ct_storage.get('CT_ATTR_VERSION') || '1', 10);
  if (isNaN(_ct_attrVer) || _ct_attrVer < 1) _ct_attrVer = 1;

  var _ct_firstTouch = null;
  try {
    var _ct_rawFT = _ct_storage.get('CT_FT');
    if (_ct_rawFT) _ct_firstTouch = JSON.parse(_ct_rawFT);
  } catch (e) {}
  if (!_ct_firstTouch) {
    _ct_firstTouch = Object.assign({}, _ct_currentTouch);
    try { _ct_storage.set('CT_FT', _ct_safeStringify(_ct_firstTouch)); } catch (e) {}
  }

  var _ct_lastTouch = null;
  try {
    var _ct_rawLT = _ct_storage.get('CT_LT');
    if (_ct_rawLT) _ct_lastTouch = JSON.parse(_ct_rawLT);
  } catch (e) {}

  var _ct_touches = [];
  try {
    var _ct_rawTouches = _ct_storage.get('CT_TOUCHES');
    if (_ct_rawTouches) _ct_touches = JSON.parse(_ct_rawTouches);
    if (!Array.isArray(_ct_touches)) _ct_touches = [];
  } catch (e) {}

  function _ct_hasAttributableCampaign(utm, clicks, incomingGid, isExt) {
    return !!(
      utm.source || utm.medium || utm.campaign || utm.term || utm.content || utm.id ||
      clicks.gclid || clicks.fbclid || clicks.msclkid || clicks.ttclid || clicks.sa_cid ||
      clicks.btag || clicks.afid || incomingGid || isExt
    );
  }

  var _ct_hasCampaign = _ct_hasAttributableCampaign(_ct_utm, _ct_clicks, _ct_incomingGid, _ct_isExtRef);

  if (!_ct_lastTouch || _ct_hasCampaign) {
    _ct_lastTouch = Object.assign({}, _ct_currentTouch);
    try { _ct_storage.set('CT_LT', _ct_safeStringify(_ct_lastTouch)); } catch (e) {}
  }

  if (_ct_hasCampaign || _ct_touches.length === 0) {
    _ct_touches.push({
      ts: _ct_currentTouch.ts,
      channel: _ct_channel,
      source: _ct_currentTouch.source,
      medium: _ct_currentTouch.medium,
      campaign: _ct_currentTouch.campaign,
      gclid: _ct_currentTouch.gclid,
      fbclid: _ct_currentTouch.fbclid,
      msclkid: _ct_currentTouch.msclkid,
      sa_cid: _ct_currentTouch.sa_cid
    });
    if (_ct_touches.length > 15) _ct_touches.shift();
    try { _ct_storage.set('CT_TOUCHES', _ct_safeStringify(_ct_touches)); } catch (e) {}
  }

  function _ct_getAttributionSnapshot() {
    return {
      attribution_version: _ct_attrVer,
      first_touch: _ct_firstTouch,
      last_touch: _ct_lastTouch,
      current_touch: _ct_currentTouch,
      touches: _ct_touches
    };
  }

  // ── 10. Device & Environment Detection ──────────────────────────
  function _ct_detectDevice() {
    var ua = (w.navigator && w.navigator.userAgent) ? w.navigator.userAgent.toLowerCase() : '';
    if (ua.indexOf('tablet') !== -1 || ua.indexOf('ipad') !== -1 || ua.indexOf('playbook') !== -1) return 'tablet';
    if (ua.indexOf('mobile') !== -1 || ua.indexOf('iphone') !== -1 || ua.indexOf('android') !== -1) return 'mobile';
    return 'desktop';
  }

  var _ct_device = _ct_detectDevice();
  var _ct_screen = (w.screen ? w.screen.width + 'x' + w.screen.height : '');
  var _ct_viewport = (w.innerWidth ? w.innerWidth + 'x' + w.innerHeight : '');
  var _ct_lang = (w.navigator && (w.navigator.language || w.navigator.userLanguage)) || '';
  var _ct_tz = '';
  try { _ct_tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}

  var _ct_pageViewId = _ct_uuid();
  var _ct_pageStartedAt = Date.now();

  // ── 11. CTGID Multi-Key Cache & Non-blocking Identity Resolution 
  var _ct_gidCache = {};
  try {
    var rawGidCache = _ct_storage.get('CT_GID_CACHE');
    if (rawGidCache) _ct_gidCache = JSON.parse(rawGidCache) || {};
  } catch (e) {}

  function _ct_saveGidCache() {
    try {
      var keys = Object.keys(_ct_gidCache);
      if (keys.length > 30) {
        delete _ct_gidCache[keys[0]];
      }
      _ct_storage.set('CT_GID_CACHE', _ct_safeStringify(_ct_gidCache));
    } catch (e) {}
  }

  function _ct_resolveUserAsync() {
    if (!_ct_gid) return;

    var cached = _ct_gidCache[_ct_gid] || (_ct_gidCache.ctgid === _ct_gid ? _ct_gidCache : null);
    if (cached && (Date.now() - cached.resolved_at < 86400000)) {
      if (cached.userid) {
        _ct_user_id = cached.userid;
        _ct_storage.set('CT_USER_ID', _ct_user_id);
        if (_ct_layer && _ct_layer[0]) _ct_layer[0].userid = _ct_user_id;
        _ct_log('CTGID resolved from multi-key cache:', _ct_user_id);
      }
      return;
    }

    var impUrl = _ct_iapi + '/creative/impression?ctgid=' + encodeURIComponent(_ct_gid);
    if (_ct_fetch) {
      _ct_fetch(impUrl, { method: 'GET', cache: 'no-store', credentials: 'omit' })
        .then(function(res) {
          if (!res || !res.ok) throw new Error('');
          return res.json();
        })
        .then(function(json) {
          if (json && json.userid) {
            _ct_user_id = String(json.userid);
            _ct_storage.set('CT_USER_ID', _ct_user_id);
            if (_ct_layer && _ct_layer[0]) _ct_layer[0].userid = _ct_user_id;
            _ct_gidCache[_ct_gid] = {
              userid: _ct_user_id,
              resolved_at: Date.now()
            };
            _ct_saveGidCache();
            _ct_log('CTGID resolved userid:', _ct_user_id);

            // Emit identity_link event so backend unifies anonymous_id and user_id
            if (typeof w.sendEventTracking === 'function') {
              w.sendEventTracking('identity_link', {
                anonymous_id: _ct_anon_id,
                user_id: _ct_user_id,
                ctgid: _ct_gid,
                resolved_at: Date.now(),
                allowDuplicate: true
              });
            }
          }
        })
        .catch(function() {});
    }
  }
  _ct_resolveUserAsync();

  // ── 12. IndexedDB Critical Store (Purchase, Lead, FTD, Deposit) ─
  var _ct_criticalStore = {
    db: null,
    ready: false,
    init: function() {
      try {
        if (!w.indexedDB) return;
        var req = w.indexedDB.open('CT_CRITICAL_STORE', 1);
        req.onupgradeneeded = function(e) {
          var db = e.target.result;
          if (!db.objectStoreNames.contains('critical_events')) {
            db.createObjectStore('critical_events', { keyPath: 'event_id' });
          }
        };
        req.onsuccess = function(e) {
          _ct_criticalStore.db = e.target.result;
          _ct_criticalStore.ready = true;
          _ct_criticalStore.recover();
        };
      } catch (e) {}
    },
    put: function(eventObj) {
      try {
        if (!_ct_criticalStore.ready || !_ct_criticalStore.db) return;
        var tx = _ct_criticalStore.db.transaction('critical_events', 'readwrite');
        var st = tx.objectStore('critical_events');
        eventObj._stored_at = Date.now();
        st.put(eventObj);
        _ct_metrics.events_persisted++;
      } catch (e) {}
    },
    remove: function(eventId) {
      try {
        if (!_ct_criticalStore.ready || !_ct_criticalStore.db || !eventId) return;
        var tx = _ct_criticalStore.db.transaction('critical_events', 'readwrite');
        tx.objectStore('critical_events').delete(eventId);
      } catch (e) {}
    },
    recover: function() {
      try {
        if (!_ct_criticalStore.ready || !_ct_criticalStore.db) return;
        var tx = _ct_criticalStore.db.transaction('critical_events', 'readonly');
        var req = tx.objectStore('critical_events').getAll();
        req.onsuccess = function(e) {
          var items = e.target.result || [];
          var now = Date.now();
          var ttl = 86400000; // 24 hours
          for (var i = 0; i < items.length; i++) {
            var item = items[i];
            if (now - (item._stored_at || 0) < ttl) {
              delete item._stored_at;
              _ct_metrics.events_recovered++;
