el":"Ingresa el valor*","nameLabel":"Nombre*","documentLabel":"Documento de identificaci\xf3n*","cardNumberLabel":"N\xfamero de la tarjeta*","securityCodeLabel":"C\xf3digo de seguridad","cvvLink":"CVV / CVC*","expirationDateLabel":"Fecha de vencimiento*","expirationMonthPlaceholder":"MM","expirationYearPlaceholder":"AAAA","feesLabel":"Cuotas*","gatewayLabel":"Pasarela*","gatewayComment":"*No debe estar inscrito a la pasarela, por medio de cualquiera de estas puede realizar su transacci\xf3n.","rechargeButton":"Recargar","processingButton":"Procesando...","cancelButton":"Cancelar","requiredValueError":"Valor requerido","requiredFeeError":"Cuota requerido","requiredSecurityCodeError":"C\xf3digo de seguridad requerido","requiredExpirationDateError":"Fecha de vencimiento requerido","requiredGatewayError":"Pasarela requerido"},"transactionResult":{"logoAlt":"Logo BetPlay","declinedIcon":{"alt":"Declinado"},"approvedIcon":{"alt":"Aprobado"},"transactionStatusText":"Tu transacci\xf3n se encuentra en estado","paymentReferenceText":"Referencia de Pago:","paymentMethodHeader":"Medio de pago:","alertIcon":{"alt":"Icono Alerta"},"saveReferenceMessage":"Recuerda guardar la referencia de pago en caso de que desees hacer un seguimiento a tu transacci\xf3n en la p\xe1gina de consulta de transacci\xf3n de PayU, Tu Compra o con nuestro equipo de servicio al cliente.","retryButton":"Reintentar Transacci\xf3n","finishButton":"Finalizar Transacci\xf3n"},"menuUpdate":{"emailLabel":"Correo electr\xf3nico","confirmEmailLabel":"Confirmar correo electr\xf3nico","mobileLabel":"N\xfamero movil","residenceCountryLabel":"Pa\xeds de residencia","residenceDepartmentLabel":"Departamento de residencia","residenceCityLabel":"Municipio de residencia","addressLabel":"Direcci\xf3n","addressRequiredError":"Campo direcci\xf3n no puede ir vacio","additionalDataLabel":"Datos adicionales (opcionales)","additionalDataPlaceholder":"Seleccione","acceptTermsLabel":"Autorizo para que los datos suministrados en el presente formulario sean validados y tratados de acuerdo a la Pol\xedtica de Protecci\xf3n de Datos Personales de Corredor Empresarial S.A.","cancelButtonText":"Cancelar","saveButtonText":"Guardar","loadingButtonText":"Cargando...","Address":"Direcci\xf3n de residencia","AddressTypeExample":"Ej. Avenida","AddressNom1Example":"Ej. 26 D Sur","AddressNom6Example":"Ej. 57 D","AddressNom8Example":"Ej. 87","playerValidationError":{"EmptyResidenceDepartment":"Selecciona un departamento de residencia","EmptyResidenceCountry":"","EmptyResidenceCity":"Selecciona un municipio de residencia","EmptyEmail":"Email no puede ser vac\xedo.","EmailLessThan6":"Tu correo debe contener al menos 6 caracteres","InvalidEmail":"Email inv\xe1lido.","EmptyCnfEmail":"Debes confirmar tu correo","EmptyPhoneNumber":"Ingresa tu n\xfamero de tel\xe9fono","PhoneNumberLessThan10":"Tu n\xfamero de tel\xe9fono debe contener 10 caracteres","PhoneNumberNumeric":"El n\xfamero no puede contener letras"}},"confirmWithdraw":{"closeIcon":"fas fa-times","confirmTitle":"Confirmaci\xf3n de retiro","retentionLabel":"Retenci\xf3n por transacci\xf3n:","withdrawLabel":"Valor a retirar:","docInfoText":"El monto que deseas retirar es demasiado alto. Para continuar, debes diligenciar el siguiente formato y adjuntar una imagen.","downloadFormat":"Descargar formato","uploadImage":"Subir imagen","imageAlt":"Previsualizaci\xf3n de la img","backButton":"Volver","acceptButton":"Aceptar"},"bonusPage":{"availableTab":"Disponibles","expiredTab":"Expiradas","loading":"Cargando....","noBonusText":"No tienes bonos actualmente","bonusExpiration":"Expira :","previousButton":"Anterior","nextButton":"siguiente","notCumulative":"*Recuerda que solo podr\xe1s redimir un bono a la vez, estos no se acumulan y deber\xe1s gastar uno para redimir los siguentes."},"accordion":{"bonusCasinoImgAlt":"Icono de Bono Casino","bonusCasinoText":"Bono Casino","freePromotionImgAlt":"Icono de Apuesta Gratis","freePromotionText":"Apuesta Gratis","bingo":"Cartones Bingo","haveCodeImgAlt":"Icono de C\xf3digo","haveCodeText":"Tengo un C\xf3digo"},"bonusMobile":{"closeButton":"X","availableText":"Disponibles","availableImgAlt":"Icono de Activa","expiredText":"Expiradas","expiredImgAlt":"Icono de Expirada","loadingText":"Cargando...","pendingText":"Pendiente","expiredStatusText":"Expirado","expiresText":"Expira :","previousButton":"Anterior","nextButton":"siguiente","noBonusText":"No tienes bonos actualmente"},"IdentityValidationTexts":{"_comment":"Variable parametrizable para los textos de la vista de validaci\xf3n de identidad","accountSuspendedTitle":"\xa1Tu cuenta se encuentra suspendida temporalmente!","accountSuspendedDescription":"para activarla se requiere realizar una validaci\xf3n de identidad. Haz clic en el bot\xf3n y sigue el proceso","documentValidationTitle":"Para poder validar tu identidad correctamente, es necesario que subas las siguiente im\xe1genes:","photoInstruction":"1. Sube una foto de tu rostro con la c\xe9dula al lado","idInstruction":"2. Sube una foto de tu c\xe9dula por ambas caras.","beforeUploadingTitle":"Antes de subir las fotos ten en cuenta:","listItem1":"1. El rostro debe estar despejado, sin gafas, gorras, ni ning\xfan elemento que no permita visualizar la cara.","listItem2":"2. La foto debe ser de buena resoluci\xf3n y legible.","listItem3":"3. Al tomar la c\xe9dula en la mano no se debe cubrir ning\xfan campo.","listItem4":"4. Al dar click en \u201cEnviar\u201d, autorizas de manera previa, expresa e informada a CORREDOR EMPRESARIAL S.A., para tratar tus datos personales, de acuerdo con la Ley 1581 de 2012, el Decreto 1074 de 2015 y las finalidades descritas en la pol\xedtica de tratamiento de datos personales disponible AQU\xcd, relacionadas con cumplimiento legal frente a entes de control, validaci\xf3n de identidad, filtros de seguridad y an\xe1lisis para la prevenci\xf3n del fraude.","listItem5":"Recuerda que, si deseas conocer, actualizar, rectificar, suprimir datos personales o revocar la autorizaci\xf3n para su uso, puedes escribir a protecciondedatos@cempresarial.co para presentar la solicitud.","selectedFilesTitle":"Archivos seleccionados:","processCompleteTitle":"\xa1Gracias por terminar el proceso!","processCompleteDescription":"En un plazo de 72 horas h\xe1biles recibir\xe1s respuesta sobre tu validaci\xf3n"},"passwordUpdate":{"workingMessage":"Hola, estamos trabajando para brindarte una mejor experiencia, por favor actualiza tu contrase\xf1a.","currentPassword":"Contrase\xf1a actual","newPassword":"Nueva contrase\xf1a","confirmPassword":"Confirma tu nueva contrase\xf1a","validationMismatch":"Las contrase\xf1as no coinciden","validationMinLength":"La contrase\xf1a debe contener 8 caracteres al menos","validationRequired":"Todos los campos son obligatorios","validationUsername":"La contrase\xf1a debe ser diferente al username","validationDifferent":"La contrase\xf1a debe ser diferente a la contrase\xf1a actual","validationCharacters":"*Recuerda que para mayor seguridad , esta debe contener m\xednimo un car\xe1cter especial y una may\xfascula (sin espacios)","securityReminder":"*Recuerda que para mayor seguridad, esta debe contener caracteres especiales (May\xfasculas) y alfanum\xe9ricos (Puntos, coma \xf3 n\xfameros)","submitButton":"Completar","dataProtectionPolicy":{"dataProtectionPolicyUpdateMessage":"Hemos actualizado nuestra pol\xedtica de protecci\xf3n de datos y podr\xe1s encontrarla","dataProtectionPolicyLinkText":"\xa1Aqu\xed!"}},"errorPage":{"imageAlt":"error-pagina","imageTitle":"Pagina de error","title":"Oops! Pagina no encontrada","message":"Hubo un error al lanzar el juego, por favor intentalo de nuevo","buttonText":"Salir"},"recommendation":{"button":"Aceptar"},"verificationForm":{"title":"Verificaci\xf3n","instructionLabel":"Hemos enviado un c\xf3digo al tel\xe9fono registrado. Por favor ingrese el c\xf3digo en el siguiente formulario","patternError":"El c\xf3digo no puede contener car\xe1cteres.","validateButton":"Validar","noCodeLabel":"No lleg\xf3 tu c\xf3digo ?","resendLink":"Reenviar"},"taxCertificates":{"title":"Descarga tus certificados tributarios","subtitle":"Indentifica el tipo de certificado, selecciona el a\xf1o y desc\xe1rgalo","awardCertificate":{"label":"Certificado de premios"},"retentionCertificate":{"label":"Certificado de Retenci\xf3n en la fuente"},"downloadButton":"Descargar"},"certificateModal":{"closeButton":"Cerrar","title":"Descarga aqu\xed tus certificados tributarios","awardCertificate":{"placeholder":"Certificado de premios"},"retentionCertificate":{"placeholder":"Certificado retenci\xf3n en la fuente"},"downloadButton":{"idle":"Descargar","loading":"Descargando..."}},"passwordChange":{"title":"Hola, estamos trabajando para brindarte una mejor experiencia, por favor actualiza tu contrase\xf1a.","currentPassword":"Contrase\xf1a actual","newPassword":"Nueva contrase\xf1a","confirmPassword":"Confirma tu nueva contrase\xf1a","validations":{"passwordMismatch":"Las contrase\xf1as no coinciden","minLength":"La contrase\xf1a debe contener 8 caracteres al menos","allFieldsRequired":"Todos los campos son obligatorios","differentFromUsername":"La contrase\xf1a debe ser diferente al username","differentFromCurrent":"La contrase\xf1a debe ser diferente a la contrase\xf1a actual","specialCharacters":"*Recuerda que para mayor seguridad , esta debe contener m\xednimo un car\xe1cter especial y una may\xfascula (sin espacios)"},"securityReminder":"*Recuerda que para mayor seguridad, esta debe contener caracteres especiales (May\xfasculas) y alfanum\xe9ricos (Puntos, coma \xf3 n\xfameros)","submitButton":"Completar"},"dataProtectionPolicyPage":{"title":" Pol\xedtica de tratamiento y protecci\xf3n de datos personales en BetPlay","subtitle":"Corredor Empresarial S.A., identificada con Nit. 900.243.000-8 , quien en lo sucesivo se denominar\xe1 BetPlay es responsable del tratamiento, recolecci\xf3n, almacenamiento y disposici\xf3n de los datos personales que en ejercicio de sus actividades obtiene y/o recibe de sus clientes, empleados, proveedores, visitantes, accionistas y dem\xe1s terceros involucrados, de acuerdo con los lineamientos de la presente pol\xedtica de tratamiento de datos personales, la cual tiene como finalidad dar a conocer los mecanismos y procedimientos para hacer efectivos los derechos de los titulares de los datos personales tratados por BetPlay, informar los canales de atenci\xf3n para dar tr\xe1mite a las peticiones, quejas, reclamos y consultas de los titulares, comunicar las finalidades y el tratamiento a los cuales se someter\xe1n los datos personales en el desarrollo de las actividades comerciales de BetPlay.","ItemDataProtectionList":[{"title":"Nuestra escencia","image":"../../../../assets/images/Icono Escencia (6).svg","QuestionList":[{"question":"Nuestra escencia","content":[{"paragraph":"En BetPlay nos mueve todo tipo de juegos de suerte y azar: loter\xedas, juegos novedosos, localizados, apuestas permanentes, rifas y dem\xe1s juegos legalmente autorizados. Todo esto hace parte de nuestro objeto social, por lo cual, nos es permitido la explotaci\xf3n econ\xf3mica, la operaci\xf3n y comercializaci\xf3n de los mismos a trav\xe9s de medios tradicionales y/o electr\xf3nicos. Adicional, cuando se tenga un acercamiento con personas naturales que sean clientes actuales o potenciales, proveedores, contratistas y/o terceros y se utilicen datos personales, actuaremos en cumplimiento con lo establecido en la Ley 1581 de 2012, el Decreto Reglamentario 1377 de 2013, el Decreto Reglamentario 1074 de 2015 y dem\xe1s disposiciones complementarias."}]},{"question":"Nuestra misi\xf3n tambi\xe9n es proteger tus datos personales","content":[{"title":"Nuestra misi\xf3n tambi\xe9n es proteger tus datos personales","paragraph":"Nos encanta que te diviertas en BetPlay, tengas experiencias memorables y la certeza de que tus datos personales est\xe1n a salvo. Es por eso que, en esta pol\xedtica, te explicaremos el prop\xf3sito con el cual recolectamos parte de tu informaci\xf3n, c\xf3mo hacer efectivos tus derechos, los canales de atenci\xf3n a los que puedes acudir para consultas, tramitar peticiones, quejas, reclamos y m\xe1s."},{"title":"\xbfSab\xedas qu\xe9?","paragraph":"El responsable del tratamiento, recolecci\xf3n, almacenamiento y disposici\xf3n de los datos personales que suministras y/o que recibimos por medio de clientes, empleados, proveedores, visitantes, accionistas y dem\xe1s terceros involucrados es Corredor Empresarial S.A., identificado con NIT. 900.243.000-8. Cuenta con domicilio legal en la Avenida Calle 26 NO. 69 D - 91, Centro Empresarial Arrecife (Torre peatonal 2, piso 8), de la ciudad de Bogot\xe1 - Colombia, y tel\xe9fono de contacto (+57) 3165809078."}]},{"question":"Conoce nuestros principios de privacidad","content":[{"title":"Ante todo, la transparencia","paragraph":"Para garantizar la veracidad y calidad de tus datos personales en BetPlay, es importante que estos los suministres por completo, sean exactos, comprobables, actualizados y comprensibles."},{"title":"Somos legales","paragraph":"Protegemos tus datos personales acorde con la normatividad vigente y dem\xe1s disposiciones que se desarrollen al respecto."},{"title":"Trabajamos por tu seguridad","paragraph":"Implementamos acciones necesarias para que tu informaci\xf3n personal no sea vulnerada, evitando posibles sustracciones, eliminaciones, entre otras."},{"title":"Conservamos tus datos por tiempo limitado","paragraph":"Preservamos tus datos personales necesarios para que disfrutes de nuestros servicios durante un plazo fijado previamente por la organizaci\xf3n atendiendo las tablas de retenci\xf3n documental, las disposiciones legales y las finalidades establecidas en esta pol\xedtica de tratamiento de datos. Luego, ser\xe1n eliminados o suprimidos del medio donde se almacenaron, a menos de que se requiera su conservaci\xf3n por obligaci\xf3n legal o contractual frente al ente regulador."}]},{"question":"Glosario de conceptos a tener en cuenta","content":[{"paragraph":"Para que puedas familiarizarte con nuestra pol\xedtica de tratamiento de datos personales, a continuaci\xf3n, te compartimos ciertas definiciones:"},{"title":"Titular:","paragraph":"Persona natural cuyos datos personales sean objeto de tratamiento."},{"title":"Tratamiento:","paragraph":"Cualquier operaci\xf3n o conjunto de operaciones sobre datos personales, tales como la recolecci\xf3n, almacenamiento, uso, circulaci\xf3n o supresi\xf3n para dar cumplimiento a los requisitos establecidos en el Decreto 1377 de 2013 y el Decreto 1074 de 2015, obedeciendo los principios de libertad y finalidad de la Ley 1581 de 2012."},{"title":"Autorizaci\xf3n:","paragraph":"Consentimiento previo, expreso e informado del Titular para llevar a cabo el tratamiento de datos personales. El Titular podr\xe1 dar su autorizaci\xf3n a trav\xe9s de medios verbales, escritos o por conductas inequ\xedvocas."},{"title":"Aviso de privacidad:","paragraph":"Comunicaci\xf3n verbal o escrita generada por el Responsable (BetPlay), dirigida al Titular para el tratamiento de sus datos personales, mediante la cual se le informa acerca de la existencia de las pol\xedticas de tratamiento de datos personales que le ser\xe1n aplicables, la forma de acceder a las mismas y las finalidades del tratamiento que se pretende dar a los datos personales."},{"title":"Base de datos:","paragraph":"Conjunto organizado de datos personales (f\xedsico o digital) que es objeto de tratamiento."},{"title":"Dato personal:","paragraph":"Cualquier informaci\xf3n vinculada o que pueda asociarse a una o varias personas naturales determinadas o determinables. Los datos personales pueden ser p\xfablicos, semiprivados, privados y sensibles."},{"title":"Dato p\xfablico:","paragraph":"Es el dato que no es semiprivado, privado o sensible. Son considerados datos p\xfablicos, entre otros, los datos relativos al estado civil de las personas, a su profesi\xf3n u oficio y a su calidad de comerciante o de servidor p\xfablico. Por su naturaleza, los datos p\xfablicos pueden estar contenidos, entre otros, en registros p\xfablicos, documentos p\xfablicos, gacetas, boletines oficiales y sentencias judiciales debidamente ejecutoriadas que no est\xe9n sometidas a reserva. Los datos p\xfablicos pueden ser, entre otros, el nombre del Titular, n\xfamero de identificaci\xf3n y estado civil."},{"title":"Dato privado:","paragraph":"Es aquel dato que por su naturaleza \xedntima y reservada solo le interesa a su Titular y para su tratamiento requiere de su autorizaci\xf3n escrita, verbal o por conductas inequ\xedvocas. Los datos privados pueden ser, entre otros, la direcci\xf3n y tel\xe9fono de su domicilio."},{"title":"Dato sensible:","paragraph":"Se entiende por datos sensibles aquellos que afectan la intimidad del Titular o cuyo uso indebido puede generar su discriminaci\xf3n, tales como aquellos que revelen el origen racial o \xe9tnico, la orientaci\xf3n pol\xedtica, las convicciones religiosas o filos\xf3ficas, la pertenencia a sindicatos, organizaciones sociales, de derechos humanos o que promueva intereses de cualquier partido pol\xedtico o que garanticen los derechos y garant\xedas de partidos pol\xedticos de oposici\xf3n, as\xed como los datos relativos a la salud, a la vida sexual, y los datos biom\xe9tricos. La autorizaci\xf3n para el tratamiento de datos sensibles deber\xe1 hacerse de manera expl\xedcita y la respuesta ser\xe1 facultativa (respuesta del ni\xf1o)."},{"title":"Responsable del Tratamiento:","paragraph":"Persona natural o jur\xeddica, p\xfablica o privada, que por s\xed misma o en asocio con otros, decida sobre la base de datos y/o el tratamiento de los datos."},{"title":"Encargado del Tratamiento:","paragraph":"Persona natural o jur\xeddica, p\xfablica o privada, que por s\xed misma o en asocio con otros, realice el Tratamiento de datos personales por cuenta del Responsable del tratamiento."},{"title":"Transferencia:","paragraph":"La transferencia de datos tiene lugar cuando el Responsable y/o Encargado del Tratamiento de datos personales, ubicado en Colombia, env\xeda la informaci\xf3n o los datos personales a un receptor, que a su vez es Responsable del Tratamiento y se encuentra dentro o fuera del pa\xeds."},{"title":"Transmisi\xf3n:","paragraph":"Tratamiento de datos personales que implica la comunicaci\xf3n de los mismos dentro o fuera del territorio de la Rep\xfablica de Colombia cuando tenga por objeto la realizaci\xf3n de un Tratamiento por el Encargado por cuenta del Responsable."}]}]},{"title":"Informaci\xf3n","image":"../../../../assets/images/Icono Quien.svg","QuestionList":[{"question":"\xbfDe qui\xe9n recolectamos informaci\xf3n?","content":[{"paragraph":"Para el ejercicio de nuestra actividad, en BetPlay recolectamos datos de clientes, empleados, candidatos, proveedores, contratistas, visitantes y accionistas. BetPlay en el desarrollo de sus actividades, recolectar\xe1, utilizar\xe1, administrar\xe1, almacenar\xe1, transmitir\xe1, transferir\xe1, suprimir\xe1 y realizar\xe1 diversas operaciones con los datos personales. De acuerdo con lo anterior, los datos personales tratados por la Compa\xf1\xeda deber\xe1n someterse \xfanicamente a las finalidades que se se\xf1alan a continuaci\xf3n o las que sean autorizadas por los titulares en el momento de la recolecci\xf3n de los datos personales. Lo mismo aplica para los encargados o terceros que tengan acceso a los datos personales a trav\xe9s de figuras aceptadas por el R\xe9gimen de Protecci\xf3n de Datos Personales. <br> En ese sentido, el tratamiento de los datos personales se realiza para la consecuci\xf3n de las siguientes finalidades por cada tipo de Titular: <br> <br> 1. Gestionar las relaciones, derechos y deberes que se tienen con los titulares.<br> <br> 2. Recibir y gestionar requerimientos sobre productos o servicios y atenci\xf3n de titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRS."}]},{"question":"Clientes","content":[{"maintitle":"Clientes"},{"title":"Finalidad comercial","paragraph":"<ol> <li> Mantener un registro hist\xf3rico y estad\xedstico de las relaciones comerciales. </li> <li>Generar modelos y datos para la toma de decisiones.</li> <li>Realizar estudios de mercado y h\xe1bitos de consumo.</li> <li> Remitir o enviar informaci\xf3n relacionada con el objeto social de la Compa\xf1\xeda. </li> <li> Suministrar comunicaciones comerciales, publicitarias y promocionales sobre los productos, servicios, eventos, promociones, etc. V\xeda correo electr\xf3nico, SMS u otro medio, relacionadas con los productos y servicios de BetPlay. Realizar </li> <li> Realizar evaluaciones, encuestas de satisfacci\xf3n al usuario, calidad del servicio y fortalecer los canales de atenci\xf3n al Cliente. </li> <li> Implementar programas de CRM. </li> <li> Realizar actividades de fidelizaci\xf3n de usuarios. </li> <li> Identificar ganadores de premios, as\xed como recolectar y almacenar informaci\xf3n de sus clientes obtenida en la inscripci\xf3n de usuarios de los sistemas de juegos de suerte y azar, as\xed como eliminar o suprimir la informaci\xf3n correspondiente cuando as\xed se requiera, atendiendo los deberes de protecci\xf3n y custodia de la informaci\xf3n y bases de datos. </li> <li> Almacenar informaci\xf3n relacionada con la ubicaci\xf3n del usuario y direcci\xf3n IP para efectos de monitoreo y control de las operaciones, as\xed como alimentar las bases de datos de la red comercial de la Compa\xf1\xeda para realizar campa\xf1as de comercializaci\xf3n segmentadas por regi\xf3n. </li> <li> Adelantar campa\xf1as de actualizaci\xf3n de datos personales para garantizar la integridad de estos. </li> <li> El env\xedo de modificaciones a esta pol\xedtica, as\xed como la solicitud de nuevas autorizaciones para el tratamiento de datos personales. </li> <li> Transferir o transmitir datos personales, previa autorizaci\xf3n del titular, dentro o fuera del territorio colombiano, para la consecuci\xf3n de las finalidades establecidas en esta Pol\xedtica. En especial, a proveedores y empresas asociadas BetPlay, dentro de las que se encuentran la Red Comercial conformada por Colaboradores y Comercializadores, los cuales actuar\xe1n en calidad de Responsables o Encargados (v\xe9ase Anexo 1). </li> <li> Disponer de la informaci\xf3n personal suministrada por sus clientes al momento de suscribir contratos, con el fin de dar cumplimiento a las obligaciones derivadas de los mismos. </li> <li> Env\xedo de comunicaciones de car\xe1cter legal. </li> <li> Para el normal desarrollo de la relaci\xf3n contractual. </li> </ol>"},{"title":"Finalidad administrativa","paragraph":"<ol> <li> Realizar la verificaci\xf3n de cumplimientos legales. </li> <li> Realizar la verificaci\xf3n de datos y referencias suministradas con terceros o entidades. </li> <li> Realizar actividades de gesti\xf3n administrativa y de control interno. </li> <li> Generar facturas. </li> <li> Adelantar investigaciones en caso de presentarse situaciones de riesgo o violaciones a la seguridad. </li> <li> Cumplir con los deberes financieros, tributarios y contables de la Compa\xf1ia. </li> <li> Realizar actividades de cobro, pago o deducciones. </li> <li> Adelantar la administraci\xf3n de sistemas de Informaci\xf3n, gesti\xf3n de contrase\xf1as y administraci\xf3n de usuarios en las plataformas de los productos administrados por BetPlay. </li> <li> Archivar, proteger y custodiar la informaci\xf3n y bases de datos de acuerdo con la politica de custodia y retenci\xf3n documental. </li> <li> Adelantar investigaciones internas y reportar a las autoridades judiciales y administrativas en caso de violaciones a la Ley. </li> <li> Realizar el an\xe1lisis para el control y la prevenci\xf3n del fraude y de lavado de activos, incluyendo, pero sin limitarse a la consulta y reporte a listas restrictivas. </li> <li> Realizar contacto telef\xf3nico, por correo electr\xf3nico, correo f\xedsico, SMS, o cualquier otro medio fisico o digital existente para validar la identidad de los titulares con el fin de prevenir y controlar posibles fraudes de tipo operativo y lavado de activos, la financiaci\xf3n del terrorismo y las armas de destrucci\xf3n masiva (SIPLAFT-FPADM). </li> <li> Utilizar datos como foto del rostro y huella dactilar para validaci\xf3n de identidad a trav\xe9s de herramientas tecnol\xf3gicas, filtros de seguridad, an\xe1lisis para la prevenci\xf3n del fraude y suplantaci\xf3n de identidad, y cumplimiento del SIPLAFT-FPADM. </li> <li> Validar la autenticidad de la informaci\xf3n suministrada por el Cliente en las plataformas de los productos. </li> </ol>"},{"title":"De cumplimiento frente a Terceros:","paragraph":"<ol> <li> Atender requerimientos de autoridades judiciales y administrativas. </li> <li> Realizar la verificaci\xf3n de cumplimientos legales. </li> <li> Almacenamiento en las bases de datos por el t\xe9rmino legal o internamiento dispuesto en la pol\xedtica de conservaci\xf3n y disposici\xf3n final de la informaci\xf3n para posteriores reportes o informes a las autoridades de control. </li> <li> Registro en aplicativos y formularios de entidades estatales por requerimiento legal. </li> <li> Mantener el registro de usuarios autoexcluidos y revocatoria de autoexclusi\xf3n, de acuerdo con los lineamientos del Programa de Juego Responsable y la regulaci\xf3n emitida por Coljuegos. </li> </ol>"},{"title":"Para el ejercicio de derechos:","paragraph":"<ol> <li> Gestionar las relaciones, derechos y deberes que se tienen con los titulares. </li> <li> Recibir y gestionar requerimientos sobre productos o servicios y atenci\xf3n de titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRS </li> </ol>"}]},{"question":"Empleados","content":[{"maintitle":"Empleados"},{"title":"Finalidad administrativa","paragraph":"<ol> <li> Mantener un registro hist\xf3rico y estad\xedstico. </li> <li> Realizar el env\xedo de comunicaciones en raz\xf3n a la relaci\xf3n contractual, a trav\xe9s de correo electr\xf3nico, SMS, tel\xe9fono u otro medio. </li> <li> Verificaci\xf3n, comparaci\xf3n, evaluaci\xf3n de las competencias laborales y personales de los aspirantes, respecto de los criterios de selecci\xf3n y la realizaci\xf3n de pruebas de selecci\xf3n. </li> <li> Realizar actividades de gesti\xf3n administrativa, como, recolecci\xf3n, clasificaci\xf3n, almacenamiento, uso, archivo de los datos personales. </li> <li> Realizar la verificaci\xf3n de datos y referencias suministradas con terceros y entidades. </li> <li> Recolectar, almacenar y disponer sobre los datos personales suministrados por el empleado para la gesti\xf3n administrativa, incluyendo, pero sin limitarse a la informaci\xf3n de </li> <li> parientes hasta el cuarto grado de consanguinidad, c\xf3nyuges y/o compa\xf1eros permanentes, previa autorizaci\xf3n de cada uno de \xe9stos. </li> <li> Adelantar investigaciones en caso de presentarse situaciones de riesgo o violaciones a la seguridad. Visitas domiciliarias. </li> <li> Realizar la aplicaci\xf3n de sanciones asociadas a incumplimientos de alg\xfan tipo. </li> <li> Cumplir con los deberes financieros, tributarios y contables de la Compa\xf1\xeda. </li> <li> Realizar campa\xf1as de actualizaci\xf3n de datos e informaci\xf3n de cambios en la Pol\xedtica de Tratamiento de Datos Personales. </li> <li> Cumplir con los requisitos legales asociados a la formalizaci\xf3n de contratos. </li> <li> Cumplir con lo dispuesto en el ordenamiento jur\xeddico colombiano en materia de Seguridad y Salud en el Trabajo. </li> <li> Cumplir con lo dispuesto por el ordenamiento jur\xeddico colombiano en materia laboral y de seguridad social, entre otras, aplicables a exempleados o empleados actuales. </li> <li> Atender las novedades que involucren a exempleados para la realizaci\xf3n de las investigaciones necesarias con base en la informaci\xf3n almacenada en la base de datos. </li> <li> Realizar el pago de n\xf3mina y liquidaci\xf3n de prestaciones sociales y cumplir con la declaraci\xf3n y pago de seguridad social. </li> <li> Realizar seguimiento a los horarios establecidos para los empleados, al igual que la conservaci\xf3n y consulta de procesos disciplinarios relacionados con el Reglamento Interno de Trabajo y/o el contrato laboral. </li> <li> Cumplir con los requisitos de gesti\xf3n de Riesgos Laborales y adelantar la prevenci\xf3n y protecci\xf3n del talento humano ante enfermedades y accidentes laborales. </li> <li> Realizar la verificaci\xf3n de riesgos de salud. </li> <li> Preservar la seguridad de los activos y personas. </li> <li> Adelantar la administraci\xf3n de Sistemas de Informaci\xf3n, gesti\xf3n de claves y administraci\xf3n de usuarios. </li> <li> Realizar procesos de inducci\xf3n, capacitaci\xf3n y formaci\xf3n al personal interno. </li> <li> Realizar actividades de bienestar social y salud ocupacional, eventos, seminarios, talleres y/o cualquier escenario acad\xe9mico y/o laboral. </li> <li> Gestionar las actividades asociadas a la contrataci\xf3n de empleados. </li> <li> Administrar el talento humano incluyendo la realizaci\xf3n de evaluaciones de desempe\xf1o. </li> <li> Almacenar durante el tiempo que, por razones administrativas, legales y de seguridad se considere necesario, los datos personales de los titulares que hayan terminado su relaci\xf3n contractual, para expedir certificados laborales a solicitud del exempleado o sus causahabientes, otorgar referencias laborales para potenciales empleadores, cuando as\xed lo autorice al momento de su desvinculaci\xf3n laboral. </li> <li> Adelantar investigaciones internas de conformidad con las diferentes pol\xedticas, en caso de actividades sospechosas que puedan afectar el buen nombre de la Compa\xf1\xeda. </li> <li> Realizar el an\xe1lisis para el control y la prevenci\xf3n del fraude y de lavado de activos, incluyendo, pero sin limitarse a la consulta y reporte a listas restrictivas. </li> </ol>"},{"title":"De cumplimiento frente a Terceros:","paragraph":"<ol><li>Cumplir con los protocolos de bioseguridad exigidos por el Ministerio de Salud en concordancia con la prevenci\xf3n del COVID-19 u otros.</li><li>Registro en aplicativos y formularios de entidades y organismos estatales por requerimiento legal.</li></ol>"},{"title":"Para el ejercicio de derechos:","paragraph":"<ol><li>Gestionar las relaciones, derechos y deberes de los titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRSD.</li></ol>"}]},{"question":"Candidatos","content":[{"maintitle":"Candidatos"},{"title":"Finalidad administrativa","paragraph":"<ol> <li>Alimentar la base de datos de Candidatos para la gesti\xf3n de los procesos de selecci\xf3n y tener registro de la inscripci\xf3n.</li> <li>Realizar la selecci\xf3n y promoci\xf3n de ofertas laborales.</li> <li>Realizar convocatorias a citas para entrevistas o pruebas en el marco de proceso de selecci\xf3n.</li> <li>Verificaci\xf3n, comparaci\xf3n, evaluaci\xf3n de las competencias laborales y personales de los aspirantes, respecto de los criterios de selecci\xf3n y la realizaci\xf3n de pruebas de selecci\xf3n.</li> <li>Visitas domiciliarias.</li> <li>Solicitar soportes de la hoja de vida y solicitarla nuevamente en caso de ser necesario.</li> <li>Enviar copia de la convocatoria al correo electr\xf3nico.</li> <li>Verificar el cumplimiento de requisitos como parte del proceso de selecci\xf3n.</li> <li>Para aplicaci\xf3n de pruebas y entrevistas.</li> <li>Para que trabajadores de la compa\xf1\xeda o terceros realicen la evaluaci\xf3n de las pruebas.</li> <li>Para informar resultados generales del proceso de selecci\xf3n en sus diferentes filtros.</li> <li>Para archivar los resultados de las pruebas.</li> <li>Para dejar registro de la asistencia de las pruebas y la entrevista.</li> <li>En caso de aportar fotograf\xeda, la misma ser\xe1 utilizada para el proceso de carnetizaci\xf3n en caso de ser seleccionado. De lo contrario, procederemos a su eliminaci\xf3n teniendo en cuenta que se trata de un dato sensible.</li> <li>Para almacenar la informaci\xf3n personal por un (1) mes con el fin de que la Compa\xf1\xeda lo pueda contactar para invitarlo a participar en procesos de selecci\xf3n de personal.</li> <li>Transmitir y/o transferir mis datos personales para las finalidades mencionadas en la Pol\xedtica de Protecci\xf3n de Datos Personales para Candidatos.</li> <li>Realizar el an\xe1lisis para el control y la prevenci\xf3n del fraude y de lavado de activos, incluyendo, pero sin limitarse a la consulta y reporte a listas restrictivas.</li> </ol>"},{"title":"Para el ejercicio de derechos:","paragraph":"<ol><li>Gestionar las relaciones, derechos y deberes de los titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRSD.</li></ol>"}]},{"question":"Proveedores","content":[{"maintitle":"Proveedores"},{"title":"Finalidad administrativa","paragraph":"<ol> <li>Adelantar comunicaciones o contacto v\xeda correo electr\xf3nico, SMS, tel\xe9fono u otro medio.</li> <li>Realizar la verificaci\xf3n de cumplimientos legales.</li> <li>Realizar la verificaci\xf3n de requisitos jur\xeddicos, t\xe9cnicos y financieros.</li> <li>Realizar la verificaci\xf3n de datos y referencias suministradas con terceros o entidades.</li> <li>Realizar el an\xe1lisis para la detecci\xf3n del conflicto de inter\xe9s y el control y la prevenci\xf3n del fraude y de lavado de activos, incluyendo, pero sin limitarse a la consulta y reporte a listas restrictivas.</li> <li>Adelantar investigaciones en caso de presentarse situaciones de riesgo o violaciones a la seguridad.</li> <li>Realizar la aplicaci\xf3n de sanciones asociadas a incumplimientos de alg\xfan tipo.</li> <li>Cumplir con los deberes financieros, tributarios y contables.</li> <li>Realizar actividades de cobro y pago.</li> <li>Adelantar campa\xf1as de actualizaci\xf3n de datos e informaci\xf3n de cambios en la Pol\xedtica de Tratamiento de Datos Personales.</li> <li>Cumplir con los requisitos legales asociados a la formalizaci\xf3n de contratos.</li> <li>Cumplir las obligaciones que se tienen con los proveedores y con los procesos internos en materia de administraci\xf3n de proveedores y contratistas, ejerciendo el control y registro de todo tipo de obligaciones contra\xeddas con contratistas y/o proveedores, al igual que el env\xedo de invitaciones a participar de procesos contractuales en todas sus diferentes etapas.</li> <li>Cumplir con los tr\xe1mites relacionados con el Sistema de Seguridad Social aplicable a los Contratistas.</li> </ol>"},{"title":"De cumplimiento frente a terceros","paragraph":"<ol> <li> Registro en aplicativos y formularios de entidades y organismos estatales por requerimiento legal. </li> </ol>"},{"title":"Para el ejercicio de derechos","paragraph":"<ol><li>Gestionar las relaciones, derechos y deberes de los titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRSD.</li><li>Recibir y gestionar requerimientos sobre productos o servicios y atenci\xf3n de titulares a trav\xe9s del proceso de gesti\xf3n de PQRSD, si el proveedor recibe datos personales en virtud de su calidad de encargado.</li></ol>"}]},{"question":"Sistema de videovigilancia","content":[{"maintitle":"Sistema de videovigilancia"},{"paragraph":"<ol> <li>Utilizar sistemas de videovigilancia dentro y fuera de las instalaciones con fines de seguridad f\xedsica, personal y control organizacional.</li> <li>Almacenar, custodiar y suprimir las im\xe1genes captadas por el sistema de videovigilancia de acuerdo con la pol\xedtica de retenci\xf3n y custodia documental de las Compa\xf1\xedas.</li> <li>Mantener el registro de visitas e ingreso a las oficinas ubicadas en las instalaciones para identificaci\xf3n de los visitantes, seguridad f\xedsica y personal y gesti\xf3n de accidentes dentro de las instalaciones de las compa\xf1\xedas, por el t\xe9rmino establecido en la pol\xedtica de retenci\xf3n y gesti\xf3n documental.</li> <li>Env\xedo de comunicaciones de car\xe1cter legal y comercial relacionadas con los productos y servicios prestados.</li> </ol>"},{"title":"De cumplimiento frente a terceros","paragraph":"<ol> <li> Utilizar las im\xe1genes captadas por el sistema de videovigilancia y los registros de visitantes en formatos f\xedsicos o digitales ante cualquier proceso judicial o administrativo con sujeci\xf3n y cumplimiento a las normas aplicables. </li> </ol>"},{"title":"Para el ejercicio de derechos","paragraph":"<ol> <li> Gestionar las relaciones, derechos y deberes de los titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRSD. </li> </ol>"}]},{"question":"Accionistas administrativos","content":[{"maintitle":"Accionistas administrativos"},{"paragraph":"<ol> <li>Utilizar la informaci\xf3n personal registrada en los libros de comercio para las finalidades derivadas del contenido de los estatutos de la sociedad.</li> <li>Almacenar la informaci\xf3n contenida en los libros de comercio por el t\xe9rmino se\xf1alado en la pol\xedtica de retenci\xf3n y gesti\xf3n documental.</li> <li>Adelantar campa\xf1as de actualizaci\xf3n de datos e informaci\xf3n de cambios en la Pol\xedtica de Tratamiento de Datos Personales.</li> <li>Realizar el an\xe1lisis para el control y la prevenci\xf3n del fraude y de lavado de activos, incluyendo, pero sin limitarse a la consulta y reporte a listas restrictivas.</li> </ol>"},{"title":"De cumplimiento frente a terceros","paragraph":"<ol> <li> Registro en aplicativos y formularios de entidades y organismos estatales por requerimiento legal. </li> </ol> "},{"title":"Para el ejercicio de derechos","paragraph":"<ol> <li> Gestionar las relaciones, derechos y deberes de los titulares a trav\xe9s del procedimiento de atenci\xf3n a PQRSD. </li> </ol>"}]},{"question":"Menores de edad","content":[{"maintitle":"Menores de edad"},{"paragraph":"<ol> <li> En aplicaci\xf3n de lo establecido en la ley, BetPlay, proceder\xe1\u0301 a efectuar el Tratamiento de la Informaci\xf3n Personal, de ni\xf1os, ni\xf1as y adolescentes, respetando el inter\xe9s superior de los mismos y asegurando, en todos los casos, el respeto de sus derechos fundamentales y garant\xedas m\xednimas. </li> <li> En todos los eventos en los que se requiera darle Tratamiento a la Informaci\xf3n Personal de menores de edad, BetPlay, obtendr\xe1\u0301 la Autorizaci\xf3n de sus representantes legales, que para este efecto son padre y/o madre o tutor. </li> </ol>"}]}]},{"title":"Datos personales","image":"../../../../assets/images/Icono Tratamiento.svg","QuestionList":[{"question":"Ciclo de vida de mis datos personales","content":[{"maintitle":"Ciclo de vida de mis datos personales"},{"title":"Etapa 1: Recolecci\xf3n","paragraph":"La informaci\xf3n personal la obtenemos de tres formas: directamente con el Titular, de un tercero siempre y cuando est\xe9 autorizado y de fuentes p\xfablicas de informaci\xf3n. Dicha recolecci\xf3n, se puede llevar a cabo a trav\xe9s de medios f\xedsicos o digitales donde se incorporar\xe1 un aviso de privacidad y autorizaci\xf3n para dar cumplimiento a lo establecido en el Decreto 1377 de 2013 y el Decreto 1074 de 2015, obedeciendo los principios de libertad y finalidad de la Ley 1581 de 2012."},{"title":"Etapa 2: Almacenamiento","paragraph":"Los datos personales est\xe1n seguros en archivos f\xedsicos propios o de terceros dentro del pa\xeds (Colombia), servidores propios y externos de terceros. <br> Cuentan con medidas se seguridad f\xedsicas, t\xe9cnicas, administrativas y control de acceso para garantizar nuestros principios de privacidad."},{"title":"Etapa 3: Circulaci\xf3n","paragraph":"Para dar cumplimiento de las obligaciones con el Titular y/o para entregar sus datos personales a personas naturales o jur\xeddicas de acuerdo al Decreto 1377 de 2013 y Decreto 1074 de 2015, siempre y cuando se cuente con la autorizaci\xf3n del Titular y exista un contrato de transmisi\xf3n de datos personales."},{"title":"Etapa 4: Supresi\xf3n","paragraph":"La eliminaci\xf3n de la informaci\xf3n personal que se haya recolectado se llevar\xe1 a cabo cuando: <br> - No sea necesitaria para el cumplimiento de aspectos legales, contractuales, tributarios, financieros, de auditor\xeda o est\xe9 sujeta a disposiciones vigentes en t\xe9rminos de ley. <br> - No afecte o implique la p\xe9rdida de trazabilidad o integridad de las bases de datos o cadenas de informaci\xf3n donde reposa la informaci\xf3n. <br> - Se haya cumplido o eliminado la finalidad para la cual fueron recolectados o se haya superado el per\xedodo necesario para el cumplimiento de las finalidades. <br> - Se solicite su eliminaci\xf3n por parte del Titular o por orden de autoridad competente, salvo que el Titular y/o salvo en los casos establecidos en las definiciones anteriores. No obstante, es posible que alguna informaci\xf3n se conserve o almacene \xfanicamente con fines estad\xedsticos, de auditor\xeda o de cumplimiento frente a entidades judiciales, administrativas o de control."}]},{"question":"\xbfPara qu\xe9 utilizan mis datos?","content":[{"maintitle":"\xbfPara qu\xe9 utilizan mis datos?"},{"paragraph":"Para que sigas alimentando tu pasi\xf3n por las apuestas, nos aseguramos que recibas informaci\xf3n de calidad a trav\xe9s de diferentes canales, es por eso que a continuaci\xf3n te contamos algunos motivos por los cuales recolectamos tus datos: <br> <br> <ul> <li> Para remitir informaci\xf3n comercial, publicitaria y promocional sobre productos, servicios, eventos, etc. de BetPlay de acuerdo a tus intereses. </li> <li> Fortalecer e innovar en nuestros canales de atenci\xf3n al usuario para que tengas una completa satisfacci\xf3n en los servicios prestados. </li> <li> Realizar estudios de mercado y h\xe1bitos de consumo. </li> <li> Notificar acerca de las modificaciones de esta pol\xedtica, al igual que la solicitud de nuevas autorizaciones para el tratamiento de tus datos personales. </li> <li> Adoptar medidas de seguridad no solo con tus datos sino los de nuestra organizaci\xf3n. </li> <li> Brindar una efectiva y oportuna respuesta a tus PQRSD (peticiones, quejas, reclamos, sugerencias y denuncias). </li> </ul>"}]},{"question":"\xbfCu\xe1les son mis derechos?","content":[{"maintitle":"Ciclo de vida de mis datos personales"},{"title":"Derecho de actualizaci\xf3n","paragraph":"Conocer, actualizar, rectificar tus datos en BetPlay siempre y cuando sean parciales, inexactos o incompletos o aquellos que no hayan sido expresamente autorizados."},{"title":"Derecho de informaci\xf3n y pruebas","paragraph":"Solicitar prueba de la autorizaci\xf3n otorgada a BetPlay respecto al manejo que se les dan a tus datos personales, as\xed como el uso de ellos otorgada a la empresa."},{"title":"Derecho de quejas y reclamos","paragraph":"Presentar ante la Superintendencia de Industria y Comercio (SIC) quejas por infracciones a la ley, una vez agotado el tr\xe1mite de consulta o reclamo ante BetPlay, de acuerdo al art\xedculo 16 de la Ley 1581 de 2012."},{"title":"Derecho de revocaci\xf3n","paragraph":"Posibilidad de anular \'darse de baja\' o solicitar la supresi\xf3n de tus datos personales en las bases de datos BetPlay."},{"title":"Derecho de acceso","paragraph":"Solicitar acceso y acceder de forma gratuita a tus datos personales que hayan sido objeto de tratamiento."},{"title":"Derecho de conocimiento","paragraph":"Recibir informaci\xf3n previa y efectiva de todas las modificaciones que se realicen a nuestra pol\xedtica de uso de datos, la finalidad de los mismos, su recolecci\xf3n, tratamiento y circulaci\xf3n. Tambi\xe9n podr\xe1n ser informados de sus derechos, procedimientos para ejercerlos y cualquier otra solicitud sobre tus datos personales."},{"title":"Derecho de supresi\xf3n","paragraph":"Solicitar la supresi\xf3n de tus datos personales de las bases de datos siempre y cuando no sea obligatorio por Ley mantenerlos o cuando ya no sea necesaria su conservaci\xf3n en virtud de la cual nos sea posible dicha supresi\xf3n."},{"title":"Derecho de presentar quejas","paragraph":"Solicitar pruebas de la autorizaci\xf3n otorgada al responsable del tratamiento, salvo cuando expresamente se except\xfae como requisito para el tratamiento de conformidad con lo previsto en el art\xedculo 10 de la Ley 1581 de 2012."},{"title":"Derecho de abstenerse","paragraph":"Puedes no responder a preguntas sobre datos sensibles como informaci\xf3n respecto a tu salud, datos biom\xe9tricos y videovigilancia, datos de ni\xf1as, ni\xf1os y adolescentes."}]},{"question":"\xbfC\xf3mo solicitan la autorizaci\xf3n de mis datos?","content":[{"maintitle":"\xbfC\xf3mo solicitan la autorizaci\xf3n de mis datos?"},{"paragraph":"En BetPlay solicitamos de manera libre, previa, expresa y debidamente informada, la autorizaci\xf3n de tus datos personales a trav\xe9s de cualquier medio, bien sea con un documento f\xedsico o digital en cualquier formato que garantice su posterior consulta a trav\xe9s de herramientas t\xe9cnicas para dar cumplimiento a la Ley. Para el caso del tratamiento de datos sensibles o datos de ni\xf1as, ni\xf1os y adolescentes, la autorizaci\xf3n se solicitar\xe1 atendiendo a los requisitos y condiciones establecidos en la Ley y en esta pol\xedtica."}]},{"question":"\xbfC\xf3mo usan las cookies en BetPlay?","content":[{"maintitle":"\xbfC\xf3mo usan las cookies en BetPlay?"},{"paragraph":"Las cookies nos permiten comprender tus intereses para ofrecerte un servicio personalizado en BetPlay. En cualquier momento, puedes revocar el consentimiento del uso de las cookies mediante su desactivaci\xf3n o borrado de las mismas desde tu navegador (siempre y cuando no se traten de cookies t\xe9cnicas o indispensables para el funcionamiento de nuestra p\xe1gina web o la prestaci\xf3n del servicio)."},{"title":"Pol\xedtica de cookies","paragraph":"Utilizamos cookies con el fin de ofrecer un servicio personalizado e individualizado. A continuaci\xf3n te detallamos toda la informaci\xf3n relativa a cookies que son utilizadas y c\xf3mo las usamos, el tipo de cookies utilizadas, su finalidad y opciones de configuraci\xf3n."},{"title":"\xbfQu\xe9 son las cookies?","paragraph":"Las cookies son peque\xf1os archivos de texto que se almacenan en el navegador de tu dispositivo y nos permiten reconocerte cada vez que visitas nuestro sitio web."},{"title":"\xbfCu\xe1ndo las usamos?","paragraph":"Dependiendo de la duda b\xe1sica del sitio utilizamos unas cookies u otras. Por ejemplo, cuando est\xe1s de visita en el sitio utilizamos cookies anal\xedticas para saber d\xf3nde vienes y cu\xe1nto entras en tu cuenta. Cuando procedes a iniciar sesi\xf3n, utilizamos cookies de sesi\xf3n."},{"title":"\xbfQu\xe9 cookies utilizamos?","paragraph":"Existen diferentes tipos de cookies. A continuaci\xf3n te las clasificamos por categor\xedas para que las conozcas mejor: <ul> <li> Cookies seg\xfan la entidad que las gestione: </li> <ul> <li> Cookies propias: Las que enviamos a tu dispositivo desde un servidor o dominio gestionado por nosotros y desde el que se presta el servicio que has solicitado. </li> <li> . Cookies de terceros: Tambi\xe9n se env\xedan a tu dispositivo desde un servidor o dominio gestionado por nosotros pero la informaci\xf3n recogida es gestionada por un tercero. </li> </ul> <li> Cookies seg\xfan el plazo de tiempo que permaneces activado: </li> <li> Cookies de sesi\xf3n: Estas son accesibles y almacenan informaci\xf3n s\xf3lo mientras mantienes tu sesi\xf3n activa. </li> <li> Cookies persistentes: Al rev\xe9s del caso anterior la informaci\xf3n es almacenada y accesible durante un periodo de tiempo definido. </li> <li> Cookies seg\xfan su finalidad: </li> <ul> <li> Cookies t\xe9cnicas Son las que nos permiten utilizar diferentes opciones o servicios como, por ejemplo, identificar tu sesi\xf3n, realizar el proceso de una apuesta o utilizar elementos de seguridad durante tu navegaci\xf3n. </li> <li> Cookies de personalizaci\xf3n: Con ellas podemos utilizar diferentes caracter\xedsticas en nuestros servicios, como por ejemplo, cambiar de idioma. </li> <li> Cookies de an\xe1lisis: Las que utilizamos para el seguimiento y an\xe1lisis de tu comportamiento en el sitio, con el fin de mejorar tu experiencia de usuario. </li> </ul> </ul> A continuaci\xf3n te resumimos en un cuadro las cookies que utilizamos en BetPlay:</>, en el sitio encontrar\xe1s enlaces a otros sitios. Es importante que recuerdes que estos otros sitios web utilizan sus propias cookies y pol\xedticas de privacidad. En caso de que decidas utilizar estos sitios de terceros te recomendamos que leas antes su pol\xedtica de privacidad y de cookies."},{"title":"\xbfC\xf3mo desactivar o eliminar las cookies instaladas?","paragraph":"La mayor\xeda de los navegadores est\xe1n configurados para aceptar las cookies de forma autom\xe1tica. Sin embargo, puedes configurar tu navegador para que te avise antes de instalar una cookie y as\xed puedas aceptar o denegar su instalaci\xf3n. En el men\xfa de ayuda de tu navegador podr\xe1s consultar las instrucciones y manuales para ampliar esta informaci\xf3n. Adicionalmente, te facilitamos los siguientes enlaces que incluyen informaci\xf3n pr\xe1ctica sobre c\xf3mo gestionar las cookies en los navegadores m\xe1s utilizados: <br> <ul> <li> Firefox: https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-que-los-sitios-we </li> <li> Google Chrome: https://support.google.com/chrome/answer/95647?hl=es </li> <li> InternetExplorer: http://windows.microsoft.com/es-ES/windows-vista/Block-or-allow-cookies </li> <li> Safari: https://support.apple.com/es-es/HT201265 </li> </ul> <br> Es importante que recuerdes que en caso de impedir la entrada de cookies es posible que algunas de las funciones del sitio dejen de tener efecto, ya que dependen de la informaci\xf3n almacenada en las mismas."}]},{"question":"Canales de atenci\xf3n al cliente","content":[{"maintitle":"Canales de atenci\xf3n al cliente"},{"paragraph":"Para nosotros es muy importante que disfrutes al m\xe1ximo de tu pasi\xf3n, tengas una experiencia \xfanica y seas parte del mundo de ganadores BetPlay, es por eso que contamos con los mejores canales de atenci\xf3n para resolver oportunamente tus PQRS (peticiones, quejas, reclamos, sugerencias y denuncias): <br> <br> <ul> <li> V\xeda electr\xf3nica a la direcci\xf3n de correo: protecciondedatos@cempresarial.co </li> <li> V\xeda f\xedsica en el punto de radicaci\xf3n de documentos ubicado en la direcci\xf3n Avenida Calle 26 NO. 69 D - 91, Centro Empresarial Arrecife, Torre Peatonal 2, piso 8 de la ciudad de Bogot\xe1 - Colombia. </li> </ul> <br> V\xeda telef\xf3nica: +601 316 580 9078 <br> <br> Sitio Web: https://www.cempresarial.co/datalook.php"}]},{"question":"\xbfC\xf3mo atienden mis solicitudes y reclamos?","content":[{"maintitle":"\xbfC\xf3mo atienden mis solicitudes, consultas y reclamos?"},{"paragraph":"Cualquier pregunta, solicitud, consulta o reclamo en relaci\xf3n con tus datos personales recolectados y tratados por BetPlay, ser\xe1 recibida por el Oficial de Protecci\xf3n de Datos de la organizaci\xf3n, para lo cual, deber\xe1s enviar una descripci\xf3n de forma f\xedsica o digital como se menciona a continuaci\xf3n, conforme a lo establecido en la Ley 1581 de 2012:"},{"title":"Consultas","paragraph":"A trav\xe9s del mecanismo de consulta, puedes solicitar a BetPlay acceso a tu informaci\xf3n personal. La consulta ser\xe1 atendida en un t\xe9rmino m\xe1ximo de diez (10) d\xedas h\xe1biles contados a partir de la fecha del recibo de \xe9sta. En caso de que no sea posible dar respuesta a la consulta dentro del t\xe9rmino indicado, te informaremos los motivos de la demora y daremos respuesta m\xe1ximo en cinco (5) d\xedas h\xe1biles siguientes al vencimiento del primer t\xe9rmino. Para la atenci\xf3n de la consulta, debes aportar la siguiente informaci\xf3n: <br> <ol> <li> Nombre completo y n\xfamero de identificaci\xf3n. </li> <li> Especificar de manera clara y expresa el motivo de la consulta. </li> <li> Motivos o hechos que dan lugar a la consulta, con una breve descripci\xf3n del derecho que deseas ejercer (conocer, actualizar, rectificar, solicitar prueba de la autorizaci\xf3n otorgada, revocarla o suprimir la informaci\xf3n), adjuntando en todo caso los debidos soportes. </li> <li> Indicar la direcci\xf3n f\xedsica o electr\xf3nica de correspondencia a la que se pueda remitir la respuesta de la solicitud. </li> </ol>"},{"title":"Reclamos","paragraph":"Al igual que una consulta, para realizar un reclamo, debes aportar la siguiente informaci\xf3n en caso de considerar que los datos contenidos en nuestra base de datos deben ser objeto de correcci\xf3n, actualizaci\xf3n, supresi\xf3n o revocaci\xf3n de la autorizaci\xf3n otorgada para su tratamiento o cuando adviertan el incumplimiento de cualquiera de los deberes contenidos en la Ley y sus normas complementarias: <br> <ol> <li> Nombre completo y n\xfamero de identificaci\xf3n. </li> <li> Especificar de manera clara y expresa el motivo del reclamo. </li> <li> Motivos o hechos que dan lugar al reclamo, con una breve descripci\xf3n del derecho que deseas ejercer, adjuntando en todo caso los debidos soportes. </li> <li> Indicar la direcci\xf3n f\xedsica o electr\xf3nica de correspondencia a la que se pueda remitir la respuesta de la solicitud. </li> </ol> <br> Ten en cuenta que en caso de encontrar que el reclamo est\xe1 incompleto, se le requerir\xe1 al interesado la informaci\xf3n necesaria para subsanar las fallas dentro de los cinco (5) d\xedas siguientes a la recepci\xf3n del mismo. Si transcurridos dos (2) meses desde la fecha de la solicitud, sin que el solicitante presente lo requerido, se entender\xe1 que ha desistido del reclamo. En caso de que BetPlay no sea competente para resolver el reclamo, dar\xe1 traslado a quien corresponda en un t\xe9rmino m\xe1ximo de dos (2) d\xedas h\xe1biles e informar\xe1 de la situaci\xf3n al interesado. Una vez recibido el reclamo completo, se incluir\xe1 en la base de datos de PQRS una leyenda que diga \'reclamo en tr\xe1mite\' y el motivo del mismo, en un t\xe9rmino no mayor a dos (2) d\xedas h\xe1biles. Dicha leyenda deber\xe1 mantenerse hasta que el reclamo sea resuelto. El t\xe9rmino m\xe1ximo para atender el reclamo ser\xe1 de quince (15) d\xedas h\xe1biles contados a partir del d\xeda siguiente a la fecha de su recibo. Cuando no fuere posible atenderlo dentro de dicho t\xe9rmino, se informar\xe1 al interesado los motivos de la demora y la fecha en que se resolver\xe1 su reclamo, la cual en ning\xfan caso podr\xe1 superar los ocho (8) d\xedas h\xe1biles siguientes al vencimiento del primer t\xe9rmino."},{"title":"Solicitud de im\xe1genes y videos","paragraph":"En caso de que el necesites solicitar acceso a im\xe1genes y/o videos donde se capture tu informaci\xf3n, deber\xe1s seguir el siguiente procedimiento: <ol> <li> Indicar los hechos de la solicitud, estableciendo fecha, hora, lugar y dem\xe1s informaci\xf3n que facilite la ubicaci\xf3n del fragmento de imagen o video. </li> <li> Justificar la necesidad de la solicitud. </li> <li> Aportar los documentos que permitan justificar que eres el indicado para realizar dicha solicitud. En caso de que el interesado sea un tercero, deber\xe1 aportar el documento de autorizaci\xf3n para el acceso a la informaci\xf3n por parte tuya como titular del dato. </li> </ol> <br> Para proceder con el tr\xe1mite, BetPlay actuar\xe1 atendiendo lo siguiente: <br> <ol> <li> Verificar\xe1 que la informaci\xf3n a\xfan se encuentre almacenada. </li> <li> Revisar\xe1 dicha solicitud, y verificar\xe1 si es procedente, revisando que no afecte el derecho a la intimidad, y otros derechos fundamentales de terceras personas diferentes al Titular de la informaci\xf3n que se encuentren en dichas im\xe1genes y/o video. </li> <li> En caso de que afecte derechos de terceros, notificar\xe1 que dentro de la informaci\xf3n solicitada se encuentran im\xe1genes de terceros y, en ese caso, garantizar\xe1 la anonimizaci\xf3n (hacer borrosa o fragmentar la imagen) de los datos de dicho tercero. </li> <li> En caso de que no afecte derechos fundamentales de terceros, pondr\xe1 a disposici\xf3n del Titular la informaci\xf3n que requiere, a trav\xe9s de los medios id\xf3neos (correo electr\xf3nico, medio magn\xe9tico o similares) para que pueda visualizar la informaci\xf3n que requiere. </li> </ol>"}]}]},{"title":"Pol\xedtica","image":"../../../../assets/images/Icono Politica.svg","QuestionList":[{"question":"Modificaciones a la pol\xedtica","content":[{"maintitle":"Modificaciones a la pol\xedtica"},{"paragraph":"BetPlay se reserva el derecho de modificar esta pol\xedtica en cualquier momento, sin embargo, cualquier cambio ser\xe1 informado y publicado oportunamente a trav\xe9s de la p\xe1gina web https://betplay.com.co/y se inscribir\xe1 all\xed su fecha de cambio. Esta versi\xf3n de la pol\xedtica fue creada el mes de abril del a\xf1o 2024. En caso de que los Titulares de la informaci\xf3n o sus representantes no est\xe9n de acuerdo con las nuevas pol\xedticas de tratamiento de datos personales, podr\xe1n solicitar el retiro de su informaci\xf3n a trav\xe9s de los canales indicados anteriormente. Sin embargo, no se podr\xe1 solicitar el retiro de los datos mientras se mantenga un v\xednculo de orden contractual o legal con BetPlay."}]},{"question":"Vigencia de la pol\xedtica","content":[{"maintitle":"Vigencia de la pol\xedtica"},{"paragraph":"Esta pol\xedtica se encuentra vigente desde 10 de noviembre de 2023 y continuar\xe1 vigente durante el tiempo que sea necesario para cumplir con las finalidades mencionadas en la misma."},{"title":"Anexo #1","paragraph":"<ul> <li> GRUPO EMPRESARIAL EN LINEA S.A. </li> <li> REDITOS EMPRESARIALES S.A. </li> <li> JUEGOS Y APUESTAS LA PERLA S.A. </li> <li> ALIANZA EMPRESARIAL DEL CAUCA S.A. </li> <li> APOSTADORES DE RISARALDA S.A. </li> <li> RED DE SERVICIOS DE NORTE DE SANTANDER S.A. </li> <li> RED DE SERVICIOS DEL QUINDIO S.A. </li> <li> SOCIEDAD EMPRESARIAL DEL META S.A. </li> <li> RED DE SERVICIOS DE LA ORINOQUIA Y EL CARIBE S.A. </li> <li> REDCOLSA RED COLOMBIANA DE SERVICIOS S.A. </li> <li> APUESTAS NACIONALES DE COLOMBIA S.A. </li> <li> SEAPTO S.A. </li> <li> SUSUERTE S.A. </li> <li> JER S.A. </li> <li> SER RED S.A. </li> <li> GRUPO EMPRESARIAL MULTIRED S.A. </li> <li> RED DE SERVICIOS DE OCCIDENTE S.A. </li> <li> RED MULTISERVICIOS DE COLOMBIA S.A. </li> <li> RED DE SERVICIOS DE CORDOBA S.A. </li> <li> SUPERSERVICIOS DE NARI\xd1O S.A. </li> <li> INVERSIONES DEL PACIFICO S.A. </li> <li> GRUPO EMPRESARIAL SERVIRED S.A. </li> <li> SUPERSERVICIOS DEL ORIENTE DEL VALLE S.A. </li> <li> SUPER SERVICIOS DEL CENTRO DEL VALLE S.A. </li> <li> APUESTAS AMERICA S.A. </li> </ul>"}]}]}]},"PropertyTypes":{"AP":"Apartamento","ET":"Etapa","LC":"Local","CON":"Conjunto residencial","CONJ":"Conjunto","ESQ":"Esquina","P":"Piso","BL":"Bloque","MZ":"Manzana","IN":"Interior","ED":"Edificio","OF":"Oficina","TO":"Torre","CRT":"Carretera","CA":"Casa"},"AddressTypes":{"AC":"Avenida calle","AK":"Avenida carrera","AUT":"Autopista","AV":"Avenida","CL":"Calle","CRV":"Circunvalar","DG":"Diagonal","TV":"Transversal","KM":"Kil\xf3metro","CR":"Carrera","CIR":"Circular"},"helpData":{"title":"Centro de ayuda FAQ","subtitle":"Bienvenido al centro de ayuda Betplay donde podr\xe1s aclarar tus dudas sobre nuestras apuestas online.","QuestionList":[{"title":"Glosario","image":"../../../../assets/images/Icono Escencia.svg","QuestionList":[{"question":"Apuestas sencillas","answer":"Aplica cuando seleccionas un solo evento deportivo y apuestas a un solo resultado. <br> <br> Para m\xe1s informaci\xf3n consulta <strong><a href=\\"https://youtu.be/5nf7OLLbVg0?si=jWctRL1O3naouJzd\\" target=\\"_blank\\">https://youtu.be/5nf7OLLbVg0?si=jWctRL1O3naouJzd</a></strong>"},{"question":"Apuestas combinadas","answer":"En este tipo de apuesta, podr\xe1s seleccionar uno o varios eventos deportivos y realizar apuestas a diferentes resultados dentro de un mismo ticket, para que este tipo de apuesta sea ganadora, debes acertar a todos los resultados, de lo contrario se declarar\xe1 p\xe9rdida.<br> <br> Puedes combinar hasta 20 apuestas, para m\xe1s informaci\xf3n consulta <strong>         <a href=\\"https://youtu.be/yjO-IPmAxRE\\" target=\\"_blank\\">https://youtu.be/yjO-IPmAxRE</a> </strong>"},{"question":"Apuestas sistema","answer":"Al igual que en las combinadas, permite realizar varias apuestas en un solo ticket, la diferencia est\xe1 en que puedes ganar la apuesta sin tener que acertar todos los resultados. Dentro de esta modalidad, t\xfa eliges como quieres jugar. Existen varias opciones de sistema que dependen del n\xfamero de eventos o partidos que desees incluir. All\xed encontrar\xe1s las opciones m\xe1s b\xe1sicas dentro de la apuesta sistema como, la sencilla, doble, triple o cu\xe1druple. <br> <br> Para m\xe1s informaci\xf3n <strong> <a href=\\"https://youtu.be/zZ6J5JxpfVI?si=mv96pFsN1NY4hM_A\\" target=\\"_blank\\">https://youtu.be/zZ6J5JxpfVI?si=mv96pFsN1NY4hM_A</a> </strong>"},{"question":"Apuestas en vivo","answer":"Como su nombre lo indica, una apuesta en vivo es la que puedes realizar durante el desarrollo de un competencia o evento deportivo. Ejemplo; inici\xf3 el cl\xe1sico entre los mejores equipos de tu ciudad, puedes realizar una apuesta sencilla en el tiempo que dure el encuentro eligiendo entre ganador, perdedor o empate, o incluso, puedes jugar con lo que va pasando en el encuentro."},{"question":"Apuesta especiales","answer":"En las apuestas especiales o apuestas combinadas especiales, literal botamos la casa por la ventana con promociones, sacando s\xfaper cuotas y con beneficios \xfanicos para ti. En este tipo de apuestas, por ejemplo, puedes apostar al total de goles de una liga o a la victoria de varios de equipos, unas opciones que no encontrar\xe1s en otro lugar. <br> <br> Para m\xe1s informaci\xf3n consulta <strong> <a href=\\"https://youtu.be/fOdFTvkhrU8?si=9G1_DCzJk7Ovcfnc\\" target=\\"_blank\\">https://youtu.be/fOdFTvkhrU8?si=9G1_DCzJk7Ovcfnc</a> </strong>"},{"question":"Apuesta pre-match","answer":"Las apuestas pre-match, al contrario de las apuestas en vivo, son aquellas que se hacen previo al inicio de una competencia o evento. Esto te dar\xe1 la posibilidad de analizar diferentes factores a la hora de concretar tu apuesta, como el rendimiento de los equipos o jugadores, alineaciones, entre otros. "},{"question":"Banca","answer":"Rol del operador durante el desarrollo del juego, a excepci\xf3n de aquellos juegos en los que la figura de la banca pueda o deba ser ocupada por alguno de los jugadores en el marco de una mano o partida concreta. "},{"question":"Bonos","answer":"Aquellos entregados al apostador previo cumplimiento de las condiciones derivadas de la participaci\xf3n en una o varias partidas o eventos."},{"question":"Cuota","answer":"Una cuota en el universo de las apuestas en l\xednea es la probabilidad asignada a un atleta, equipo o resultado que determinar\xe1 la ganancia potencial que tendr\xe1s al momento de llevar a cabo una apuesta. <br> <br> Para m\xe1s informaci\xf3n consulta <strong> <a href=\\"https://youtu.be/ohEi0SHizJ8\\" target=\\"_blank\\">https://youtu.be/ohEi0SHizJ8</a> </strong>"},{"question":"Cuenta de usuario","answer":"Registro \xfanico mediante el cual el jugador ingresa determinados datos y aporta la informaci\xf3n o documentaci\xf3n necesaria para obtener la apertura de una cuenta de usuario que le permite acceder a las actividades de juego ofrecidas. La cuenta de usuario puede tener estado activa, suspendida y cancelada. "},{"question":"Jackpot","answer":"Bolsa de premio o garantizado acumulado, que se otorga al jugador ganador que logra una apuesta o jugada ganadora en unas condiciones previamente establecidas."},{"question":"Jugador","answer":"Persona natural mayor de edad que voluntariamente decide registrarse mediante una cuenta de usuario, para participar realizando apuestas en la diferente oferta de juegos. "},{"question":"Mano o jugada","answer":"En los juegos de naipes es el conjunto de partidas o jugadas, o en su caso, de la banca. "},{"question":"Evento o partida","answer":"Desarrollo del juego que se inicia con la apuesta correspondiente que realizas y finaliza con la obtenci\xf3n del resultado y el pago del premio si eres ganador. "},{"question":"Premios","answer":"Si eres un ganador, esto corresponde a los beneficios en apuesta, bonos o dinero real que se otorgan por acertar el resultado de una partida o evento en un determinado juego y cuyo valor corresponde a lo definido en la promoci\xf3n."}]},{"title":"Apuestas","image":"../../../../assets/images/Icono Escencia (1).svg","QuestionList":[{"question":"\xbfQu\xe9 son las apuestas deportivas?","answer":"Es una modalidad de apuesta en la que se pronostica un resultado deportivo, en Betplay podr\xe1s apostar en f\xfatbol, baloncesto, tenis, E-sports y muchos m\xe1s desde $500. "},{"question":"\xbfC\xf3mo apostar?","answer":"\xa1Se parte del mundo de ganadores BetPlay!, \xbfsabes c\xf3mo apostar? Aqu\xed te ense\xf1amos. <br> <br> <ul> <li>Ingresa a tu cuenta con usuario y contrase\xf1a, has clic en Men\xfa y dir\xedgete a la secci\xf3n deportes. </li> <li>Puedes buscar y elegir el evento en el que desees apostar, ya sea por el nombre de la Liga, torneo, equipo o deporte. </li> <li>Elige la modalidad de apuesta, selecciona la opci\xf3n correspondiente, seguido se habilitar\xe1 una casilla, donde se especifica en un recuadro amarillo la apuesta a realizar, all\xed ingresas el valor a apostar, en la parte inferior se informar\xe1 el pago potencial de tu ganancia, despu\xe9s de rectificarlo solo debes dar clic en Apostar. </li> <li>La plataforma te confirmar\xe1 la apuesta, te dar\xe1 un ID de Cup\xf3n o n\xfamero de Recibo y listo. </li> </ul> <br> <br> Si ganaste la apuesta, el proceso de pago de apuestas casi siempre es inmediato, pero en algunos eventos, la informaci\xf3n tarda en ser transmitida por parte de la federaci\xf3n o el ente oficial, por lo tanto, agradecemos que esperes un m\xe1ximo de 24 horas para que se califique la apuesta.  "},{"question":"\xbfC\xf3mo redimir una apuesta gratuita?","answer":"La apuesta gratuita es un beneficio otorgado a nuestros jugadores seg\xfan promoci\xf3n, actividad o campa\xf1a. <br> <br> <ul> <li> La apuesta gratuita la ver\xe1s reflejada en la secci\xf3n \\"Mis Apuestas Gratuitas\\", que est\xe1 junto a la secci\xf3n de \\"Mis Apuestas\\" </li> <li> Una apuesta gratuita solo puede usarse en cuotas mayores a 1.50. </li> <li> Una vez conozcas las condiciones de la apuesta gratis, busca un evento o los eventos en los cuales puedes usarla, se habilitar\xe1 una casilla en el ticket de tu apuesta, selecci\xf3nala, y da clic en el bot\xf3n verde de Apostar y listo. </li> <li> <strong> Recuerda: </strong> La apuesta gratuita solo podr\xe1 utilizarse en eventos deportivos, sujeto a los TyC descritos en la apuesta gratis y de su vigencia. </li> </ul> <br> <br> En el siguiente tutorial te explicamos el paso a paso para que redimas una apuesta gratuita: <br> <br> <ul> <li> <a href=\\"https://youtu.be/9dK767eLEk4\\" target=\\"_blank\\">https://youtu.be/9dK767eLEk4</a> </li> </ul>"},{"question":"\xbfC\xf3mo consultar tus apuestas?","answer":"Ingresa a tu cuenta, dir\xedgete a la secci\xf3n \\"deportes\\", luego elige la opci\xf3n de \\"Mis Apuestas\\" y all\xed encontrar\xe1s tus apuestas realizadas y el resultado de las mismas.      "},{"question":"\xbfQu\xe9 es un parley?","answer":"Parley es una apuesta que combina m\xfaltiples selecciones en una sola apuesta y para ganar, debes acertar absolutamente en todas, con una que falles, la apuesta se pierde."},{"question":"Reglas de apuestas","answer":"Si tienes dudas, puedes ingresar al siguiente link para acceder a nuestras reglas deportivas de forma detallada: <br> <br> <ul> <li> <strong> <a href=\\"https://betplay.com.co/reglas-apuestas-deportivas\\" target=\\"_blank\\">https://betplay.com.co/reglas-apuestas-deportivas</a> </strong> </li> </ul>"}]},{"title":"Casino","image":"../../../../assets/images/Icono Escencia (2).svg","QuestionList":[{"question":"\xbfQu\xe9 son los slots? ","answer":"Si ya te has registrado en Betplay solo tendr\xe1s que iniciar sesi\xf3n, dirigirte al men\xfa desplegable y seleccionar \\"CASINO\\" all\xed encontrar\xe1s nuestra amplia oferta de juegos para que elijas seg\xfan tus gustos y preferencias. "},{"question":"\xbfD\xf3nde puedo ver las promociones de los pagamonedas?","answer":" Puedes ver todos los detalles de las promociones activas para los pagamonedas de Betplay buscando en el men\xfa desplegable \\"Promociones\\" y deslizar todas las promociones que tenemos vigentes en el riel \\"ACTIVAS\\". <br> <br> Si tienes dudas con respecto a: <br> <br> <ul> <li> \xbfC\xf3mo se juegan las pagamonedas o slots? Revisa el siguiente video: </li> </ul> <br> <br> <strong> <a href=\\"https://youtu.be/dlBBqbN2xBQ?si=EJ_wnpZDdyTKWFWY\\" target=\\"_blank\\">https://youtu.be/dlBBqbN2xBQ?si=EJ_wnpZDdyTKWFWY</a> </strong> <br> <br> <ul> <li> \xbfC\xf3mo redimir cartones de Bingo?  Revisa el siguiente video: </li> </ul> <br> <br> <strong> <a href=\\"https://youtu.be/wb9f-HGDfOA?si=81J67wY7EUEIpRc-\\" target=\\"_blank\\">https://youtu.be/wb9f-HGDfOA?si=81J67wY7EUEIpRc-</a> </strong> <br> <br> <ul> <li> \xbfC\xf3mo Redimir tu bono de casino? Revisa el siguiente video: </li> </ul> <br> <br> <strong> <a href=\\"https://youtu.be/CK85cmaL0z8\\" target=\\"_blank\\">https://youtu.be/CK85cmaL0z8</a> </strong>"}]},{"title":"Cuenta","image":"../../../../assets/images/Icono Escencia (8).svg","QuestionList":[{"question":"\xbfC\xf3mo me registro?","answer":"Ingresa a Betplay.com.co desde un computador o descarga la app y selecciona la opci\xf3n \\"REGISTRO\\", diligencia cada campo tal cual, y como aparecen en tu documento de identidad, el celular y correo deben ser reales ya que all\xed te enviamos los c\xf3digos de seguridad para realizar tus retiros, Acepta t\xe9rminos y condiciones y nuestra pol\xedtica de comunicaciones. Tambi\xe9n puedes seguir el paso a paso del siguiente tutorial para unirte al mundo de ganadores: <br> <br> <ul> <li> <strong> <a href=\\"https://youtu.be/dj6ZAko1tB8\\" target=\\"_blank\\">https://youtu.be/dj6ZAko1tB8</a> </strong> </li> </ul> <br> <br> Si eres ciudadano venezolano con permiso de permanencia y quieres registrarte con nosotros, revisa el siguiente tutorial para que tu registro sea efectivo: <br> <br> <ul> <li> <strong> <a href=\\"https://youtu.be/j7MGBdQ5Y8M?si=wx9oCvnVh-NJh_b_\\" target=\\"_blank\\">https://youtu.be/j7MGBdQ5Y8M?si=wx9oCvnVh-NJh_b_</a> </strong> </li> </ul>"},{"question":"\xbfC\xf3mo actualizo mis datos?","answer":"Podr\xe1s actualizar tus datos desde tu cuenta Betplay cada 30 d\xedas de la siguiente manera: <br> <br> <ul> <li> Ingresa a tu cuenta con usuario y contrase\xf1a. </li> <li> Dir\xedgete a la opci\xf3n MI CUENTA, la cual aparece en el men\xfa desplegable de usuario. </li> <li> Selecciona actualizar datos, y diligencia los datos a modificar, el sistema te enviara un c\xf3digo de seguridad al n\xfamero celular y al correo registrado en tu cuenta, el cual debes ingresar para guardar los cambios. </li> <li> La actualizaci\xf3n se realizar\xe1 de forma inmediata. </li> <li> \xa1Ten en cuenta! Tu n\xfamero telef\xf3nico y correos deben ser \xfanicos en tu cuenta, ya que, si dig\xedtas un n\xfamero de celular o correo electr\xf3nico, que ya se encuentre relacionado en otra cuenta no te permitir\xe1 la actualizaci\xf3n. </li> <li> Si no cuentas con el n\xfamero celular y el email registrado en tu cuenta, es necesario que solicites comunicarte con un asesor, escribiendo la palabra ASESOR en el chat para que nos compartas una foto de tu c\xe9dula por ambas caras y una selfie con la misma. </li> <li> El proceso se realizar\xe1 en el menor tiempo posible una vez verifiquemos tus datos. </li> </ul> <br> <br> En el siguiente tutorial te explicamos el paso a paso para que actualices tus datos: <ul> <li> <strong> <a href=\\"https://youtu.be/qZ-bVeI7rCI\\" target=\\"_blank\\">https://youtu.be/qZ-bVeI7rCI</a> </strong> </li> </ul> "},{"question":"\xbfC\xf3mo restablezco mi contrase\xf1a?","answer":"Para restablecer tu contrase\xf1a, debes: <br> <br> <ul> <li> Dirigirte a la ventana principal y dar clic en <strong>\xbfOLVIDASTE TU CONTRASE\xd1A? </strong> </li> <li> Colocar tu n\xfamero de c\xe9dula y dar clic en  <strong >\\"RECUPERAR\\"</strong> </li> <li> Recibir\xe1s un link a tu celular y correo electr\xf3nico registrados. </li> <li> \xa1Ten en cuenta!  Tu contrase\xf1a debe tener las siguientes caracter\xedsticas: M\xednimo 8 caracteres y m\xe1ximo 12, debe contener m\xednimo un car\xe1cter especial (*/_+.) y una letra may\xfascula. Por tu seguridad no ingreses datos personales contenidos en la cuenta. </li> </ul> <br> <br> En el siguiente tutorial te explicamos el paso a paso para que restablezcas tu contrase\xf1a: <br> <br> <strong> <a href=\\"https://youtu.be/F2lGf8l35z4\\" target=\\"_blank\\">https://youtu.be/F2lGf8l35z4</a> </strong> <br> <br> Si no recuerdas tu correo o celular registrados, comun\xedcate con uno de nuestros asesores."},{"question":"\xbfC\xf3mo me autoexcluyo?","answer":"Para activar la autoexclusi\xf3n, ingresa a tu cuenta BetPlay, selecciona los tres puntos verticales ubicados en la parte superior, da clic en \\"MI CUENTA\\", selecciona el \xedtem \\"L\xcdMITES DE USUARIO\\" y luego da clic en \\"Autoexcusi\xf3n\\", diligencia el tiempo y el motivo por el cu\xe1l deseas hacer esta solicitud, guarda y listo. <br> <br> De igual forma puedes ver el siguiente tutorial de c\xf3mo activar o desactivar la autoexclusi\xf3n: <br> <br> <ul> <li> <strong> <a href=\\"https://youtu.be/Hn-EtP8F5SA\\" target=\\"_blank\\">https://youtu.be/Hn-EtP8F5SA</a> </strong> </li> </ul> <br> <br> Tan pronto se cumpla el tiempo elegido de tu Autoexclusi\xf3n la cuenta se reactivar\xe1 o puedes comunicarte con nuestros canales de atenci\xf3n para solicitarla.  "},{"question":"Tengo mi cuenta retenida \xbfqu\xe9 hago? ","answer":"Ten en cuenta que para esta solicitud se requiere hacer la validaci\xf3n de tu cuenta, dir\xedgete a nuestros canales de contacto y favor ten lista una foto de tu c\xe9dula por ambas caras, una selfie junto a tu c\xe9dula y estar disponible para una posible video llamada para validar tus datos. "}]},{"title":"Recargas","image":"../../../../assets/images/Icono Escencia (4).svg","QuestionList":[{"question":"\xbfC\xf3mo puedo recargar?","answer":"Dir\xedgete dentro de tu cuenta a la secci\xf3n de \\"RECARGAS\\" y elige el m\xe9todo de pago: <br> <br> <ul> <li> <strong> PSE: </strong> Diligencia el valor a recargar, elige la pasarela de pago (Kushki, PayU, Tucompra), elige el banco desde el que desear realizar la transacci\xf3n, diligencia tus datos y recarga. </li> <li> </li> <li> <strong> Credito/d\xe9bito: </strong> Elige la opci\xf3n \\"Tarjetas\\", ingresa el valor que quieres recargar en tu cuenta, diligencia tus datos personales, selecciona la pasera de pagos y da clic en el bot\xf3n \\"RECARGAR\\". Una vez la transacci\xf3n sea aprobada ver\xe1s el saldo reflejado en tu cuenta de usuario.! </li> <li> <strong> En efectivo: </strong> Dir\xedgete a un punto de Supergiros, Sured o a cualquiera de nuestros convenios a nivel nacional, lleva tu c\xe9dula y el dinero en efectivo a recargar \xa1Y listo! </li> <li> \xa1Ten en cuenta! En ocasiones estas transacciones pueden tardar hasta 4 horas en proceso, de acuerdo al tr\xe1fico de operaciones que haya en el momento y de las validaciones por parte de Payu, que se realizan por tu seguridad. </li> </ul>"},{"question":"\xbfD\xf3nde puedo consultar mi saldo?","answer":"Ingresa a tu cuenta BetPlay, da clic en los tres puntos verticales y autom\xe1ticamente se desplegar\xe1 la informaci\xf3n relacionada a tu saldo y bonos.  "}]},{"title":"Retiros","image":"../../../../assets/images/Icono Escencia (5).svg","QuestionList":[{"question":"\xbfEn d\xf3nde puedo retirar mi dinero?","answer":"Ingresa a tu cuenta Betplay, da clic en la opci\xf3n \\"RETIROS\\" y selecciona: <br> <br> <ul> <li> Punto de venta:  Puedes retirar en cualquier punto Supergiros o Sured con el c\xf3digo pin generado luego de que relaciones el monto a retirar, este c\xf3digo lo recibir\xe1s en tu correo y celular registrado. <ul> <li> <strong> \xa1Ten en cuenta! </strong> Los retiros deben ser a partir de $2.000 pesos y m\xe1ximo $2.514.000 </li> <li> Podr\xe1s realizar m\xe1ximo 3 retiros diarios. </li> <li> Inmediatamente despu\xe9s de solicitar tu C\xf3digo PIN, el monto colocado en el campo \\"Importe\\" ser\xe1 deducido de tu saldo disponible, si en el lapso de 24 horas no se finaliza la transacci\xf3n de retiro, el valor solicitado anteriormente ser\xe1 devuelto como saldo disponible a tu cuenta. </li> <li> *El C\xf3digo PIN expirar\xe1 en 24 horas. </li> </ul> </li> </ul> <br> <br> <ul> <li> Grupo \xe9xito:  Ac\xe9rcate a cualquier punto \xe9xito con el c\xf3digo pin de 6 d\xedgitos generado luego de que relaciones el monto a retirar, este c\xf3digo lo recibir\xe1s en tu correo y celular registrado. <ul> <li> <strong> \xa1Ten en cuenta! </strong> Los retiros deben ser a partir de $5.000 pesos y m\xe1ximo $2\'036.000 </li> <li> Podr\xe1s realizar m\xe1ximo 3 retiros diarios. </li> <li> Inmediatamente despu\xe9s de solicitar tu C\xf3digo PIN, el monto colocado en el campo \\"Importe\\" ser\xe1 deducido de tu saldo disponible, si en el lapso de 24 horas no se finaliza la transacci\xf3n de retiro, el valor solicitado anteriormente ser\xe1 devuelto como saldo disponible a tu cuenta. </li> <li> *El C\xf3digo PIN expirar\xe1 en 24 horas. </li> </ul> </li> </ul> <ul> <li> Cuenta bancaria:  Diligencia los datos de la cuenta bancaria a la cual deseas transferir tu retiro y el monto a retirar. </li> <li> <ul> <li> \xa1Ten en cuenta! Los retiros por transferencia deben ser a partir de $100.000 pesos y m\xe1ximo $500.000.000 </li> <li> Podr\xe1s realizar m\xe1ximo 3 retiros diarios. </li> <li> Inmediatamente despu\xe9s de solicitar tu C\xf3digo PIN, el monto colocado en el campo \\"Importe\\" ser\xe1 deducido de tu saldo disponible, si en el lapso de 24 horas no se finaliza la transacci\xf3n de retiro, el valor solicitado anteriormente ser\xe1 devuelto como saldo disponible a tu cuenta. </li> </ul> </li> </ul>"},{"question":"\xbfProblemas con tus retiros?","answer":"Se permiten M\xe1ximo 3 retiros diarios. <br> <br> Si en el lapso de 24 horas no se finaliza la transacci\xf3n de retiro por PIN, el valor solicitado en el campo \\"importe\\" ser\xe1 devuelto como saldo disponible a tu cuenta BetPlay y el PIN expira. No debes tener apuestas pendientes por calificar. <br> <br> Recuerda que, al momento de retirar tus premios, debes tener en cuenta que la suma de las apuestas que has realizado debe ser mayor o igual al 50% de la suma del dinero que hayas depositado desde que creaste la cuenta. No suman las apuestas realizadas por cobro anticipado. <br> <br> La transferencia bancaria puede tardar entre 24 o 72 horas h\xe1biles para aparecer en la cuenta de tu banco. Esto depender\xe1 de los tiempos que toman las transferencias interbancarias. <br> <br>"}]}]},"termData":{"QuestionList":[{"title":"Objeto y aceptaci\xf3n del contrato","QuestionList":[{"question":"1- Objeto  ","answer":"El objeto del presente contrato (en adelante, el \u201cContrato\u201d) es regular el uso de y participaci\xf3n en juegos de azar y servicios ofrecidos por el Operador en l\xednea (\u201cOnline\u201d), incluyendo, a t\xedtulo enunciativo, pero no limitativo, m\xe1quinas de azar o tambi\xe9n denominadas \u201cslots online\u201d, apuestas deportivas y no deportivas de contrapartida, ruleta, black jack, baccarat, bingo y poker; todo ello de conformidad con la concesi\xf3n otorgada por COLJUEGOS al amparo del Acuerdo 008 del 16 de septiembre de 2020 y/o aquellos que lleguen a modificarlo, remplazarlo o complementarlo. Entre otras cuestiones, dicho Contrato regula los derechos y obligaciones de las partes, su inscripci\xf3n en el Registro de Usuario, uso de la Cuenta de Juego, suspensi\xf3n y cancelaci\xf3n de la misma.<br><br>El Operador ofrecer\xe1 los juegos de azar y servicios descritos anteriormente en la(s) siguiente(s) P\xe1gina(s) Web: betplay.com.co as\xed como para las versiones adaptadas de la misma para diferentes dispositivos de acceso. Adicionalmente a la P\xe1gina Web, el Operador podr\xe1 ofrecer sus Servicios de Juego mediante plataformas alternativas como (i) plataforma de juegos m\xf3viles y (ii) terminales f\xedsicos.<br><br>Los distintos juegos de azar y servicios ser\xe1n accesibles, entre otros, desde ordenadores, port\xe1tiles, tablets, tel\xe9fonos m\xf3viles y terminales f\xedsicos. La oferta de juegos podr\xe1 variar dependiendo del tipo de dispositivo utilizado.<br><br>Mediante la aceptaci\xf3n del presente Contrato se constituye un documento legal de car\xe1cter vinculante y obligatorio entre el Participante y el Operador.<br><br>La persona f\xedsica interesada en acceder a los servicios de entretenimiento de la plataforma de apuestas (denominada en adelante, \xa8el Participante\xa8 deber\xe1 aceptar previamente el presente Contrato y crear una Cuenta de Juego, mediante el Registro de Usuario.<br><br>El Participante no podr\xe1 encontrarse incurso en ninguna de las prohibiciones previstas por el Acuerdo 008 del 16 de septiembre de 2020 Reglamento del Juego. A este respecto, se informa al Participante que, de acuerdo al art\xedculo 1.7.4 de dicho acuerdo, se proh\xedbe la participaci\xf3n en los juegos ofrecidos por el Operador a:<br><br>a. Menores de edad. El operador debe verificar la edad del jugador y establecer las restricciones necesarias para evitar que las apuestas sean realizadas por aquellos que no acrediten mayor\xeda de edad.<br>b. Personas que padezcan enfermedades mentales que hayan sido declaradas interdictos judicialmente.<br>c. Personal vinculado al operador: aquellos trabajadores que intervengan o puedan influir en el desarrollo de la actividad de juego definidos por el operador.<br>d. Jugadores autoexcluidos de conformidad con las solicitudes presentadas ante cada operador autorizado.<br><br>Mediante la aceptaci\xf3n del presente Contrato, el Participante declara no encontrarse en ninguno de los supuestos anteriores.<br><br>Las reglas concretas aplicables a cada tipo de juego, as\xed como los dem\xe1s servicios adicionales ofrecidos por el Operador figuran en cada juego disponible para consulta del usuario en la P\xe1gina Web en todo momento."},{"question":"2- Aceptaci\xf3n ","answer":"Se requerir\xe1 al Participante la aceptaci\xf3n expresa del Contrato mediante la marcaci\xf3n de la casilla habilitada para tal efecto al final del formulario de Registro de Usuario y creaci\xf3n de Cuenta de Juego. Para ello, el Participante deber\xe1 visitar la secci\xf3n \u201cRegistro de Usuario\u201d y seguir las instrucciones que aparezcan en la pantalla.<br><br>El Operador podr\xe1 introducir modificaciones en el presente Contrato. En tal caso, se informar\xe1 al Participante de las mismas al iniciar sesi\xf3n mediante un aviso que incluir\xe1 un mecanismo que permita marcar una casilla de aceptaci\xf3n.<br><br>El Participante no podr\xe1 hacer uso de su Registro de Usuario o de su Cuenta de Juego en tanto no haya aceptado las modificaciones.<br><br>En cualquier caso, si el Participante no desea seguir siendo usuario bajo las nuevas condiciones, lo manifestar\xe1 a trav\xe9s del mecanismo establecido a dichos efectos, el cual podr\xe1 consultar por los canales de contacto disponibles en la p\xe1gina web, dando lugar en consecuencia, a la cancelaci\xf3n del Registro de Usuario y la Cuenta de Juego. Se proceder\xe1 por parte del Operador a la devoluci\xf3n de los saldos existentes en la cuenta de juego de acuerdo con las reglas aplicables."}]},{"title":"Registro del participante y cuenta de juego","QuestionList":[{"question":"1- Activaci\xf3n del Registro de Usuario ","answer":"El proceso de Registro de Usuario requiere la identificaci\xf3n del Participante. \xc9ste deber\xe1 completar un formulario, que incluye entre otros, los siguientes campos: Datos de identificaci\xf3n:<br><br>\u2022\\tTipo de documento, que para este caso ser\xe1n:<br>\\t o\\tC\xe9dula de ciudadan\xeda para ciudadanos colombianos<br>\\t o\\tC\xe9dula de extranjer\xeda vigente, expedida por el Estado Colombiano para ciudadanos extranjeros.<br>\\t o\\tPermiso por Protecci\xf3n Temporal (PPT)<br>\\t o\\tLos dem\xe1s documentos definidos por el gobierno nacional para este fin y aceptados por el ente regulador de los juegos de suerte y azar en el pa\xeds.<br>\u2022\\tN\xfamero de identificaci\xf3n, dependiendo del tipo de documento<br>\u2022\\tPrimer nombre<br>\u2022\\tSegundo nombre<br>\u2022\\tPrimer apellido<br>\u2022\\tSegundo apellido<br>\u2022\\tSexo<br>\u2022\\tFecha de nacimiento<br>\u2022\\tLugar de nacimiento (para ciudadanos colombianos ser\xe1 el municipio y para extranjeros el pa\xeds)<br>\u2022\\tFecha de expedici\xf3n del documento de identificaci\xf3n<br>\u2022\\tLugar de expedici\xf3n del documento de identificaci\xf3n<br>\u2022\\tFecha de vencimiento de la c\xe9dula de extranjer\xeda<br><br>Datos personales:<br><br>\u2022\\tNacionalidad<br>\u2022\\tDepartamento de residencia<br>\u2022\\tMunicipio de residencia<br>\u2022\\tDirecci\xf3n de residencia (domicilio)<br>\u2022\\tC\xf3digo postal del domicilio<br>\u2022\\tDirecci\xf3n de correo electr\xf3nico - Email<br>\u2022\\tTel\xe9fono m\xf3vil<br>\u2022\\tTel\xe9fono fijo (opcional)<br><br>El Operador \xfanicamente aceptar\xe1 un Registro de Usuario por Participante. El Operador realizar\xe1 todas las comprobaciones necesarias para asegurarse de que cada Participante cuenta con un \xfanico Registro de Usuario. Si el Operador detecta alguna conexi\xf3n entre Registros de Usuario, asumir\xe1 la existencia de registros m\xfaltiples y, por consiguiente, este hecho por si mismo configurar\xe1 una infracci\xf3n del presente Contrato. En sospecha de tal situaci\xf3n, el Operador est\xe1 autorizado y facultado para suspender por precauci\xf3n la cuenta, cancelar el registro, cancelar las apuestas que se hayan realizado, anular cualquier premio transferido a una cuenta de usuario, as\xed como revocar cualquier bono obtenido.<br><br>Todos los datos registrados deben ser reales. No se admite el registro de Participantes bajo pseud\xf3nimo o utilizando nombres de terceros. El Participante, una vez haya suministrado todos los datos mencionados, deber\xe1 verificar que los mismos son veraces, exactos y completos, y deber\xe1 confirmar sus datos mediante la marcaci\xf3n de una casilla que se habilitar\xe1 al efecto para completar la aceptaci\xf3n del Contrato.<br><br>Cualquier duda sobre la identidad del participante o el uso exclusivo del titular respecto de la cuenta de juego, generar\xe1 de forma autom\xe1tica la suspensi\xf3n preventiva de la cuenta hasta que el titular de la cuenta pueda demostrar su identidad y esclarecer las circunstancias que dieron lugar a la suspensi\xf3n preventiva de la cuenta de acuerdo con el procedimiento establecido por el Operador para tal fin.<br><br>El Participante, al aceptar el presente Contrato, autoriza al Operador a realizar las comprobaciones necesarias en relaci\xf3n a la informaci\xf3n suministrada, seg\xfan los procedimientos establecidos por las Autoridades competentes y el mismo operador de juegos online. El Operador se reserva el derecho de realizar en cualquier momento estas comprobaciones durante la vigencia de la relaci\xf3n contractual.<br><br>El Operador podr\xe1, en cualquier momento, solicitar al Participante que facilite informaci\xf3n adicional o que le remita documentos acreditativos de su identidad, incluyendo a t\xedtulo enunciativo, pero no limitativo, fotocopia de su documento de identidad (por ambas caras), fotoselfies donde sea visible el documento de identidad y el rostro, certificados bancarios, certificado de su tarjeta de cr\xe9dito, declaraciones extra juicio con presentaci\xf3n personal ante notario p\xfablico colombiano, atenci\xf3n de video llamadas, presentaci\xf3n de facturas de servicios p\xfablicos, comprobantes de pago, entre otros.<br><br>La documentaci\xf3n solicitada podr\xe1 enviarse por el canal de correspondencia dispuesto en la p\xe1gina web o aquel que sea indicado por la plataforma.<br><br>Si fuera necesario, se solicitar\xe1n fotocopias autenticadas de dicha documentaci\xf3n para garantizar su veracidad. Si el Participante no aportase la documentaci\xf3n solicitada por el Operador, en el plazo indicado en la comunicaci\xf3n al Participante, el Operador se reserva el derecho de rechazar, cancelar, o suspender el Registro de Usuario."},{"question":"2- Activaci\xf3n de la Cuenta de Juego  ","answer":"Con el registro del Participante se crear\xe1 una Cuenta de Juego vinculada a sus datos. En dicha Cuenta de Juego, se reflejar\xe1n las transacciones econ\xf3micas, vinculadas a las actividades de juego y a los servicios adicionales ofrecidos por el Operador.<br><br>La Cuenta de Juego es personal e intransferible. Las operaciones realizadas desde ella por un Participante identificado mediante nombre de usuario y contrase\xf1a se considerar\xe1n v\xe1lidas a todos los efectos, asumiendo el Participante toda la responsabilidad derivada de las mismas.<br><br>El Participante deber\xe1 tomar las medidas necesarias para evitar la divulgaci\xf3n de sus claves de acceso. En caso de que sospeche que dichas claves pueden estar siendo utilizadas por terceros, el participante deber\xe1 tomar las medidas de autogesti\xf3n necesarias, generando el cambio de sus credenciales.<br><br>Las claves de acceso escogidas por los usuarios deben ser alfanum\xe9ricas, contener m\xe1s de un car\xe1cter especial (%,=,#, etc.) evitando usar el mismo usuario, c\xe9dula de ciudadan\xeda, fecha de nacimiento o n\xfamero de tel\xe9fono celular. Cabe resaltar que es responsabilidad del usuario la modificaci\xf3n de las credenciales de acceso m\xednimo cada seis meses.<br><br>La Cuenta de Juego es para uso exclusivo y personal del Participante y no podr\xe1 ser utilizada para usos profesionales, comerciales o de negocio. Cualquier indicio de uso para tales fines configurar\xe1 incumplimiento del presente contrato y dar\xe1 lugar a las medidas pertinentes por parte del operador, las cuales de manera enunciativa podr\xe1n ser la cancelaci\xf3n o suspensi\xf3n de la cuenta de juego, cancelaci\xf3n de las apuestas realizadas con tales fines seg\xfan el criterio del operador, anulaci\xf3n de las ganancias obtenidas en virtud de este actuar, as\xed como cualquier otra que el Operador considere necesaria.<br><br>El Participante declara que los fondos utilizados en la Cuenta de Juego no tienen procedencia ilegal y se compromete a no utilizar los Servicios de Juego con el fin de transferir fondos o de realizar una actividad il\xedcita o fraudulenta o cualquier transacci\xf3n prohibida (incluyendo todas las actividades directas y conexas del lavado de activos), conforme a la legislaci\xf3n aplicable.<br><br>El Participante declara que en la ejecuci\xf3n del presente contrato cumplir\xe1 estrictamente con todas las leyes y regulaciones aplicables en materia de anticorrupci\xf3n, antisoborno, prevenci\xf3n de opacidad y fraude, tales como Ley 2195 de 2022 adopci\xf3n medidas en materia de transparencia, prevenci\xf3n y lucha contra la corrupci\xf3n, el Estatuto Anticorrupci\xf3n (Ley 1474 de 2011), la Ley antisoborno (Ley 1778 de 2016), as\xed como cualquier otra norma nacional o internacional aplicable en materia de lucha contra la corrupci\xf3n y el soborno.<br><br>El Participante es plenamente responsable del uso de su cuenta conforme los T\xe9rminos Y Condiciones establecidos, as\xed como de mantener buenas pr\xe1cticas de juego. El Operador se reserva el derecho de suspender la Cuenta de Juego del Participante, de anular todo pago que se haya realizado y de recuperar todos los premios que haya pagado, en los supuestos de pago sospechoso o fraudulento producto de pr\xe1cticas indebidas, en los que se haya utilizado tarjetas de cr\xe9dito de propiedad de terceras personas o en el caso de cualquier otra actividad fraudulenta, conforme a lo establecido en la cl\xe1usula III, numeral 2 de los presentes t\xe9rminos y condiciones.<br><br>El Operador no ser\xe1 responsable de la utilizaci\xf3n fraudulenta de las tarjetas de cr\xe9dito del \xa8Participante\xa8 o de tarjetas de cr\xe9dito de propiedad de terceras personas, haya sido denunciado, o no, el hurto de \xe9stas por parte del propietario.<br><br>En los supuestos anteriores, el Operador se reserva el derecho, conforme a lo exigido por la normativa colombiana, a poner en conocimiento de las autoridades competentes cualquier hecho u operaci\xf3n respecto del que exista indicio o certeza de estar relacionado con el lavado de activos, financiaci\xf3n al terrorismo o cualquier otro delito, as\xed como aquellas operaciones que muestren una falta de correspondencia ostensible con la naturaleza, volumen de actividad o antecedentes operativos del Participante.<br><br>Si el Operador verifica que un Participante no tiene la edad m\xednima exigible para utilizar los Servicios de Juego y que de forma fraudulenta logr\xf3 vulnerar los filtros de registro, anular\xe1 las transacciones efectuadas por \xe9ste y proceder\xe1 a la devoluci\xf3n del dinero ingresado. As\xed mismo, cualquier premio que el Participante haya recibido ser\xe1 anulado, adoptando el Operador las medidas oportunas hasta que el Participante haya aportado una prueba irrefutable de tener la edad m\xednima exigible para utilizar los Servicios de Juego."},{"question":"3- Dep\xf3sitos y premios","table":{"paragrap":"Para hacer uso de los juegos y servicios ofrecidos por el Operador, el Participante tendr\xe1 que realizar dep\xf3sitos desde cualquiera de los puntos f\xedsicos autorizados para tales fines, una cuenta bancaria mediante el uso de pasarelas de pago autorizadas o trav\xe9s de cualquier medio dispuesto para tales fines usando un medio de pago del que sea titular. En caso de que la titularidad de \xe9stos corresponda a un tercero, o se tenga indicios de haber sido obtenido de forma irregular, el dep\xf3sito podr\xe1 ser invalidado o suspendido hasta haber efectuado las comprobaciones pertinentes.<br><br>Los dep\xf3sitos que lleve a cabo el Participante no podr\xe1n exceder las siguientes cantidades:","tableData":[{"level":1,"dailyLimit":10000000,"weeklyLimit":50000000,"monthlyLimit":150000000},{"level":2,"dailyLimit":15000000,"weeklyLimit":75000000,"monthlyLimit":225000000},{"level":3,"dailyLimit":20000000,"weeklyLimit":100000000,"monthlyLimit":300000000},{"level":4,"dailyLimit":25000000,"weeklyLimit":125000000,"monthlyLimit":375000000},{"level":5,"dailyLimit":30000000,"weeklyLimit":150000000,"monthlyLimit":450000000}],"paragraph2":"De forma autom\xe1tica al momento del registro se clasificar\xe1 en el primer orden jer\xe1rquico, en caso de querer clasificar en alguno de los otros rangos deber\xe1 cumplir con las condiciones establecidas para cada nivel.<br><br>A estos efectos, se entender\xe1 por d\xeda, los d\xedas calendario desde las 00:00 a las 23:59; por semana, el tiempo comprendido entre las 00:00 horas de lunes y las 23:59 del domingo; y por mes, el tiempo comprendido entre las 00:00 del d\xeda 1 y las 23:59 horas del \xfaltimo d\xeda del mes.<br><br>El Operador ofrece al Participante la posibilidad de establecer voluntariamente l\xedmites aplicables a sus propios dep\xf3sitos por importes inferiores a los se\xf1alados en el primer nivel, en tal caso este deber\xe1 elegir la opci\xf3n \\"otros l\xedmites\\" en la secci\xf3n \xa8Mi Cuenta\xa8 y ubicar el valor diario de l\xedmites, tanto los l\xedmites semanales c\xf3mo mensuales se calcular\xe1n autom\xe1ticamente, estos resultar\xe1n de inmediata aplicaci\xf3n.<br><br>    El incremento del valor de los l\xedmites estar\xe1 sujeto a la validaci\xf3n del operador quien emplear\xe1 mecanismos para determinar si el usuario cumple con el perfil necesario para aplicarlos y ser\xe1 facultativo el aprobar o denegar la solicitud de incremento.<br><br>En ning\xfan caso, podr\xe1 solicitarse un aumento en los l\xedmites establecidos por el Participante, si no hubiesen transcurrido tres (3) meses desde la \xfaltima modificaci\xf3n de los l\xedmites por \xe9l fijados.<br><br>Los premios obtenidos por el Participante se acumular\xe1n a las cantidades depositadas en la Cuenta de Juego, pudiendo hacer uso de los mismos. Los dep\xf3sitos y los premios podr\xe1n ser retirados por el Participante, siempre y cuando se cumplan con las directrices definidas por la normativa especial para juegos operador por internet, y las reglas de uso de la plataforma contenidas en este documento.<br><br>Acorde con lo dispuesto en la normativa especial para juegos operados por internet, las cantidades depositadas en la Cuenta de Juego, as\xed como los premios obtenidos, se mostrar\xe1n en cr\xe9ditos para la participaci\xf3n con valores equivalentes 1 a 1 respecto del Peso Colombiano (1 cr\xe9dito para la participaci\xf3n = 1 peso colombiano).<br><br>En todo caso el participante es consciente y acepta que el Operador realice los descuentos a los que haya lugar, correspondientes a los impuestos o tributos vigentes de conformidad con la legislaci\xf3n colombiana."}}]},{"title":"Derechos y obligaciones del participante","QuestionList":[{"question":"1- Derechos del Participante","answer":"<ul><li>El Participante podr\xe1 acceder y utilizar los juegos y servicios ofrecidos por el Operador, que estar\xe1n a su disposici\xf3n, durante las veinticuatro (24) horas del d\xeda, los trescientos sesenta y cinco (365) d\xedas del a\xf1o. Sin embargo, si el Operador tuviera que suspender los juegos y servicios como consecuencia de errores, demoras, mal funcionamiento o alguna otra circunstancia t\xe9cnica que imposibilite el buen uso de la P\xe1gina Web, el Participante no obtendr\xe1 ning\xfan tipo de compensaci\xf3n. En tales casos, el Operador no asumir\xe1 ning\xfan tipo de responsabilidad por cualquier eventual perjuicio que se le hubiese podido ocasionar al Participante, bien sea por la suspensi\xf3n de los juegos o por el mal funcionamiento de los mismos.</li><br><br><li>El Participante recibir\xe1 el abono de los premios que haya obtenido en su Cuenta de Juego, pudiendo disponer de ellos en cualquier momento, teniendo en cuenta que el Operador generar\xe1 la transacci\xf3n en el medio de pago que aplica.</li><br><br><li>En los casos que la cuenta de juego no cuente con ning\xfan tipo de bloqueo o suspensi\xf3n que limite el libre uso de la misma, el Participante podr\xe1 solicitar al Operador que le transfiera, por cualquiera de los medios de pago puestos a disposici\xf3n del usuario por el Operador, el saldo que figure en su Cuenta de Juego, sin costo adicional alguno y a estos efectos, el Operador deber\xe1 ordenar al medio de pago que corresponda la transferencia de fondos en un plazo m\xe1ximo de 72 horas.</li><br><br><li>El rechazo de los pagos respectivos por parte de terceras entidades no es atribuible al operador, raz\xf3n por la cual el operador no generar\xe1 compensaci\xf3n alguna, ni responder\xe1 a ning\xfan t\xedtulo por los inconvenientes que puedan llegar a presentarse en virtud de los hechos de un tercero. Para estos casos, solo se acreditar\xe1 la devoluci\xf3n del saldo en cuesti\xf3n a la cuenta de juego. El jugador es plenamente responsable de validar en el sistema transaccional dispuesto por el operador el estado de las transacciones de retiro de fondos solicitadas. El jugador es plenamente responsable que los datos del titular de la cuenta BetPlay y los datos del titular de la cuenta bancaria objeto de la solicitud de retiro coincidan a completitud, caso contrario la solicitud de retiro ser\xe1 rechazada sin que obre responsabilidad alguna por parte del operador.</li><br><br><li>El Participante podr\xe1 resolver el Contrato, sin necesidad de preaviso ni justificaci\xf3n, mediante la cancelaci\xf3n de su Registro de Usuario y su Cuenta de Juego, seg\xfan el procedimiento establecido por el operador. Si la Cuenta contuviese saldo a favor del Participante, \xe9ste deber\xe1 retirar las cantidades disponibles con car\xe1cter previo a la cancelaci\xf3n, no obstante en caso de que la cuenta de juego previo a la solicitud de resoluci\xf3n del contrato se encontrase en el supuesto de suspensi\xf3n por precauci\xf3n, el operador deber\xe1 resolver primero el motivo por el cual la cuenta ingres\xf3 en dicho estado, para poder proceder con la terminaci\xf3n del contrato.</li><br><br><li>El participante podr\xe1 actualizar sus datos personales (correo electr\xf3nico, tel\xe9fono, direcci\xf3n) registrados al momento de la creaci\xf3n de la cuenta en cualquier tiempo, por los canales dispuestos por el operador para tales fines y con una diferencia de al menos 30 d\xedas calendario desde la \xfaltima fecha de actualizaci\xf3n.</li></ul>"},{"question":"2- Obligaciones del Participante: ","answer":" <ul><li>El Participante se obliga a suministrar datos reales en el proceso de registro, o en cualquier transacci\xf3n u operaci\xf3n posterior, as\xed como a mantener actualizada la informaci\xf3n suministrada durante el tiempo que permanezca operativa su Cuenta de Juego, cualquier duda sobre la identidad del participante respecto de la cuenta de juego, generara de forma autom\xe1tica la suspensi\xf3n preventiva de la cuenta hasta que el titular de la cuenta pueda demostrar su identidad y esclarecer las circunstancias que dieron lugar a la suspensi\xf3n preventiva de la cuenta.</li><br><br><li>El Participante deber\xe1 cumplir el presente Contrato y las normas y reglamentaciones b\xe1sicas que se establezcan para cada tipo de juego, no alterando ni intentando alterar el desarrollo normal de \xe9stos. Dichas normas reglamentarias se encuentran disponibles al interior de cada juego, para apuestas deportivas en el siguiente enlace: <a href=\\"https://betplay.com.co/reglas-apuestas-deportivas\\" target=\\"_blank\\" >https://betplay.com.co/reglas-apuestas-deportivas</a>.</li><br><br><li>El Participante no podr\xe1 ceder a terceros su Registro de Usuario o Cuenta de Juego, ni permitir el uso de su cuenta por los mismos. Cualquier transacci\xf3n realizada por un tercero derivada de este uso inadecuado del usuario, no ser\xe1 oponible ni atribuible al operador.</li><br><br><li>El Participante no podr\xe1 realizar transferencias a Cuentas de Juego de otros jugadores de forma directa o por medio del mal uso de los juegos ofrecidos en la plataforma (tomando como ejemplo de manera enunciativa y no taxativa los casos de chip dumping, zero rake, etc.), cualquier evidencia de esta conducta acarrear\xe1 la suspensi\xf3n de la cuenta de juego y las medidas que el operador considere pertinentes.</li><br><br><li>El Participante garantizar\xe1 el origen l\xedcito de las cantidades depositadas y, que bajo ning\xfan concepto utilizar\xe1 los Servicios de Juego como un sistema de transferencia de dinero. As\xed mismo, se compromete a que no utilizar\xe1 los Servicios de Juego para realizar actividades ilegales, il\xedcitas o fraudulentas de cara al operador u otros usuarios, de conformidad con la legislaci\xf3n colombiana de prevenci\xf3n del lavado de activos y financiaci\xf3n al terrorismo, en caso de identificar dichas conductas o tener sospecha de la comisi\xf3n de las mismas, el operador tomar\xe1 las medidas que considere pertinentes de acuerdo a las potestades otorgadas por la ley colombiana vigente.</li><br><br><li>El Participante deber\xe1 colaborar con el Operador en cualquier comprobaci\xf3n o verificaci\xf3n que \xe9ste lleve a cabo de la identidad del Participante, el origen de los fondos utilizados o la titularidad de los medios de pago que se empleen en las transacciones.</li><br><br><li>El Participante deber\xe1 aportar cualquier documentaci\xf3n solicitada por el Operador con el fin de realizar la comprobaci\xf3n o verificaci\xf3n de su identidad, el origen de los fondos utilizados o la titularidad de los medios de pago que se empleen en las transacciones.</li><br><br><li>El Participante tiene prohibido realizar operaciones ilegales, fraudulentas o tendentes a obtener un resultado beneficioso de los juegos por medio de aprovechamiento de errores en la plataforma, de terceros participantes o por medio de actuar ilegitimo que busque o logre la eliminaci\xf3n del azar, todo lo anterior en perjuicio del Operador o de otros participantes.</li><br><br><li>A t\xedtulo meramente enunciativo, se considerar\xe1n operaciones fraudulentas las siguientes : la creaci\xf3n de cuentas duplicadas, la alteraci\xf3n de las medidas de seguridad de la web, el jineteo, el chip dumping, Zero Rake, el aporte de informaci\xf3n falsa o de terceras personas en b\xfasqueda de generar suplantaciones de identidad, el abuso de bonos y promociones, el abuso y/o uso indebido del Cash Out, el abuso de los errores generados por la plataforma en virtud de su mal funcionamiento, la utilizaci\xf3n de medios automatizados o no autorizados por el Operador para participar en los juegos, desconexiones intencionadas sin haber concluido las partidas y la connivencia con otros jugadores para obtener una ventaja injusta.</li><br><br><li>El Participante se compromete al pago de los impuestos que correspondan en funci\xf3n de los premios obtenidos.</li><br><br><li>En los supuestos en los que el Participante deba facilitar en su registro un seud\xf3nimo se obliga a no utilizar cualquier t\xe9rmino que pueda considerarse ofensivo o inmoral por los otros Participantes o que vulneren los Derechos de Propiedad Intelectual de terceros y a no utilizar en sus comunicaciones palabras y/o expresiones que puedan ser consideradas como agresiones verbales por los otros Participantes o cuyo contenido pueda ser considerado de naturaleza il\xedcita, injuriosa o calumniosa.</li><br><br><li>El contenido publicado por los participantes y/o las interacciones realizadas por los mismos en el chat dispuesto en los juegos que apliquen, es de exclusiva responsabilidad de sus autores y no representa al Operador. En consecuencia, no responde por su licitud, veracidad, integridad o titularidad, ni por da\xf1os o reclamaciones derivados (p. ej., difamaci\xf3n, infracci\xf3n de derechos, datos personales, acoso o discriminaci\xf3n). Sin obligaci\xf3n de supervisi\xf3n previa, el Operador podr\xe1 moderar, remover o bloquear contenidos y/o suspender cuentas a su criterio o por orden de autoridad. El usuario se obliga a mantener indemne al Operador por cualquier queja, investigaci\xf3n, sanci\xf3n o reclamaci\xf3n originada en lo que publique.</li><br><br><li>El participante se compromete a usar de la manera adecuada la plataforma, garantizando que al momento de realizar dep\xf3sitos debe jugar al menos el 50% del dinero depositado antes de solicitar un retiro conforme a la normativa vigente.</li><br><br><li>El participante se compromete a dar uso a la plataforma con fines de entretenimiento, evitando as\xed los usos profesionales, laborales o cualquier otro que contrari\xe9 lo establecido en las pol\xedticas de juego responsable implementadas por la compa\xf1\xeda.</li><br><br><li>El participante no podr\xe1 realizar m\xe1s de 3 retiros de manera diaria por cualquier m\xe9todo de retiro que ofrezca el operador, ni acumular retiros que superen las 48 UVT\xb4s de forma diaria en los casos de retiros en punto f\xedsico.</li><br><br><li>El participante se compromete a exhibir obligatoriamente su documento de identificaci\xf3n f\xedsico original (Cedula de Ciudadan\xeda, Cedula de Extranjer\xeda o PPT) para la realizaci\xf3n de retiros en los puntos f\xedsicos establecidos por el operador.</li><br><br><li>El participante se compromete a atender en cualquier tiempo y frecuencia los llamados a validaci\xf3n de identidad que sean realizados por el operador, lo anterior con el fin de brindar al mismo la seguridad del uso exclusivo de la cuenta conforme lo establecido en otros apartados de este documento.</li></ul>"}]},{"title":"Derechos y obligaciones del operador ","QuestionList":[{"question":"1- Derechos del Operador","answer":"<ul><li>El Operador tendr\xe1 derecho a percibir las cantidades fijadas como precio por el uso de los juegos y servicios ofrecidos en la plataforma BetPlay.</li><li>El Operador podr\xe1 modificar la estructura y formato de la P\xe1gina Web, as\xed como realizar tareas de mantenimiento y mejora de la misma para ofrecer un mejor servicio a los Participantes. En la medida de lo posible, el Operador informar\xe1 al Participante con car\xe1cter previo de dichas tareas de mantenimiento. No obstante, lo anterior, el Operador podr\xe1 suspender temporalmente los juegos o servicios sin tener que compensar de ninguna forma al Participante.</li><li>El Operador impondr\xe1 l\xedmites en el acceso a la P\xe1gina Web y tomar\xe1 las acciones pertinentes con las cuentas de juego de los Participantes cuando no se cumplan las garant\xedas de utilizaci\xf3n correcta del mismo, seg\xfan lo establecido en el marco del presente documento.</li><li>El Operador podr\xe1 denegar, en cualquier momento y sin necesidad de previo aviso, el acceso al Sitio Web de los Participantes que incumplan el Contrato o las Reglas de cada Juego.</li><li>El Operador se reserva el derecho de admisi\xf3n a su plataforma. La negativa a permitir el acceso no implicar\xe1 el pago de indemnizaciones ni resarcimiento alguno. La aplicaci\xf3n de este numeral conllevar\xe1 la cancelaci\xf3n de la cuenta, conforme a lo establecido en el presente reglamento.</li><li>El Operador podr\xe1 denegar, en cualquier momento y sin necesidad de previo aviso, el acceso al Sitio Web de los Participantes que hayan proporcionado en su registro datos presuntamente falsos.</li><li>El Participante deber\xe1 proteger los derechos del Operador, as\xed como los de terceros que presten sus Servicios de Juego o contenidos a trav\xe9s del Sitio Web.</li><li>El Operador podr\xe1 exigir las indemnizaciones que pudieran derivarse por el uso indebido o il\xedcito de todo o parte de los Servicios de Juego y contenidos prestados a trav\xe9s del Sitio Web a los Participantes.</li></ul>"},{"question":"2- Obligaciones del Operador","answer":"<ul><li>El Operador deber\xe1 poner a disposici\xf3n del Participante los juegos y servicios, en la forma establecida en este Contrato y en las reglas particulares de cada juego.</li><li>El Operador se compromete a registrar en la Cuenta de Juego, mediante cargos y abonos, todas las operaciones, incluyendo los elementos identificativos completos de las mismas y, en particular, los relativos a jugadas, ganancias, devoluciones, ingresos, reintegros o bonos recibidos.</li><li>El Operador ordenar\xe1 el abono de los premios, a la cuenta del usuario, en un plazo m\xe1ximo de 72 horas.</li><li>El Operador devolver\xe1 los saldos producto de transacciones de retiro fallidas en un plazo m\xe1ximo de 72 horas una vez sea generado el error, exceptuando las situaciones imputables a terceros, casos en los cuales los t\xe9rminos de devoluci\xf3n estar\xe1n sujetos a las soluciones generadas por los mismos.</li><li>El Operador pondr\xe1 a disposici\xf3n del Participante, a trav\xe9s de la P\xe1gina Web, un servicio de Atenci\xf3n al Cliente para la resoluci\xf3n de dudas y tramitaci\xf3n de reclamaciones, para tales fines se pone a disposici\xf3n de los usuarios 3 canales de contacto disponibles:</li><ul><li>Te llamamos: <a href=\\"https://d7cul3678ytm6.cloudfront.net/Betplay/index.html\\">https://d7cul3678ytm6.cloudfront.net/Betplay/index.html</a></li><li>Chat: <a href=\\"https://chat.betplay.com.co/\\">https://chat.betplay.com.co/</a></li><li>Escr\xedbenos: <a href=\\"https://d7cul3678ytm6.cloudfront.net/Betplay/escribenos.html\\">https://d7cul3678ytm6.cloudfront.net/Betplay/escribenos.html</a></li></ul><li>Igualmente, el Operador suministrar\xe1 informaci\xf3n sobre juego responsable en la secci\xf3n de Juego Responsable, disponible en <a href=\\"https://betplay.com.co/juego-responsable\\">https://betplay.com.co/juego-responsable</a>.</li></ul>"}]},{"title":"Autoexclusi\xf3n de acceso al juego","QuestionList":[{"answer":"El Operador pone a disposici\xf3n del Participante un sistema de autoexclusi\xf3n de participaci\xf3n en los juegos del Operador. En este sentido el Participante podr\xe1:<br><br><ul><li>Desde su cuenta BetPlay es posible generar la autoexclusi\xf3n ingresando a su usuario en la esquina superior derecha de la p\xe1gina donde aparecen 3 puntos verticales junto al nombre de jugador y acceder al bot\xf3n denominado \xa8MI CUENTA\xa8, donde podr\xe1 encontrarse el bot\xf3n denominado \xa8LIMITES DE USUARIO\xa8 donde se desplegar\xe1 una ventana en la cual aparecer\xe1 el bot\xf3n denominado \xa8AUTOEXCLUSI\xd3N\xa8, que mostrar\xe1 un men\xfa que permite seleccionar el tiempo de autoexclusi\xf3n (24 horas, 48 horas, 72 horas, 1 semana, 1 mes, 3 meses o 6 meses) y el motivo de la autoexclusi\xf3n (Salud Mental, s\xedntomas de adicci\xf3n al juego, Ludopat\xeda, Receso Voluntario, Problemas Econ\xf3micos).</li><li>El operador bloquear\xe1 el registro de usuario y cuenta de juego del participante que haya solicitado su autoexclusi\xf3n cuando reciba una petici\xf3n de autoexclusi\xf3n durante el tiempo que \xe9l mismo haya se\xf1alado. Durante el periodo de bloqueo el participante no puede acceder al juego, ni ingresar dinero o realizar dep\xf3sitos, pero s\xed puede proceder al retiro de sus fondos.</li></ul>"}]},{"title":"Sesi\xf3n destinada al juego de m\xe1quinas tragamonedas o de azar ","QuestionList":[{"answer":"Para preservar la seguridad del usuario, desde el momento del registro de la cuenta, se parametriza de forma autom\xe1tica con un l\xedmite de sesi\xf3n destinada al juego de m\xe1quinas de azar de 1 hora, el cliente podr\xe1 modificar este l\xedmite en un rango de 1 a 24 horas, as\xed como los l\xedmites que se mencionan a continuaci\xf3n:<br><br><ul><li>Tiempo de la sesi\xf3n</li><li>Cantidad m\xe1xima que quiere jugar en la sesi\xf3n</li><li>Tiempo de aviso del tiempo restante</li><li>Posibilidad de autoexclusi\xf3n temporal de la plataforma</li></ul>"}]},{"title":"Eficacia y duraci\xf3n del contrato  ","QuestionList":[{"answer":"El presente Contrato entrar\xe1 en vigor tras la aceptaci\xf3n expresa del mismo por el Participante marcando la casilla respectiva al momento del registro, y la activaci\xf3n por el Operador de la Cuenta de Juego y se mantendr\xe1 vigente hasta la cancelaci\xf3n de \xe9stos por alguna de las causas que se se\xf1alan en la cl\xe1usula siguiente.<br><br>El operador se reserva el derecho de admisi\xf3n a su plataforma. La negativa a permitir el acceso no implicar\xe1 el pago de indemnizaciones ni resarcimiento alguno. La aplicaci\xf3n de este numeral conllevar\xe1 la cancelaci\xf3n de la cuenta, conforme a lo establecido en el presente reglamento."}]},{"title":"Resoluci\xf3n del contrato. Cancelaci\xf3n y suspensi\xf3n del registro de usuario y la cuenta de juego ","QuestionList":[{"question":"1- Cancelaci\xf3n a instancia del Participante ","answer":"El Participante podr\xe1 cancelar su Registro de Usuario y Cuenta de Juego en cualquier momento, mediante mensaje dirigido al Operador aportando formato de solicitud mediante el canal \xa8ESCRIBENOS\xa8, disponible en el siguiente link: <a href=\\"https://d7cul3678ytm6.cloudfront.net/Betplay/escribenos.html\\" target=\\"_blank\\">https://d7cul3678ytm6.cloudfront.net/Betplay/escribenos.html</a>.<br><br>En todo caso, el Operador se reserva el derecho de comprobar la identidad del Participante antes de proceder al abono del saldo como consecuencia de la cancelaci\xf3n. El Operador deber\xe1 hacer efectiva la cancelaci\xf3n en un plazo m\xe1ximo de siete (7) d\xedas h\xe1biles desde la validaci\xf3n de identidad en los casos en los que hubiere lugar a criterio del operador o desde la recepci\xf3n de la solicitud en caso de no considerar necesaria la validaci\xf3n de identidad.<br><br>La solicitud de Cancelaci\xf3n de la cuenta de usuario/registro de usuario no implica la eliminaci\xf3n de datos personales de las bases de datos del operador, la solicitud de eliminaci\xf3n de datos personales que pueda presentarse por el titular de la cuenta, no afectara los datos que deban conservarse por obligaci\xf3n legal, reglamentaria y/o contractual, en virtud de la operaci\xf3n de la plataforma BetPlay."},{"question":"2- Suspensi\xf3n por parte del Operador ","answer":"El Operador se reserva el derecho a suspender el Registro de Usuario y Cuenta de Juego en los siguientes casos:<br><br><ul><li>Cuando existan sospechas razonables acerca de la falta de veracidad o exactitud de los datos facilitados por el Participante.</li><li>Cuando existan sospechas razonables de la utilizaci\xf3n del Registro de Usuario y/o de la Cuenta de Juego por parte de terceros. El operador podr\xe1 suspender cautelarmente al participante que haya tenido, a su juicio, un comportamiento presuntamente colusorio o fraudulento o que haya permitido la utilizaci\xf3n de su registro de usuario por terceros, hasta que se demuestre lo contrario sin lugar a duda razonable. Contrastados los hechos, si el operador tuviera elementos de juicio suficientes para poder considerar probado que el participante ha incurrido en un presunto fraude, colusi\xf3n o puesta a disposici\xf3n de terceros de su propia cuenta, el contrato podr\xe1 ser resuelto unilateralmente y notificado este hecho, junto con los elementos de juicio recabados, para el caso concreto se tendr\xe1n en cuenta la definici\xf3n y casu\xedstica de fraude establecidas en la ley y el presente documento.</li><li>Cuando existan sospechas razonables de que el Participante ha infringido cualquiera de las obligaciones del Contrato.</li><li>Cuando el Participante solicite su autoexclusi\xf3n, seg\xfan lo dispuesto en el presente documento.</li><li>En caso que el Participante no realice ninguna operaci\xf3n durante un periodo de seis (6) meses ininterrumpidamente.</li><li>Cuando existan sospechas razonables de que el Participante en el desarrollo de su actividad de juego en P\xf3ker ha incurrido en acciones sospechosas, que infringen las normas de juego (de forma enunciativa y no taxativa chip-dumping y zero rake), suplantaci\xf3n de identidad, traspaso de dinero de forma regular e injustificada seg\xfan las din\xe1micas normales de la operaci\xf3n del juego o cualquiera que genere la necesidad de iniciar una investigaci\xf3n que esclarezca los hechos motivo de estas acciones.</li></ul><br><br>El Operador cancelar\xe1 el Registro de Usuario y la Cuenta de Juego cuando se produzca cualquiera de las siguientes circunstancias:<br><br><ul><li>En caso de que el Participante incumpla las condiciones del presente contrato.</li><li>En caso de tener sospechas razonables o la constancia que el Participante ha llevado a cabo operaciones presuntamente fraudulentas o ilegales.</li></ul>"},{"question":"3- Consecuencias de la suspensi\xf3n  ","answer":"La suspensi\xf3n impedir\xe1 al Participante el uso de los juegos y servicios ofrecidos por el Operador de forma temporal, as\xed como depositar nuevas cantidades en la Cuenta de Juego o retirar los fondos existentes.<br><br>No obstante en los casos que el operador lo defina el Participante suspendido podr\xe1 realizar el retiro de los cr\xe9ditos para la participaci\xf3n por el medio de pago definido por el Operador."},{"question":"4- Consecuencias de la cancelaci\xf3n","answer":"La cancelaci\xf3n del Registro de Usuario y de la Cuenta de Juego impedir\xe1 al Participante continuar haciendo uso de los juegos y servicios ofrecidos por el Operador. \xc9ste deber\xe1 transferir al Participante, por el medio de pago definido por el Operador, las cantidades depositadas y no utilizadas, as\xed como los premios obtenidos.<br><br>Lo anterior, teniendo en cuenta que el operador deber\xe1 resolver previo a la cancelaci\xf3n del registro cualquier situaci\xf3n de validaci\xf3n de identidad, suspensi\xf3n y/o similares."}]},{"title":"Tratamiento de registros de usuarios y cuentas de juego inactivos y procedimiento para su activaci\xf3n en los supuestos de suspensi\xf3n","QuestionList":[{"answer":"Se considerar\xe1 inactivo el Registro de Usuario de un Participante y la Cuenta de Juego asociada al mismo cuando no se haya realizado ninguna operaci\xf3n durante seis (6) meses ininterrumpidamente, esta situaci\xf3n generar\xe1 la suspensi\xf3n de la cuenta de forma autom\xe1tica una vez cumplido dicho termino.<br><br>El Participante podr\xe1 reactivar su Registro de Usuario y Cuenta de Juego contact\xe1ndose por los canales dispuestos para la atenci\xf3n al cliente.<br><br>En todo caso, la reactivaci\xf3n deber\xe1 hacerse efectiva en un plazo m\xe1ximo de siete (7) d\xedas h\xe1biles desde la recepci\xf3n de la solicitud remitida por el Participante, siempre y cuando no existan causales de suspensi\xf3n de cuenta pendientes por resolver.<br><br>En caso de que la suspensi\xf3n por inactividad ininterrumpida alcance el termino de once (11) meses la cuenta ser\xe1 cancelada por tiempo."}]},{"title":"Derechos de propiedad intelectual e industrial","QuestionList":[{"answer":"Los distintos elementos de la P\xe1gina Web, y el sitio Web en su conjunto, est\xe1n protegidos por la normativa colombiana sobre propiedad intelectual e industrial. Las marcas, nombres comerciales, signos distintivos que aparecen en ella, as\xed como el software necesario para participar en los juegos.<br><br>Las im\xe1genes, textos, v\xeddeos y demostraciones existentes en la P\xe1gina Web son propiedad del Operador o de terceras entidades que le han cedido legalmente su uso. El Participante no podr\xe1 realizar ninguna modificaci\xf3n o alteraci\xf3n de los mismos, ni distribuirlos o utilizarlos bajo ning\xfan fin sin autorizaci\xf3n expresa del Operador."}]},{"title":"Protecci\xf3n de datos de car\xe1cter personal","QuestionList":[{"answer":"Los datos personales que hayan sido facilitados por el Participante ser\xe1n tratados conforme a lo dispuesto en la  <a href=\\"https://betplay.com.co/politica-de-privacidad\\" target=\\"_blank\\">Pol\xedtica de Privacidad</a> disponible en la P\xe1gina Web."}]},{"title":"Responsabilidad","QuestionList":[{"answer":"El Operador no garantiza la disponibilidad y continuidad de la P\xe1gina Web, reserv\xe1ndose la posibilidad de interrumpir o suspender, sin previo aviso, la oferta de cualquiera de los juegos o servicios.<br><br>El Operador no se har\xe1 responsable de los da\xf1os y perjuicios sufridos por el Participante como consecuencia del uso de los juegos y servicios, o que se deriven de fallos t\xe9cnicos que provoquen interrupciones o demoras.<br><br>As\xed mismo el participante se obliga a no incurrir en conductas de aprovechamiento del error ajeno, en aquellas circunstancias de errores/fallos en la plataforma, cuotas ofrecidas por error que en otras circunstancias el operador no hubiese ofrecido o los juegos activos en ella. El operador se reserva el derecho de tomar todas las acciones que considere pertinentes para devolver el estado de las cosas al momento previo de las fallas que pudieran llegar a presentarse.<br><br>En ning\xfan caso, el Participante podr\xe1 exigir responsabilidad al Operador en supuestos de fallos de la conexi\xf3n a Internet, incompatibilidad del equipo del Participante con el software de juego facilitado en la P\xe1gina Web, virus inform\xe1ticos distribuidos por terceros que afecten al funcionamiento de los juegos o servicios, problemas de seguridad o t\xe9cnicos derivados de un mal uso del software suministrado o de las claves de acceso del Participante, retrasos en el suministro de los juegos, o imposibilidad de utilizaci\xf3n de los juegos o servicios. Asimismo, no responder\xe1 de las anomal\xedas que tengan como origen una actuaci\xf3n dolosa o culposa del Participante y/o que se deriven por causas de Fuerza Mayor o Caso Fortuito. En ning\xfan caso, el Operador asumir\xe1 responsabilidad alguna derivada de da\xf1os directos o indirectos, ni por da\xf1o emergente ni lucro cesante.<br><br>El Operador no garantiza que el Software o los Servicios de Juego sean compatibles con los requisitos exigidos por el software de los dispositivos usados por los Participantes y no se responsabiliza de cualquier da\xf1o o perjuicio que se puedan producir en el software o hardware del Participante derivados del acceso al Sitio Web y/o del uso de los Servicios de Juego.<br><br>As\xed mismo, el Operador excluye cualquier responsabilidad que pueda producirse por la presencia de virus u otros elementos lesivos en los Servicios de Juego y/o los contenidos del Sitio Web.<br><br>El Operador no se responsabilizar\xe1 de ninguna acci\xf3n u omisi\xf3n del proveedor de Internet o de terceros a quien el Participante haya podido contratar para acceder al servidor que aloja el Sitio Web.<br><br>El Operador no garantiza la idoneidad, fiabilidad, disponibilidad, oportunidad ni exactitud de la informaci\xf3n de los Servicios de Juego y apuestas contenidos en el Sitio Web. As\xed mismo, no ser\xe1 responsable del mal funcionamiento de la red de Internet ni de los da\xf1os que puedan ocasionarse por el citado mal funcionamiento.<br><br>En caso de existir errores en el sistema de comunicaci\xf3n, bugs o virus relativos a la instalaci\xf3n de su cuenta de juego u otros elementos de los servicios de juego que resulten en la p\xe9rdida de informaci\xf3n para el participante o cualquier otro da\xf1o a su equipo o a su software, el operador se reserva el derecho de anular los juegos en cuesti\xf3n y llevar a cabo cualquier acci\xf3n para corregir dichos errores tan pronto como tenga conocimiento, no siendo responsable en cualquier caso de dichos da\xf1os, ni estando obligado a realizar ning\xfan reemplazo sobre su red y/o sistemas o servicios similares.<br><br>El Participante acuerda que, en caso de que el Software o los Servicios de Juego no funcionen correctamente como resultado de, entre otras causas, un retraso o interrupci\xf3n en la operaci\xf3n o transmisi\xf3n, cualquier p\xe9rdida o da\xf1o de informaci\xf3n o fallo en la l\xednea, cualquier fallo presentado en los juegos o plataforma atribuible a terceros tales como proveedores de servicios o juegos, cualquier abuso de una persona sobre el Sitio Web o su contenido, o cualquier error u omisi\xf3n del contenido o cualquier otro factor fuera del control del Operador, el Operador no ser\xe1 responsable por ninguna p\xe9rdida, incluyendo p\xe9rdida de ganancias, que pudieran resultar; y que, si cualquiera de tales errores resultar\xe1 en un aumento de ganancias debidas o pagadas a un Participante, \xe9ste no tendr\xe1 derecho a tales ganancias devengadas del aumento en cuesti\xf3n. El Participante deber\xe1 abonar cualquier ganancia acreditada a su cuenta por error del Operador e informar, de forma inmediata, al Operador de ese error, evitando el aprovechamiento del error ajeno, delito tipificado en la legislaci\xf3n vigente Colombiana.<br><br>El Participante ser\xe1 el \xfanico responsable de las actividades realizadas desde su Cuenta de Juego. El Operador no se compromete a la devoluci\xf3n de ninguna cantidad pagada o apostada por terceros que hayan podido utilizar las claves de acceso del Participante o hayan accedido por medios il\xedcitos a su Registro de Usuario y Cuenta de Juego. Tampoco devolver\xe1 las cantidades que corresponda pagar al Participante en caso de errores cometidos en el desarrollo de los juegos o solicitudes de juegos o servicios efectuadas por error.<br><br>Cuando un usuario genere una actualizaci\xf3n en el estado de su cuenta para aceptar o revocar la comunicaci\xf3n de parte del Operador, debe tener en cuenta que este cambio ser\xe1 efectivo en un plazo no menor a 24 horas. Esto quiere decir, que, si un usuario actualiza su estado como revocado, pero no se han completado las 24 horas desde el momento del cambio, podr\xe1 seguir recibiendo comunicaci\xf3n hasta que se haga efectiva la actualizaci\xf3n. </li> </ul>"}]},{"title":"Dudas en la interpretaci\xf3n del presente documento","QuestionList":[{"answer":"Cualquier duda que pueda presentarse en la interpretaci\xf3n del presente documento o inquietud respecto de los conceptos aplicables, se tomara la interpretaci\xf3n o conceptualizaci\xf3n del operador como correcta y aplicable al caso concreto."}]},{"title":"Legislaci\xf3n aplicable y tribunales competentes ","QuestionList":[{"answer":"El presente Contrato se rige por la ley colombiana, someti\xe9ndose las partes para la resoluci\xf3n de cualesquiera controversias y discrepancias a los juzgados y tribunales colombianos que resulten competentes."}]}]},"POKER":{"identityValidation":"La verificacion del usuario es requerida, por favor complete el proceso de validacion biometrica.","cards":[{"title":"\xbfC\xf3mo jugar p\xf3ker en BetPlay?","description":"Para jugar p\xf3ker en BetPlay, primero debes registrarte o iniciar sesi\xf3n en tu cuenta. Luego, dir\xedgete a la secci\xf3n de \\"Casino\\" y selecciona la opci\xf3n de p\xf3ker. All\xed encontrar\xe1s diferentes modalidades como Texas Hold\'em y Omaha, tanto en mesas de dinero real como en torneos. Elige una mesa seg\xfan tu nivel y presupuesto, y sigue las reglas del juego.","buttonText":"\xa1Jugar ahora!","image":"../../../assets/img/poker/hombre-poker-traje.png","inverted":false,"invertedMobile":true},{"title":"Torneos Poker","description":"En BetPlay, los torneos de p\xf3ker te permiten competir contra otros jugadores por premios atractivos. Para participar, accede a la secci\xf3n de p\xf3ker y elige un torneo seg\xfan el tipo, el costo de entrada y la estructura que m\xe1s te convenga. Hay torneos con recompra, donde puedes volver a ingresar si pierdes todas tus fichas, y otros sin recompra, en los que debes administrar bien tu stack. A medida que avanza el torneo, los jugadores son eliminados hasta que quedan los finalistas que se llevan los premios. \xa1Elige tu torneo y demuestra tu habilidad en la mesa!","buttonText":"\xa1Jugar ahora!","image":"../../../assets/img/poker/mujer-poker-card-corazon.png","inverted":true,"invertedMobile":false},{"title":"Mesas Poker","description":"En BetPlay, las mesas de p\xf3ker est\xe1n dise\xf1adas para ofrecer una experiencia din\xe1mica y competitiva. Puedes elegir entre mesas de dinero real o torneos, dependiendo de tu estilo de juego y presupuesto.","buttonText":"\xa1Jugar ahora!","image":"../../../assets/img/poker/mujer-poker-lentes.png","image2":"../../../assets/img/poker/hombre-poker-gorro.png","inverted":false,"invertedMobile":false}],"pokerCards":[{"title":"Texas Holdem","description":"Cada jugador recibe dos cartas privadas y debe combinarlas con cinco cartas comunitarias que se revelan en la mesa en tres rondas: flop (tres cartas), turn (una carta) y river (una carta). Durante cada ronda de apuestas, puedes retirarte, igualar o subir la apuesta seg\xfan tu estrategia y la fuerza de tu mano.","imageUrl":"../../../assets/img/poker/Carta  1.png","backgroundColor":"#92E1A3"},{"title":"Omaha","description":"Cada jugador recibe cuatro cartas privadas en lugar de dos. Sin embargo, al formar su mano final, debe usar exactamente dos de sus cartas privadas junto con tres de las cinco cartas comunitarias que se revelan en la mesa en las rondas de flop, turn y river.","imageUrl":"../../../assets/img/poker/Fichas 1.png","backgroundColor":"#64E1DA"}],"imageVideoSlides":[{"type":"image","imageUrl":"../../../assets/img/poker/hombre-poker-traje.png"},{"type":"video","imageUrl":"../../../assets/img/poker/hombre-poker-traje.png","videoUrl":"https://www.youtube.com/watch?v=2g8v1j0x4aA"},{"type":"image","imageUrl":"../../../assets/img/poker/hombre-poker-traje.png"}]},"BINGO":{"cards":[{"title":"\xbfC\xf3mo jugar Bingo en BetPlay?","description":"Para jugar Bingo en BetPlay, solo debes registrarte o iniciar sesi\xf3n en tu cuenta, ir a la secci\xf3n de \u201cCasino\u201d y seleccionar la opci\xf3n de Bingo. All\xed podr\xe1s elegir entre 10 salas diferentes, con modalidades de 75 o 90 balotas, seg\xfan tu preferencia.  \xa1Una forma r\xe1pida y divertida de cantar Bingo y ganar en grande!","buttonText":"\xa1Jugar ahora!","image":"../../../assets/img/bingo/comojugarbingo.png","inverted":false,"invertedMobile":false},{"title":"\xa1Canta Bingo!","description":"Si eliges Bingo 75, podr\xe1s ganar completando la figura predeterminada anunciada antes de cada partida. Por otro lado, en Bingo 90 tienes tres formas de llevarte el premio: al completar la primera l\xednea, la segunda l\xednea o el cart\xf3n lleno. Adem\xe1s, si logras llenar tu cart\xf3n antes de que salga la balota clave, puedes ganar el gran acumulado de la sala. As\xed que prep\xe1rate para jugar, divertirte y ganar.","buttonText":"\xa1Jugar ahora!","image":"../../../assets/img/bingo/CantaBingo.png","inverted":true,"invertedMobile":false}]},"cookiesData":{"QuestionList":[{"title":"Introducci\xf3n","QuestionList":[{"answer":"La presente Pol\xedtica de Cookies tiene como objetivo informar a los usuarios sobre el uso de cookies en el sitio web <a href=\\"https://betplay.com.co/\\" target=\\"_blank\\">https://betplay.com.co/</a> y su responsable CORREDOR EMPRESARIAL S.A., identificada con Nit. 900.243.000 \u2013 8 y con domicilio en Avenida Calle 26 No. 69D-91. En este contexto, tratamos los datos personales recolectados a trav\xe9s de cookies conforme a lo dispuesto en la Ley 1581 de 2012, el Decreto 1074 de 2015 y las directrices emitidas por la Superintendencia de Industria y Comercio de Colombia. Nuestro objetivo es mejorar la experiencia de navegaci\xf3n y ofrecer un servicio m\xe1s personalizado, respetando la privacidad de nuestros usuarios. <br /><br /> En BetPlay, como plataforma operada por CORREDOR EMPRESARIAL S.A., utilizamos cookies conforme al r\xe9gimen de protecci\xf3n de datos personales vigente en Colombia. Somos conscientes de que algunas cookies pueden recolectar informaci\xf3n que permite identificar al usuario, como la direcci\xf3n IP, los h\xe1bitos de navegaci\xf3n y las preferencias. <br /><br /> Nuestro compromiso es garantizar una experiencia de navegaci\xf3n segura y transparente, alineada con los principios de legalidad, finalidad, libertad, seguridad y confidencialidad. <br /><br /> En cumplimiento del principio de responsabilidad demostrada, CORREDOR EMPRESARIAL S.A. ha implementado medidas t\xe9cnicas, organizacionales y jur\xeddicas orientadas a proteger la privacidad de los titulares de los datos personales. <br /><br /> El titular de los datos podr\xe1 revocar en cualquier momento su consentimiento para el uso de cookies, mediante su desactivaci\xf3n o eliminaci\xf3n a trav\xe9s de las opciones de configuraci\xf3n de privacidad o seguridad del navegador. Esta revocatoria no afectar\xe1 el uso de cookies esenciales, que son indispensables para el correcto funcionamiento del Sitio Web. Es importante tener en cuenta que, por defecto, los navegadores \xfanicamente permiten configurar el bloqueo de cookies de terceros, anal\xedticas, estad\xedsticas o de publicidad. Asimismo, si el usuario opta por rechazar o limitar el uso de determinadas cookies, algunas funcionalidades del sitio podr\xedan verse restringidas o, en algunos casos, el Sitio Web podr\xeda no estar disponible o no operar correctamente."}]},{"title":"Alcance","QuestionList":[{"answer":"Esta Pol\xedtica de Cookies es aplicable a todos los usuarios que accedan, naveguen o utilicen los servicios proporcionados a trav\xe9s del sitio web <a href=\\"https://betplay.com.co/\\">https://betplay.com.co/</a> y sus plataformas vinculadas (en adelante, el \\"Sitio Web\\"). La pol\xedtica se extiende a la recopilaci\xf3n, el uso, el almacenamiento y la gesti\xf3n de cookies en el Sitio Web, tanto para usuarios registrados como no registrados.  <br /><br /> Esta Pol\xedtica de Cookies tambi\xe9n forma parte integral del Aviso de Privacidad y de la Pol\xedtica de Protecci\xf3n de Datos Personales publicada <a href=\\"https://apicms.betplay.com.co/pdf/1774379408305POLITICA_DATOSP.pdf\\" >aqui</a > . Adicionalmente, en este documento encontrar\xe1s informaci\xf3n detallada sobre el tipo de cookies utilizadas, su nomenclatura, la informaci\xf3n que se recolecta, las finalidades de su uso, as\xed como las opciones disponibles para su gesti\xf3n. <br /><br /> El alcance de esta pol\xedtica incluye: <br /><br /> <ol> <li> Usuarios del Sitio Web: Se aplica a todos los visitantes y usuarios que interact\xfaan con el Sitio Web, ya sea que se registren o simplemente naveguen por \xe9l. </li> <br /><br /> <li> Servicios Digitales de la Empresa: La pol\xedtica cubre todas las p\xe1ginas del sitio web, las aplicaciones asociadas y cualquier plataforma vinculada que se utilice para ofrecer productos o servicios a los usuarios. </li> <br /><br /> <li> Tipos de Cookies: Esta pol\xedtica aborda el uso de cookies propias y de terceros que facilitan funcionalidades, personalizaci\xf3n de contenidos, an\xe1lisis de navegaci\xf3n y publicidad. </li> <br /><br /> <li> Derechos del Usuario: Se detalla el control que los usuarios tienen sobre el uso de cookies, incluyendo la capacidad de gestionarlas o desactivarlas a trav\xe9s de los ajustes del navegador o mediante el consentimiento expl\xedcito proporcionado en el banner de cookies. </li> <br /><br /> <li>Cumplimiento Normativo: La pol\xedtica se ajusta a la legislaci\xf3n vigente sobre protecci\xf3n de datos personales, como la Ley 1581 de 2012 en Colombia, el Reglamento General de Protecci\xf3n de Datos (RGPD) de la Uni\xf3n Europea, y otras normativas aplicables. </li> </ol> <br /><br /> <p> Este documento est\xe1 dirigido tanto a los usuarios que aceptan el uso de cookies como a aquellos que desean conocer m\xe1s sobre c\xf3mo las cookies afectan su experiencia en este Sitio Web. </p>"}]},{"title":"\xbfQue es una cookie?","QuestionList":[{"answer":"Las cookies son peque\xf1os archivos de texto que se almacenan en el dispositivo del usuario (ordenador, tel\xe9fono m\xf3vil, tableta, etc.), al acceder a un sitio web. Su finalidad es recopilar informaci\xf3n sobre las preferencias de navegaci\xf3n, el comportamiento del usuario y facilitar la interacci\xf3n con el sitio web. Las cookies son fundamentales para el funcionamiento adecuado de internet, mejorando la funcionalidad y la experiencia del usuario. <br /> <br /> Las cookies son esenciales para el funcionamiento de Internet, ya que permiten ofrecer funcionalidades t\xe9cnicas b\xe1sicas. No pueden da\xf1ar el equipo o dispositivo del usuario, y si est\xe1n habilitadas en la configuraci\xf3n del navegador, pueden ayudar a identificar y corregir errores de funcionamiento del Sitio Web. <br />"},{"question":"1- Tipos de Cookies ","answer":"<ul> <li> El sitio web de CORREDOR EMPRESARIAL S.A. informa a sus usuarios que emplea diferentes tipos de cookies con finalidades diversas. A continuaci\xf3n, se describen las principales categor\xedas de cookies, con el prop\xf3sito de garantizar la transparencia respecto a su funcionamiento y finalidad: </li> <br /><br /> <li> Tipos de cookie; Funcionamiento del sitio web (Funcionalidad), esenciales, estad\xedstica y/o anal\xedtica, publicidad / marketing, redes sociales / de terceros </li> <br /><br /> <li> Funcionamiento del sitio web (Funcionalidad) : Las cookies de funcionalidad ayudan a hacer una p\xe1gina web utilizable activando funciones b\xe1sicas como la navegaci\xf3n en la p\xe1gina y el acceso a \xe1reas seguras de la p\xe1gina web. La p\xe1gina web no puede funcionar adecuadamente sin estas cookies. </li> <br /><br /> <li> Esenciales: Las cookies esenciales son necesarias para el funcionamiento b\xe1sico del sitio web, como la navegaci\xf3n en las p\xe1ginas y el acceso a \xe1reas seguras. No se pueden desactivar sin comprometer el funcionamiento del sitio. </li> <br /><br /> <li> Estad\xedstica y/o Anal\xedtica: Las cookies estad\xedsticas ayudan a los propietarios de p\xe1ginas web a comprender c\xf3mo interact\xfaan los visitantes con las p\xe1ginas web reuniendo y proporcionando informaci\xf3n de forma an\xf3nima. </li> <br /><br /> <li> Las cookies de marketing se utilizan para rastrear a los visitantes en las p\xe1ginas web. La intenci\xf3n es mostrar anuncios relevantes y atractivos para el usuario individual, y, por lo tanto, m\xe1s valiosos para los editores y terceros anunciantes. </li> <br /><br /> <li> Redes Sociales / De Terceros: Las cookies de terceros permiten a la p\xe1gina web recordar informaci\xf3n que cambia la forma en que la p\xe1gina se comporta o el aspecto que tiene, como su idioma preferido o la regi\xf3n en la que usted se encuentra. </li> </ul>"},{"question":"2- Finalidad de las Cookies:","answer":"Las cookies tienen la finalidad de mejorar la funcionalidad del sitio web y personalizar la experiencia del usuario. Entre las principales finalidades de uso se encuentran: <br /> <br /> <dd></dd> <ul> <li> Autenticaci\xf3n de Usuario: Las cookies permiten a los usuarios mantenerse conectados en su cuenta, evitando tener que iniciar sesi\xf3n repetidamente. </li> <br /> <li> An\xe1lisis del Comportamiento del Usuario: Las cookies de an\xe1lisis permiten a la Corredor Empresarial entender c\xf3mo los usuarios navegan por el sitio web, lo que ayuda a mejorar el contenido y la disposici\xf3n del sitio. </li> <br /> <li> Publicidad Personalizada: Las cookies de marketing permiten mostrar anuncios espec\xedficos seg\xfan los intereses y el comportamiento de navegaci\xf3n de los usuarios. </li> </ul>"}]},{"title":"An\xe1lisis sitio web","QuestionList":[{"answer":"BetPlay utiliza cookies de funcionalidad, esenciales, anal\xedtica, estad\xedstica, publicidad y marketing, con el fin de personalizar los contenidos, facilitar el uso del Sitio Web, realizar an\xe1lisis estad\xedsticos del comportamiento de navegaci\xf3n y, en algunos casos, mostrar publicidad relacionada con los intereses del usuario. </br>"},{"question":"1- Generalidad","answer":"<ul><li>Para generar el reporte con la cantidad de cookies que se usa en la p\xe1gina web de BetPlay, se realiz\xf3 un escaneo al sitio web con dominio: https://betplay.com.co/ y este fue el resultado. </li></ul>"},{"question":"2- Resumen ","answer":"Tipo de cookies: <br /> <ul> <li> Funcionamiento del sitio web (Funcionalidad): 12 clases cetabid <br /> <ul> <li>cetabid</li> <li>kk_leadtag</li> <li>ce_fvd</li> <li>lastExternalReferrerTime</li> <li>algoliasearch-client-js </li> <li>_uetvid_exp</li> <li>kk_leadtag</li> <li>lastExternalReferrer</li> <li>_uetsid_exp </li> <li>_uetvid </li> <li>ce_successful_csp_check</li> <li>_uetsid</li> </ul> </li> <br /> <li> Esenciales : 1 clase <ul> <li>PHPSESSID</li> </ul> </li> <br /> <li> Estad\xedstica y/o Anal\xedtica: 3 clases <ul> <li>_gid</li> <li>_ga_3T4T7B9R59</li> <li>_ga</li> </ul> </li> <br /> <li> Redes Sociales / De Terceros: 1 clase <ul> <li>_gat_gtag_UA_20375582_1 </li> </ul> </li> <br /> <li>Publicidad / Marketing: N/A</li> </ul>"},{"question":"3- Uso de tecnolog\xedas de seguimiento y an\xe1lisis","answer":"Tipo de cookies: <br /> <br /> <ul> <li> Funcionamiento del sitio web (Funcionalidad): 12 clases <br /> <br /> <ul> <li> <b>cetabid / Duraci\xf3n: sesi\xf3n</b> <ul> <li> Se utiliza para mantener la sesi\xf3n activa en el sitio web durante la navegaci\xf3n, garantizando una experiencia consistente </li> </ul> </li> <br /> <li> <b>kk_leadtag  / Duraci\xf3n: Persistente</b> <ul> <li> Almacena informaci\xf3n esencial sobre las interacciones del usuario con el sitio, como las campa\xf1as de marketing en las que participa el usuario. </li> </ul> </li> <br /> <li> <b> ce_fvd / Duraci\xf3n: Persistente </b> <ul> <li> Facilita el seguimiento de eventos en el sitio web, asegurando el acceso continuo a funcionalidades importantes. </li> </ul> </li> <br /> <li> <b>lastExternalReferrerTime / Duraci\xf3n: Persistente</b> <ul> <li> Almacena la hora de la \xfaltima referencia externa del usuario al sitio, lo que ayuda a gestionar el tr\xe1fico y las fuentes de acceso. </li> </ul> </li> <br /> <li> <b> algoliasearch-client-js / Duraci\xf3n: Persistente </b> <ul> <li> Utilizada para habilitar la b\xfasqueda eficiente dentro del sitio mediante la tecnolog\xeda de Algolia. </li> </ul> </li> <br /> <li> <b> _uetvid_exp / Duraci\xf3n: Persistente </b> <ul> <li> Establece el tiempo de expiraci\xf3n de la cookie _uetvid, que se utiliza para hacer un seguimiento de las sesiones de los usuarios en el sistema de Microsoft Bing Ads. </li> </ul> </li> <br /> <li> <b> kk_leadtag / Duraci\xf3n: sesi\xf3n </b> <ul> <li> Cookie de sesi\xf3n que almacena datos relacionados con la interacci\xf3n del usuario durante la visita al sitio web. </li> </ul> </li> <br /> <li> <b> lastExternalReferrer / Duraci\xf3n: Persistente </b> <ul> <li> Esta cookie almacena la URL de la p\xe1gina externa que el usuario visit\xf3 antes de acceder al sitio, ayudando a rastrear el origen del tr\xe1fico. </li> </ul> </li> <br /> <li> <b> _uetsid_exp / Duraci\xf3n: Persistente </b> <ul> <li> Usada para mantener el estado de la sesi\xf3n en Bing Ads, ayudando a gestionar la expiraci\xf3n de las sesiones de seguimiento. </li> </ul> </li> <br /> <li> <b> _uetvid / Duraci\xf3n: Persistente </b> <ul> <li> Asigna un identificador \xfanico a cada visitante del sitio web, lo que facilita el seguimiento de la actividad durante la sesi\xf3n. </li> </ul> </li> <br /> <li> <b> ce_successful_csp_check / Duraci\xf3n: Persistente </b> <ul> <li> Se utiliza para verificar que la pol\xedtica de seguridad de contenido (CSP) del sitio web se haya implementado correctamente, protegiendo el sitio de amenazas de seguridad. </li> </ul> </li> <br /> <li> <b> _uetsid / Duraci\xf3n: Persistente </b> <ul> <li> Cookie de Microsoft Bing Ads utilizada para identificar de manera \xfanica a un usuario y recopilar datos de su actividad para an\xe1lisis y campa\xf1as publicitarias. </li> </ul> </li> </ul> </li> <br /> <li> Escenciales: 1 Clase <br /> <br /> <ul> <li> <b>__cf_bm  / Duraci\xf3n: 30 minutos</b> <ul> <li> Esta cookie se utiliza para distinguir entre humanos y bots. Es beneficiosa para el sitio web, ya que permite generar informes v\xe1lidos sobre el uso del sitio. </li> </ul> </li> </ul> </li> <br /> <li> Estad\xedstica y/o Anal\xedtica: 3 clases <br /> <br /> <ul> <li> <b> _gid   / Duraci\xf3n: 1 d\xeda </b> <ul> <li> Esta cookie es establecida por Google Analytics. Almacena y actualiza un valor \xfanico para cada p\xe1gina visitada y se usa para contar y rastrear vistas de p\xe1gina. </li> </ul> </li> <br /> <li> <b>_ga_3T4T7B9R59  / Duraci\xf3n: 1 a\xf1o y 1 mes</b> <ul> <li> Esta cookie se usa para mantener el estado de la sesi\xf3n en Google Analytics. </li> </ul> </li> <br /> <li> <b>_ga  / Duraci\xf3n: 1 a\xf1o y 1 mes</b> <ul> <li> Asociada con Google Universal Analytics, se usa para distinguir usuarios \xfanicos mediante un n\xfamero generado aleatoriamente. Ayuda a calcular datos sobre visitantes, sesiones y campa\xf1as. </li> </ul> </li> </ul> </li> <br /> <li> Publicidad / Marketing: 1 Clase <br /> <br /> <ul> <li> <b> _gat_gtag_UA_20375582_1   / Duraci\xf3n: 52 segundos </b> <ul> <li> Esta cookie es parte de Google Analytics y se utiliza para limitar las solicitudes (tasa de solicitud de limitaci\xf3n). </li> </ul> </li> </ul> </li> </ul> <br /> <p> Si un usuario no quiere que su informaci\xf3n personal sea recogida a trav\xe9s de Cookies, puede cambiar las preferencias en su propio navegador web. No obstante, es importante se\xf1alar que, si un navegador web no acepta Cookies, algunas de las funcionalidades de la p\xe1gina web, la aplicaci\xf3n y/o las p\xe1ginas vinculadas (Landing Page) podr\xedan no estar disponibles o no funcionar correctamente. </p> <br /> <p> Puede permitir, bloquear o eliminar las cookies instaladas en su dispositivo mediante la configuraci\xf3n de las opciones del navegador instalado en su dispositivo, as\xed: </p> <ul> <li> Chrome: <a href=\\"https://support.google.com/accounts/answer/61416?co=GENIE.Platform%3DDesktop&hl=es\\" >https://support.google.com/accounts/answer/61416?co=GENIE.Platform%3DDesktop&hl=es</a > </li> <li> Microsoft Edge: <a href=\\"https://support.microsoft.com/es-es/microsoft-edge/permitir-temporalmente-las-cookies-y-los-datos-del-sitio-en-microsoft-edge-597f04f2-c0ce-f08c-7c2b-541086362bd2\\" >https://support.microsoft.com/es-es/microsoft-edge/permitir-temporalmente-las-cookies-y-los-datos-del-sitio-en-microsoft-edge-597f04f2-c0ce-f08c-7c2b-541086362bd2</a > </li> <li> Firefox: <a href=\\"https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-sitios-web-rastrear-preferencias \\" >https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-sitios-web-rastrear-preferencias </a > </li> <li> Safari: <a href=\\"https://support.apple.com/es-es/HT201265 \\" >https://support.apple.com/es-es/HT201265 </a > </li> </ul>"}]},{"title":"Informaci\xf3n recopilada por las cookies","QuestionList":[{"answer":"<p> La informaci\xf3n recopilada por las cookies incluye, pero no se limita a: </p> <br> <br> <ul> <li> Direcci\xf3n IP del usuario. </li> <li> Informaci\xf3n sobre el dispositivo y navegador utilizado. </li> <li> P\xe1ginas visitadas en el sitio web. </li> <li> Tiempo de permanencia en cada p\xe1gina. </li> <li> Preferencias de idioma y regi\xf3n. </li> <br> <li> Preferencias de idioma y regi\xf3n. </li> </ul> <br> <p> CORREDOR EMPRESARIAL S.A. se compromete a no utilizar esta informaci\xf3n para fines distintos a los descritos en esta pol\xedtica y en cumplimiento de la legislaci\xf3n sobre protecci\xf3n de datos personales. </p>"}]},{"title":"Seguridad de la informaci\xf3n recopilada","QuestionList":[{"answer":"CORREDOR EMPRESARIAL S.A. implementa medidas t\xe9cnicas, organizativas y jur\xeddicas para proteger la informaci\xf3n recopilada a trav\xe9s de las cookies. Se adoptan pr\xe1cticas de seguridad para evitar el acceso no autorizado, la alteraci\xf3n o la divulgaci\xf3n de los datos personales almacenados. "}]},{"title":"Canales de atenci\xf3n y \xe1rea responsable","QuestionList":[{"answer":"<p> La Gerencia de Cumplimiento de CORREDOR EMPRESARIAL S.A. es el \xe1rea responsable para atender y resolver las consultas y reclamos de titulares de datos personales o personas legitimadas para ello. Los titulares podr\xe1n presentar sus PQRS a trav\xe9s de los siguientes canales: </p> <br /> <ul> <li> V\xeda electr\xf3nica a la direcci\xf3n de correo protecciondedatos&#64;cempresarial.co . </li> <li> V\xeda f\xedsica en el punto de radicaci\xf3n de documentos ubicado en la direcci\xf3n Av. Calle 26 No. 69D-91, Centro Empresarial Arrecife, Torre Peatonal 2, Of. 802 de la ciudad de Bogot\xe1 - Colombia. </li> </ul>"}]},{"title":"Modificaciones a la pol\xedtica de cookies","QuestionList":[{"answer":"CORREDOR EMPRESARIAL S.A. se reserva el derecho de modificar esta Pol\xedtica de Cookies en cualquier momento. Cualquier cambio en esta pol\xedtica ser\xe1 comunicado a los usuarios a trav\xe9s del sitio web o mediante los canales de comunicaci\xf3n adecuados. "}]}]},"siplaftpadmData":{"QuestionList":[{"title":"Objetivo","QuestionList":[{"answer":"Corredor Empresarial S.A. busca prevenir y controlar que a trave\u0301s de sus productos y servicios, canales y/o contrapartes no sea utilizada directa o indirectamente como instrumento para el lavado de activos, la financiacio\u0301n al terrorismo y la financiacio\u0301n de la proliferacio\u0301n de armas de destruccio\u0301n masiva (LA/FT/FPADM), esto mediante un sistema de prevencio\u0301n denominado \u201cSIPLAFTFPADM Basado en Riesgos\u201d que consta de una serie de elementos que se han disen\u0303ado e implementado de forma sistema\u0301tica y de los cuales todos los directivos (asociados, miembros de junta directiva) y empleados de la compan\u0303i\u0301a hacen parte.<br><br>A nivel de prevenci\xf3n hacen parte los siguientes elementos:<br><br><ul><li>Pol\xedticas, procedimientos, formatos</li><li>Infraestructura tecnol\xf3gicas</li><li>Mecanismos e instrumentos de control</li><li>Estructura organizacional</li><li>Registros y soportes</li><li>Capacitaciones y divulgaci\xf3n de informaci\xf3n</li><li>Sanciones por incumplimiento</li></ul>A nivel de control se tienen mecanismos para identificar riesgos, detectar operaciones inusuales, tales como:<br><br><ul><li>Clasificaci\xf3n y valoraci\xf3n de factores de riesgo</li><li>Identificaci\xf3n y valoraci\xf3n de riesgos</li><li>Consolidaci\xf3n electr\xf3nica de operaciones</li><li>Se\xf1ales de alerta</li><li>An\xe1lisis y reportes de operaciones inusuales, sospechosas</li></ul>Es obligatorio adherirse a esta Poli\u0301tica; las violaciones pueden resultar en una accio\u0301n disciplinaria.<br><br>Esta Poli\u0301tica puede compartirse con posibles proveedores, socios externos, e incorporarse a cualquier relacio\u0301n contractual resultante."}]},{"title":"Alcance","QuestionList":[{"answer":"El SIPLAFTFPADM Basado en Riesgos en Corredor Empresarial S.A., se aplica a todas las actividades que se realizan en desarrollo de su objeto social; las etapas, elementos e instrumentos de prevencio\u0301n y control se utilizan en cada producto o servicio, asi\u0301 como tambie\u0301n a todas las contrapartes con las que Corredor Empresarial S.A., tenga relacio\u0301n."}]},{"title":"Modelo organizacional","QuestionList":[{"answer":"Con el fin de promover un adecuado funcionamiento del SIPLAFTFPADM Basado en Riesgos en Corredor Empresarial S.A., se ha definido un modelo organizacional acorde con las exigencias, en el cual se incorpora a los o\u0301rganos de direccio\u0301n, o\u0301rganos de administracio\u0301n y o\u0301rganos de control.<br><br>Todos desde sus roles y funciones deben propender para que el SIPLAFTFPADM Basado en Riesgos cumpla con el objetivo de evitar que Corredor Empresarial S.A. se vea involucrada en actividades ili\u0301citas. Algunas de ellas son:<br><br><ul><li>Accionistas: evitar realizar acciones que puedan afectar a la empresa en materia de riesgos LAFTFPADM y facilitar la informacio\u0301n y documentacio\u0301n necesaria para verificar a los beneficiarios finales de acuerdo con lo estipulado en el SIPLAFTFPADM Basado en Riesgos en la compan\u0303i\u0301a.</li><br><li>Junta Directiva: asignar los recursos (humanos, tecnolo\u0301gicos, te\u0301cnicos, etc.) necesarios para la efectiva implementacio\u0301n y mantenimiento del SIPLAFTFPADM Basado en Riesgos y analizar situaciones especiales para la correcta toma de decisiones acordes a las poli\u0301ticas previamente definidas.</li><li>Representante Legal: brindar apoyo constante, oportuno y efectivo al Oficial de Cumplimiento en las decisiones que se tomen para evitar la materializacio\u0301n de los riesgos LAFTFPADM y promover la mejora continua del sistema.</li><br><li>Oficial de Cumplimiento: liderar y velar por el efectivo y oportuno funcionamiento de las etapas que conforman el SIPLAFTFPADM Basado en Riesgos.</li><li>Auditori\u0301a Interna: evaluar el cumplimiento y efectividad del SIPLAFTFPADM Basado en Riesgos de manera independiente para identificar oportunidades de mejora del sistema.</li><br><li>Revisori\u0301a Fiscal: evaluar el cumplimiento del SIPLAFTFPADM Basado en Riesgos conforme a los requisitos emitidos por Coljuegos y dema\u0301s regulaciones que le apliquen informando anualmente a la Junta Directiva los resultados de la gestio\u0301n del sistema y reportando operaciones sospechosas a los o\u0301rganos reguladores en caso de que aplique.</li><br><li>Empleados: cumplir con las poli\u0301ticas definidas en el Manual SIPLAFTFPADM Basado en Riesgos y el Co\u0301digo de E\u0301tica y Conducta, anteponiendo los principios e\u0301ticos al logro de las metas comerciales y profesionales.</li><br><li>Proveedores: cumplir con la normatividad nacional e internacional en materia de prevencio\u0301n LAFTFPADM acatando las solicitudes realizadas por la compan\u0303i\u0301a para realizar las debidas diligencias y asi\u0301 evitar riesgos de contagio, de reputacio\u0301n, legales y financieros que puedan llegar a afectar a Corredor Empresarial S.A.</li></ul>"}]},{"title":"Pol\xedtica de SIPLAFTFPADM basada en riesgos","QuestionList":[{"answer":"La Junta Directiva de Corredor Empresarial S.A ha definido una serie de poli\u0301ticas que impulsan a mantener una cultura de prevencio\u0301n y deteccio\u0301n de riesgos LA/FT/FPADM, con el fin de prevenir que Corredor Empresarial S.A. se vea involucrado en actividades ili\u0301citas. Estas poli\u0301ticas son:<br><br><ol><li>Corredor Empresarial S.A. promueve y trabaja constantemente entre sus empleados y accionistas por una cultura contra los delitos asociados al LA/FT/FPADM, esto mediante campan\u0303as de capacitacio\u0301n y sensibilizacio\u0301n al interior de la compan\u0303i\u0301a, las cuales son evaluadas.</li><br><li>Es deber de los Representantes Legales (principal y suplente), Miembros de la Junta Directiva, Accionistas y Empleados asegurar el cumplimiento de los reglamentos internos y dema\u0301s disposiciones relacionadas en el Manual SIPLAFTFPADM Basado en Riesgos y en el Co\u0301digo de E\u0301tica y Conducta anteponiendo los principios e\u0301ticos y morales antes que el logro de rentabilidades y metas comerciales.</li><br><li>La aplicabilidad del SIPLAFTFPADM Basado en Riesgos se realiza a todos los productos y servicios de Corredor Empresarial S.A., asi\u0301 como tambie\u0301n, para la vinculacio\u0301n de las diferentes contrapartes (accionistas, proveedores, colaboradores, comercializadores, empleados, miembros de Junta Directiva). Algunos colaboradores por tener, adema\u0301s, la calidad de accionistas, estara\u0301n incluidos en las medidas de control que se disen\u0303en para los accionistas.</li><br><li>No se llevara\u0301n a cabo operaciones, actividades, negocios y contratos sin que exista el respectivo soporte interno o externo de acuerdo con lo establecido en los procedimientos de Corredor Empresarial S.A.</li><br><li>No establecer ninguna relacio\u0301n de negocios o de cualquier otro tipo, con personas naturales o juri\u0301dicas cuando se presentan dudas fundadas sobre vinculaciones con LA/FT/FPADM y la consecuente legalidad de operaciones, licitud u origen de sus recursos.</li><br><li>Corredor Empresarial S.A. sera\u0301 auto\u0301nomo en la toma de decisiones de vinculacio\u0301n, exclusio\u0301n, rechazo o desvinculacio\u0301n de accionistas, proveedores, colaboradores, empleados, jugadores de BetPlay, Ganadores de Premios de SUPER astro, de acuerdo con el resultado del ana\u0301lisis de riesgos.</li><br><li>Ningu\u0301n aspirante a ser accionista, miembro de Junta Directiva, Gerente General, Representante Legal, Revisor Fiscal, empleado, podra\u0301 estar vinculado en temas de actividades ili\u0301citas ni en listas vinculantes para Colombia (ONU, Unio\u0301n Europea, Listas de Terroristas de los EEUU y de la Unio\u0301n Europea) y listas restrictivas como la OFAC.</li><br><li>Dentro del ana\u0301lisis de riesgo que se realiza a los nuevos proyectos, productos y servicios de Corredor Empresarial S.A. se deben tener en cuenta las medidas para prevenir los riesgos LA/FT/FPADM que pueda llegar a tener.</li><br><li>Se encuentran excluidas de cualquier tipo de negociacio\u0301n con las contrapartes (proveedores, comercializadores, colaboradores, clientes, empleados, accionistas) las monedas virtuales de conformidad con la normativa vigente y disposiciones propias de la Superfinanciera de Colombia a que haya lugar.</li><br><li>Los riesgos residuales, es decir, los riesgos que han sido intervenidos por las acciones de mitigacio\u0301n podra\u0301n estar u\u0301nicamente en los niveles de severidad bajos y moderados, tal como lo determina la Junta Directiva; en los casos que se encuentren por fuera de estos niveles (altos, extremos) debera\u0301n ser reportados inmediatamente a la Gerencia General y a la Junta Directiva con el fin de buscar o tomar decisiones de tratamiento de riesgos.</li><br><li>Corredor Empresarial S.A. valorara\u0301 el riesgo pai\u0301s, para los casos en que se presente un vinculo comercial, societario con entidades que se encuentren en jurisdicciones de alto riesgo, lista negra, lista gris definidas por el GAFI y del resultado de los i\u0301ndices y rankings de percepcio\u0301n sobre corrupcio\u0301n.</li><br><li>Cualquier excepcio\u0301n a las poli\u0301ticas debera\u0301 tener el visto bueno de la Gerencia General y/o aprobacio\u0301n de la Junta Directiva segu\u0301n el grado de importancia que tenga.</li><br><li>En el caso en que se determine que una operacio\u0301n tiene las caracteri\u0301sticas para ser catalogada como intentada, inusual o sospechosa, se debera\u0301 reportar a la UIAF en el reporte de operaciones sospechosas por el Oficial de Cumplimiento.</li><br><li>Corredor Empresarial S.A. entregara\u0301 total apoyo y colaboracio\u0301n con los O\u0301rganos de Control y las autoridades a fin de suministrarles, de acuerdo con las formalidades legales, la informacio\u0301n que requieren para el buen e\u0301xito de sus investigaciones.</li><br></ol>"}]},{"title":"Control de informaci\xf3n documentada","QuestionList":[{"answer":"Ver Listado Maestro de Informacio\u0301n Documentada."}]},{"title":"Historial de cambios","QuestionList":[{"answer":"* La naturaleza de los cambios de los documentos son los siguientes:<br><br><ol><li>Creacio\u0301n del Documento.</li><li>Ajustes en el contenido.</li><li>Adecuacio\u0301n de la Norma Fundamental.</li><li>Adecuacio\u0301n de las Normas Legales.</li><li>Modificacio\u0301n del nombre.</li><li>Cambios en la Estructura.</li><li>Unificacio\u0301n de los documentos.</li><li>Revisio\u0301n sin modificaciones.</li><li>Divisio\u0301n del Documento.</li></ol><div class=\'history-changes-main-container\'><div class=\'history-change-item\'><span><b>Versi\xf3n</b></span>&nbsp;&nbsp;&nbsp;<span>1</span></div><div class=\'history-change-item\'><span><b>Fecha</b></span>&nbsp;&nbsp;&nbsp;<span>2024.11.05</span></div><div class=\'history-change-item\'><span><b>Descripcio\u0301n de la Modificacio\u0301n</b></span><br /><span>Creaci\xf3n del documento</span></div><div class=\'history-change-item\'><span><b>* Naturaleza del Cambio</b></span><br><span>1</span></div><div class=\'history-change-item\'><span><b>Elaboro\u0301</b></span></div><div class=\'history-change-item\'><span>Oficial de Cumplimiento</span></div><div class=\'history-change-item\'><span><b>Reviso\u0301</b></span></div><div class=\'history-change-item\'><span>Representante de la Direccio\u0301n</span></div><div class=\'history-change-item\'><span><b>Aprobo\u0301</b></span></div><div class=\'history-change-item\'><span>Junta Directiva</span></div></div>"}]}]},"kambi":{"alertText":"Error Cargando Kambi","buttonText":"Recargar"},"Splash":{"Title":"Splash","imageUrl":"assets/img/slots/SplashTech.jpg","error":"No se pudo cargar el juego","validations":{"session":"Debes iniciar sesi\xf3n para jugar","balance":"Debes tener saldo para poder jugar"}},"TermsPopUp":{"popupTitle":"Hola, nuestros t\xe9rminos y condiciones han cambiado","popupLinkText":"Con\xf3celos","popupLink2Text":"aqu\xed","popupButtonText":"Aceptar","popupVersionText":"Versi\xf3n 1.5"}}')},88593:Me=>{"use strict";Me.exports=JSON.parse('{"name":"axios","version":"0.21.3","description":"Promise based HTTP client for the browser and node.js","main":"index.js","scripts":{"test":"grunt test","start":"node ./sandbox/server.js","build":"NODE_ENV=production grunt build","preversion":"npm test","version":"npm run build && grunt version && git add -A dist && git add CHANGELOG.md bower.json package.json","postversion":"git push && git push --tags","examples":"node ./examples/server.js","coveralls":"cat coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js","fix":"eslint --fix lib/**/*.js"},"repository":{"type":"git","url":"https://github.com/axios/axios.git"},"keywords":["xhr","http","ajax","promise","node"],"author":"Matt Zabriskie","license":"MIT","bugs":{"url":"https://github.com/axios/axios/issues"},"homepage":"https://axios-http.com","devDependencies":{"coveralls":"^3.0.0","es6-promise":"^4.2.4","grunt":"^1.3.0","grunt-banner":"^0.6.0","grunt-cli":"^1.2.0","grunt-contrib-clean":"^1.1.0","grunt-contrib-watch":"^1.0.0","grunt-eslint":"^23.0.0","grunt-karma":"^4.0.0","grunt-mocha-test":"^0.13.3","grunt-ts":"^6.0.0-beta.19","grunt-webpack":"^4.0.2","istanbul-instrumenter-loader":"^1.0.0","jasmine-core":"^2.4.1","karma":"^6.3.2","karma-chrome-launcher":"^3.1.0","karma-firefox-launcher":"^2.1.0","karma-jasmine":"^1.1.1","karma-jasmine-ajax":"^0.1.13","karma-safari-launcher":"^1.0.0","karma-sauce-launcher":"^4.3.6","karma-sinon":"^1.0.5","karma-sourcemap-loader":"^0.3.8","karma-webpack":"^4.0.2","load-grunt-tasks":"^3.5.2","minimist":"^1.2.0","mocha":"^8.2.1","sinon":"^4.5.0","terser-webpack-plugin":"^4.2.3","typescript":"^4.0.5","url-search-params":"^0.10.0","webpack":"^4.44.2","webpack-dev-server":"^3.11.0"},"browser":{"./lib/adapters/http.js":"./lib/adapters/xhr.js"},"jsdelivr":"dist/axios.min.js","unpkg":"dist/axios.min.js","typings":"./index.d.ts","dependencies":{"follow-redirects":"^1.14.0"},"bundlesize":[{"path":"./dist/axios.min.js","threshold":"5kB"}]}')},84268:Me=>{"use strict";Me.exports=JSON.parse('{"PlayerAutoLimits":{"autoLimitsExplanation":"Los l\xedmites se incrementan de manera jer\xe1rquica","instruction1":"Para aumentar de nivel en los l\xedmites debes cumplir con unos requisitos","instruction2":"Si deseas ubicarte en el nivel 1 el sistema te lo aprobar\xe1 de manera autom\xe1tica","instruction3":"Si los auto l\xedmites que deseas seleccionar son inferiores a los establecidos en el nivel 1, debes eligir la opci\xf3n \\"otros l\xedmites\\" y ubicar el valor d