al","CON":"Conjunto residencial","CONJ":"Conjunto","ESQ":"Esquina","P":"Piso","BL":"Bloque","MZ":"Manzana","IN":"Interior","ED":"Edificio","OF":"Oficina","TO":"Torre","CRT":"Carretera","CA":"Casa"},"AddressTypes":{"AC":"Avenida calle","AK":"Avenida carrera","AUT":"Autopista","AV":"Avenida","CL":"Calle","CRV":"Circunvalar","DG":"Diagonal","TV":"Transversal","KM":"Kil\xf3metro","CR":"Carrera","CIR":"Circular"}},"Transunion":{"_comment":"Variable para activar o inactivar en el registro transunion ","status":"active","riesgoDispositivo":true},"popUpValidacionDoc":{"_comment":"Variable para mostar el pop up de recomendacion de validacion de identidad a ppt y pep ","status":"active"},"BtagTracking":{"_comment":"Configuraci\xf3n para captura y envio del parametro btag/affiliatefrom","enabled":true,"cookieName":"btag","cookieDomain":null,"cookiePath":"/","cookieSecure":false,"cookieSameSite":"Lax"},"bonusWelcome":{"_comment":"Variable para activar o inactivar en el registro el bono de bienvenida","status":"active"}}')},15042:Me=>{"use strict";Me.exports=JSON.parse('[{"id_equipo":1,"nombre":"SANTA FE"},{"id_equipo":2,"nombre":"DEPORTES TOLIMA"},{"id_equipo":3,"nombre":"ATL\xc9TICO NACIONAL"},{"id_equipo":4,"nombre":"EQUIDAD CLUB DEPORTIVO"}]')},53996:Me=>{"use strict";Me.exports=JSON.parse('{"Menupagos":{"_comment":"json para ordenar los pagos en el menu || Cambiar valor de la flag segun pasarela que se desee activar/desactivar ACTIVO = 1 / INACTIVO = 0 || Flag id NO se debe cambiar || Las flags para billeteraVirtual las pasarelas solo debe estar una pasarela","listapagos":[{"id":"1","orden":"1","pse":"1","tarjeta":"1","nombre":"Recarga con Payu"},{"id":"2","orden":"2","pse":"1","tarjeta":"0","nombre":"Recarga con Kushki"},{"id":"3","orden":"4","pse":"1","tarjeta":"0","nombre":"Recarga con Nuvei"},{"id":"4","orden":"3","pse":"1","tarjeta":"0","nombre":"Recarga con TuCompra"},{"id":"5","orden":"5","pse":"1","tarjeta":"1","nombre":"Recarga con SuperPay"}],"billeteraVirtual":[{"nombre":"nequi","pasarelas":{"payu":"0","kushki":"0","tuCompra":"0","superPay":"1022"},"isActive":true},{"nombre":"daviplata","pasarelas":{"payu":"0","kushki":"0","tuCompra":"1551"},"isActive":true}]},"bingo":{"loadingSpinner":"Cargando...","mainContainer":{"playTitle":"\xa1Canta Bingo con BetPlay! Entra ya y convi\xe9rtete en ganador","playButton":"\xa1Juega!"},"iframeContainer":"Tu juego comenzar\xe1 pronto..."},"virtual":{"bannerTitle":"Acumula apuestas en deportes virtuales y participa por grandes premios","elapsedTime":"Tiempo de juego transcurrido: ","searchPlaceholder":"Buscar","noResults":"No se encontr\xf3 ning\xfan resultado con el t\xe9rmino ingresado.","seeAll":"Ver Todos","playNow":"\xa1Juega Ya!"},"torneoRegister":{"Mecanica":"Registra tu equipo de 4 integrantes, acumula puntos recargando y apostando en la secci\xf3n deportes y participa por incre\xedbles premios en cada fase.","mecanicaTitle":"MEC\xc1NICA","instruccionRegistro":"Para registrar un equipo debes iniciar sesi\xf3n","nombreEquipoLabel":"Nombre del equipo","nombreEquipoErrorRequired":"Debes ingresar el nombre de tu equipo","nombreEquipoErrorPattern":"El campo no puede contener caracteres especiales","nombreParticipanteLabel":"Nombre","cedulaLabel":"C\xe9dula","primerParticipanteErrorRequired":"Debes ingresar el nombre del primer participante","participanteErrorPattern":"El campo no puede contener n\xfameros, ni caracteres especiales","cedulaErrorRequired":"Debes ingresar la c\xe9dula del primer participante","cedulaErrorPattern":"El campo solo debe contener n\xfameros","botonRegistro":"Registra tu Equipo","botonCargando":"Cargando...","altSello":"premios y logo campeonato mundialista","altRegisterImage":"registro campeonato mundialista","altArrowLeft":"flecha direcci\xf3n izquierda","altArrowRight":"flecha direcci\xf3n derecha","altInfo":"restricciones, prohibiciones e informaci\xf3n del juego"},"torneoClassified":{"phaseTitle":"FASE","noTeamsClassified":"A\xfan no hay equipos clasificados","teamWomanAndLogoAlt":"Mujer y logo campeonato","classifiedTeamsTitle":"clasificados mundialistas","arrowLeftAlt":"flecha direcci\xf3n izquierda","arrowRightAlt":"flecha direcci\xf3n derecha","gameInfoAltTitle":"resticciones, prohibiciones e informacion del juego","infoTitle":"informacion coljuegos"},"torneoEliminated":{"mechanicTitle":"MEC\xc1NICA ELIMINADOS","mechanicDescription":"Lorem ipsum dolor sit amet consectetur adipisicing elit. Possimus laboriosam odio eius at aliquid dolorem saepe magni, corporis cum adipisci exercitationem, optio, quis tempora et? Illum cumque a nesciunt iusto?","searchPlaceholder":"Buscar equipo...","eliminatedTeams":"EQUIPOS ELIMINADOS","points":"PUNTOS","loading":"Cargando...","noTeamsFound":"No se encontraron equipos","imageAlt":"Imagen de equipos eliminados"},"torneoTranslations":{"signUp":"INSCR\xcdBETE","ranking":"RANKING","classified":"CLASIFICADOS","close":"Cerrar"},"torneoRanking":{"altImage1":"Hombre feliz y logo del campeonato","titleImage1":"ranking mundialista","rankingTitle":"RANKING","searchPlaceholder":"Buscar Equipo","tableHeader1":"Nombre Equipo","tableHeader2":"Puntos","tableHeader3":"Fase Alcanzada","teamName":"Equipo #","phase":"Fase","loading":"Cargando...","noTeams":"No se encontraron equipos","altImage2":"Hombre feliz y logo del campeonato","titleImage2":"ranking mundialista","altArrowLeft":"flecha direcci\xf3n izquierda","altArrowRight":"flecha direcci\xf3n derecha","altInfo":"resticciones, prohibiciones e informacion del juego","titleInfo":"informacion coljuegos"},"loyaltyTable":{"logoAlt":"Logo BetPlay Fideliaci\xf3n","title":"Tabla de puntos","subtitle1":"Apuestas Gratis","benefitsHeader":"Beneficios","pointsHeader":"Puntos","logoAltFidelizacion":"logos de fidelizacion","benefit1000":"$ 1.000","benefit2000":"$ 2.000","benefit5000":"$ 5.000","benefit10000":"$ 10.000","benefit20000":"$ 20.000","benefit50000":"$ 50.000","benefit100000":"$ 100.000","benefit200000":"$ 200.000","benefit500000":"$ 500.000","points140":"140","points130":"130","points120":"120","points180":"180","points240":"240","points260":"260","points200":"200","points700":"700","points650":"650","points600":"600","points500":"500","points1400":"1400","points1300":"1300","points1200":"1200","points1000":"1000","points2800":"2800","points2600":"2600","points2400":"2400","points2000":"2000","points7000":"7000","points6500":"6500","points6000":"6000","points5000":"5000","points14000":"14000","points13000":"13000","points12000":"12000","points10000":"10000","points28000":"28000","points26000":"26000","points24000":"24000","points20000":"20000","subtitle2":"Bonos","points320":"320","points280":"280","points800":"800","points1600":"1600","points3200":"3200","points8000":"8000","points16000":"16000","points32000":"32000","points80000":"80000","points70000":"70000","points60000":"60000","points50000":"50000","okButton":"Ok"},"mapModule":{"title":"Encuentra la tienda f\xedsica m\xe1s cercana y realiza tus apuestas deportivas con BetPlay"},"formNewPoker":{"altLogoPoker":"Imagen ilustrativa chicos del poker","altLogoBetplay":"Logo tipo de betplay","labelUsername":"Usuario","usernamePlaceholder":"Usuario","labelPassword":"Contrase\xf1a","passwordPlaceholder":"Contrase\xf1a","loginButtonText":"Iniciar sesi\xf3n","loadingText":"Cargando...","cancelButtonText":"Cancelar"},"StaticslotRoules":{"slotsRulesTitle":"Reglas de slots","slotsClaimsTitle":"Reclamaciones de slots","claimsText":"Si tienes una reclamaci\xf3n da click","claimsLinkText":"aqu\xed"},"allBetsHistory":{"consultaElArchivoDandoClicEnEsteLink":"Consulta el archivo dando clic en este link"},"staticHelps":{"title":"Ayuda","problem":"\xbfTienes un problema? Si es as\xed y necesitas asistencia puedes contactar con nosotros por diferentes v\xedas:","email":"Por correo electr\xf3nico: ","writeUs":"Escribenos ","socialMedia":"A trav\xe9s de nuestras redes sociales:","facebook":"Facebook:","twitter":"Twitter:","BetPlayCO":"@BetPlayCO"},"staticResGame":{"closeButtonAlt":"cerrar","responsibleGamingTitle":"Juego Responsable","responsibleGamingDescription":"En esta secci\xf3n encontrar\xe1s un conjunto de consejos, herramientas y recursos que te ayudar\xe1n a gestionar tu actividad de juego y practicar as\xed un juego responsable.","basicTipsTitle":"Consejos para que practiques un juego responsable","basicTipsDescriptionIntro":"Primeramente te ofrecemos una serie de consejos b\xe1sicos para la pr\xe1ctica de un juego responsable. Posteriormente, te detallamos una serie de herramientas y servicios que ponemos a tu disposici\xf3n como la autoexclusi\xf3n los l\xedmites de dep\xf3sito, el historial de juego y la gesti\xf3n del tiempo dedicado al juego. Y, por \xfaltimo, encontrar\xe1s un listado de recursos como un test de autoevaluaci\xf3n.","basicTipsDescription":"Si necesitas m\xe1s informaci\xf3n sobre juego responsable puedes ponerte en contacto con nosotros e intentaremos ayudarte en la medida de lo posible","basicTipsList":["Jugar es un entretenimiento y no una forma de ganar dinero.","Controla el dinero y el tiempo que dedicas a jugar.","Solamente juega con el dinero que est\xe1s dispuesto a perder de acuerdo con tus circunstancias personales y econ\xf3micas, no m\xe1s.","Evita jugar m\xe1s para intentar recuperar el dinero que hayas perdido.","No juegues bajo los efectos del alcohol, medicamentos, en momentos de decaimiento an\xedmico o en los que te est\xe9s recuperando de alguna adicci\xf3n.","Aseg\xfarate de que has completado todas tus responsabilidades diarias antes de empezar a jugar. No permitas que el juego interfiera en tu vida diaria.","Si sospechas que tienes alg\xfan problema con el juego, h\xe1blalo con alguien. En la secci\xf3n \u2018Centros de Ayuda\u2019, que encontrar\xe1s m\xe1s adelante, te incluimos un listado con los sitios donde pueden ayudarte.","Recuerda que puedes controlar o restringir el acceso a sitios de juego mediante el uso de herramientas. En la secci\xf3n \u2018Control Parental\u2019 encontrar\xe1s un listado de dichas herramientas."],"selfExclusionTitle":"Autoexclusi\xf3n","selfExclusionDescription":["La autoexclusi\xf3n es un servicio orientado a restringir tu acceso a este sitio de forma temporal.","Durante el tiempo que dure la autoexclusi\xf3n no podr\xe1s: Participar en ninguno de nuestros juegos.","Depositar ni retirar fondos en tu cuenta.","Recibir noticias ni comunicaciones comerciales por nuestra parte.","Crear una nueva cuenta de usuario.","Ten en cuenta que una vez fijado el tiempo y aceptada la autoexclusi\xf3n por tu parte, no se podr\xe1 reabrir tu cuenta hasta que el periodo indicado haya finalizado.","Por ejemplo, si decides autoexcluirte por un periodo de 5 d\xedas, no podr\xe1s entrar en tu cuenta de usuario hasta pasados esos 5 d\xedas.","Si deseas la readmisi\xf3n, en el caso de cualquier autoexclusi\xf3n, tendr\xe1s que ser t\xfa quien lo solicite de manera expl\xedcita.","Una vez pasado el tiempo de autoexclusi\xf3n tu cuenta se reactivar\xe1 de forma autom\xe1tica.","Para solicitar el servicio de autoexclusi\xf3n ponte en contacto con nuestro departamento de atenci\xf3n al cliente o solic\xedtalo directamente en el apartado de \u2018Autoexclusi\xf3n\u2019, dentro de la secci\xf3n \u2018Juego Responsable\u2019 de tu cuenta de usuario. Por favor, recuerda que para activar el servicio de Autoexclusi\xf3n no puedes tener apuestas pendientes ni saldo en tu cuenta. Por tanto, antes de activar el servicio deber\xe1s esperar a que se resuelvan todas las apuestas pendientes y retirar todo tu dinero.","Adicionalmente te recomendamos que, durante el periodo de autoexclusi\xf3n, elimines la recepci\xf3n de nuestras notificaciones en tu m\xf3vil y, en caso de que nos sigas a trav\xe9s de redes sociales, tomes las medidas oportunas para asegurarte de no recibir ninguna noticia por nuestra parte. Adem\xe1s, si mantienes cuentas de juego en otros sitios, te recomendamos que hagas lo propio y solicites la Autoexclusi\xf3n de esos sitios tambi\xe9n."],"depositLimitsTitle":"L\xedmites de dep\xf3sito","depositLimitsDescription":["Por defecto tienes asignados los siguientes l\xedmites de dep\xf3sito:","$ 10.000.000 diarios (de las 00:00h a las 24:00h).","$ 50.000.000 semanales (de las 00:00h del lunes a las 24:00h del domingo).","$ 150.000.000 mensuales (de las 00:00h del primer d\xeda del mes a las 24:00h del \xfaltimo d\xeda del mes).","Esto significa que el l\xedmite m\xe1ximo de dinero que puedes depositar en un d\xeda es de $ 10.000.000 , en una semana es de $ 50.000.000 y en un mes es de $ 150.000.000. Si quieres depositar m\xe1s dinero, el sistema no te dejar\xe1 a menos que nos solicites una ampliaci\xf3n de estos l\xedmites o la eliminaci\xf3n de los mismos. Para ello, debes ir a la secci\xf3n \u2018Juego Responsable\u2019, dentro de tu cuenta de usuario y seleccionar \u2018Auto l\xedmites del jugador\u2019.","Puedes solicitar aumentar o reducir tus l\xedmites respecto a lo que ya tengas fijados. Aqu\xed se producen varias casu\xedsticas que seguidamente te explicamos:","Si decides reducir tus l\xedmites respecto a los que tienes fijados, la aplicaci\xf3n de los nuevos l\xedmites se produce de forma inmediata. Por ejemplo, si quieres reducir tu l\xedmite diario de $ 10.000.000 a $ 1.700.000, el nuevo l\xedmite de $ 1.700.000 se aplicar\xe1 de forma inmediata.","Si decides ampliar tus l\xedmites, la aplicaci\xf3n de los nuevos l\xedmites no es inmediata. Los nuevos l\xedmites entrar\xe1n en vigor pasados 7 d\xedas desde la solicitud de la ampliaci\xf3n."],"gameHistoryTitle":"Historial de juego","gameHistoryDescription":"Puedes conocer tu activad de juego accediendo a tu historial de actividad, donde podr\xe1s consultar tus dep\xf3sitos, retiradas, participaci\xf3n en juegos y premios obtenidos, en diferentes periodos de tiempo","gameTimeManagementTitle":"Gesti\xf3n del tiempo dedicado al juego","gameTimeManagementDescription":["En la Web encontrar\xe1s diferentes indicadores que te ayudar\xe1n a gestionar el tiempo que dedicas a jugar.","En el momento que inicias una nueva sesi\xf3n de juego, aparece un indicador con el tiempo de sesi\xf3n actual. De esta forma podr\xe1s saber en todo momento el tiempo que llevas jugando. Este indicador se reinicia cada vez que inicias una nueva sesi\xf3n. Sin embargo, en la secci\xf3n \u2018Mis datos\u2019, dentro de tu cuenta de usuario, aparece indicada la fecha y hora de la \xfaltima sesi\xf3n que iniciaste."],"selfAssessmentText":"Test de Autoevaluaci\xf3n","selfAssessmentReference":"A continuaci\xf3n encontrar\xe1s un breve test de autoevaluaci\xf3n que es propiedad de la Direcci\xf3n General de Ordenaci\xf3n del Juego en Espa\xf1a a modo de referencia.","selfAssessmentQuestions":["1. \xbfSe encuentra a menudo recordando experiencias pasadas de juego, planificando la pr\xf3xima vez que va a jugar y/o se plantea formas de conseguir dinero con el que jugar?","2. \xbfHa jugado alguna vez m\xe1s dinero de lo que ten\xeda pensado?","3. \xbfIntenta controlar, interrumpir o detener el juego?","4. \xbfEl intento de interrumpir o detener el juego le produce inquietud o irritabilidad?","5. \xbfJuega para evadirse de alg\xfan problema?","6. Cuando usted se juega dinero, \xbfvuelve otra vez a jugar para recuperar el dinero perdido?","7. \xbfCree usted que tiene alg\xfan problema con el juego?","8. \xbfFinancia su actividad de juego mediante dinero familiar, pr\xe9stamo, falsificaci\xf3n, fraude o robo?","9. \xbfHa perdido alguna vez tiempo de trabajo o de clase debido al juego?","10. \xbfHa acudido a alguien para que le ayude con sus problemas econ\xf3micos producidos por el juego?"],"selfAssessmentAnswers":["\u2022 S\xed.","\u2022 No."],"additionalRecommendations":"Adicionalmente te recomendamos que, durante el periodo de autoexclusi\xf3n, elimines la recepci\xf3n de nuestras notificaciones en tu m\xf3vil y, en caso de que nos sigas a trav\xe9s de redes sociales, tomes las medidas oportunas para asegurarte de no recibir ninguna noticia por nuestra parte. Adem\xe1s, si mantienes cuentas de juego en otros sitios, te recomendamos que hagas lo propio y solicites la Autoexclusi\xf3n de esos sitios tambi\xe9n."},"staticBetRoules":{"bettingRulesTitle":"Reglas de apuestas","bettingClaimsTitle":"Reclamaciones de apuestas","bettingRulesDescription":"Si tienes una reclamaci\xf3n haz click","bettingRulesLinkText":"aqu\xed","bettingRulesPath":"/reclamaciones"},"staticCookies":{"pageTitle":"Pol\xedtica de Cookies","introduction":"Utilizamos cookies con el fin de ofrecerte un servicio personalizado e individualizado. A continuaci\xf3n te detallamos toda la informaci\xf3n relativa a cookies: qu\xe9 son, cu\xe1ndo y c\xf3mo las usamos, el tipo de cookies que utilizamos, su finalidad y la forma que tienes de desactivarlas o eliminarlas.","whatAreCookiesTitle":"\xbfQu\xe9 son las cookies?","whatAreCookiesContent":"Las cookies son peque\xf1os archivos de texto que se almacenan en el navegador de tu dispositivo y nos permiten reconocerlos cada vez que nos visites.","whenWeUseCookiesTitle":"\xbfCu\xe1ndo las usamos?","whenWeUseCookiesContent":"Dependiendo de lo que hagas en este Sitio utilizamos unas cookies u otras. Por ejemplo, cuando est\xe1s de visita en el Sitio utilizamos cookies anal\xedticas para saber de d\xf3nde vienes o cuando entras en tu cuenta utilizamos cookies para validar y mantener tu sesi\xf3n.","whatCookiesWeUseTitle":"\xbfQu\xe9 cookies utilizamos?","cookiesCategories":"Existen diferentes tipos de cookies. A continuaci\xf3n te las clasificamos por categor\xedas para que las conozcas mejor:","cookiesManagement":"Cookies seg\xfan la entidad que las gestione:","ownCookies":"Cookies propias: Las que enviamos a tu dispositivo desde un servidor o dominio gestionado por nosotros y desde el que se presta el servicio que has solicitado.","thirdPartyCookies":"Cookies de terceros: Tambi\xe9n se env\xedan a tu dispositivo desde un servidor o dominio gestionado por nosotros pero la informaci\xf3n recogida es gestionada por un tercero.","cookiesDuration":"Cookies seg\xfan el plazo de tiempo que permaneces activadas:","sessionCookies":"Cookies de sesi\xf3n: Estas son accesibles y almacenan informaci\xf3n s\xf3lo mientras mantienes tu sesi\xf3n activa.","persistentCookies":"Cookies persistentes: Al rev\xe9s del caso anterior la informaci\xf3n es almacenada y accesible durante un periodo de tiempo definido.","cookiesPurpose":"Cookies seg\xfan su finalidad:","technicalCookies":"Cookies t\xe9cnicas: Son las que nos permiten utilizar diferentes opciones o servicios como, por ejemplo, identificar tu sesi\xf3n, realizar el proceso de una apuesta o utilizar elementos de seguridad durante tu navegaci\xf3n.","personalizationCookies":"Cookies de personalizaci\xf3n: Con ellas podemos utilizar diferentes caracter\xedsticas en nuestros servicios, como por ejemplo, cambiar de idioma.","analysisCookies":"Cookies de an\xe1lisis: Las que utilizamos para el seguimiento y an\xe1lisis de tu comportamiento en el sitio, con el fin de mejorar tu experiencia de usuario.","cookiesUsageSummary":"A continuaci\xf3n te resumimos en un cuadro las cookies que utilizamos en BetPlay","linksToOtherSites":"En el sitio encontrar\xe1s enlaces a otros sitios. Es importante que recuerdes que estos otros sitios web utilizan sus propias cookies y pol\xedticas de privacidad. En caso de que decidas utilizar estos sitios de terceros te recomendamos que leas antes su pol\xedtica de privacidad y de cookies.","howToDisableOrDeleteCookiesTitle":"\xbfC\xf3mo desactivar o eliminar las cookies instaladas?","howToDisableOrDeleteCookiesContent":"La mayor\xeda de los navegadores est\xe1n configurados para aceptar las cookies de forma autom\xe1tica. Sin embargo, puedes configurar tu navegador para que te avise antes de instalar una cookie y as\xed puedas aceptar o denegar su instalaci\xf3n. En el men\xfa de ayuda de tu navegador podr\xe1s consultar las instrucciones y manuales para ampliar esta informaci\xf3n. Adicionalmente, te facilitamos los siguientes enlaces que incluyen informaci\xf3n pr\xe1ctica sobre c\xf3mo gestionar las cookies en los navegadores m\xe1s utilizados:","firefox":"Firefox:","firefoxLink":"https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-que-los-sitios-we","googleChrome":"Google Chrome:","googleChromeLink":"https://support.google.com/chrome/answer/95647?hl=es","internetExplorer":"Internet Explorer:","internetExplorerLink":"http://windows.microsoft.com/es-ES/windows-vista/Block-or-allow-cookies","safari":"Safari:","safariLink":"https://support.apple.com/es-es/HT201265","cookieEffectIfBlocked":"Es importante que recuerdes que en caso de impedir la entrada de cookies es posible que algunas de las funciones del sitio dejen de tener efecto, ya que dependen de la informaci\xf3n almacenada en las mismas.","moreAboutPrivacy":"Si quieres saber m\xe1s sobre c\xf3mo gestionamos tu privacidad visita nuestra","privacyPolicy":"Pol\xedtica de protecci\xf3n de datos personales"},"staticAbout":{"closeAriaLabel":"cerrar","whoAreWeTitle":"\xbfQui\xe9nes Somos?","firstParagraph":"BETPLAY es una marca creada por Corredor Empresarial, para operar apuestas, juegos de casino y slots v\xeda online o presencial.","secondParagraph":"Corredor Empresarial S.A., es una empresa que agrupa a los principales empresarios de apuestas en Colombia, desarrollada con base en la experiencia de sus integrantes lo cual nos permite estar a la vanguardia en el sector de juegos y apuestas a nivel nacional lo cual se ha logrado gracias a la explotaci\xf3n del producto S\xfaper Astro, que nos ha permitido una participaci\xf3n importante dentro del sector coloc\xe1ndonos dentro del mercado competitivamente y abriendo las puertas para ofrecer un excelente portafolio de servicios.","thirdParagraph":"En el 2009 logramos la cristalizaci\xf3n de la comercializaci\xf3n del producto s\xfaper astro trayendo beneficios a nuestra entidad que solo existe para unir, agremiar y generar beneficios a trav\xe9s de nuestra asociaci\xf3n."},"loyaltymenu":{"profileTitle":"Perfil","balance":"Saldo","historyPoints":"Historial de puntos","pointsTable":"Tabla de puntos","pointsConditions":"Condiciones de puntos","howItWorks":"\xbfC\xf3mo funciona?","checkYourData":"Consulta tus datos","progress":"Progreso"},"carousel":{"back_button":"Retroceder","next_button":"Avanzar","social_media":"redes sociales","visit_social_media":"Visita la cuenta de","facebook_account":"Facebook de BetPlay","instagram_account":"Instagram de BetPlay","twitter_account":"Twitter de BetPlay","view_more_button":"VER M\xc1S","participate_here_button":"\xa1PARTICIPA AQU\xcd!"},"helpButton":{"title":"Ayuda","options":{"chat":"Chat","helpCenter":"Centro de ayuda","callYou":"Te Llamamos","writeUs":"Escr\xedbenos"},"altText":{"rowHelp":"Row-ayuda","buttonHelp":"Bot\xf3n de ayuda"}},"teamsPopup":{"close":"Cerrar","logoAlt":"Logo BetPlay Dimayor","finalAlt":"Final","tribuneAlt":"Tribuna Virtual","verifyYourData":"Verifica tus datos, marca la casilla aceptar t\xe9rminos y condiciones, luego presiona el bot\xf3n \\"Participar\\".","hello":"\xa1Hola!","sessionStartInfo":"Primero debes <span class=\\"text-white\\"><i>iniciar sesi\xf3n</i></span> para participar en la promoci\xf3n. Si aun no estas registrado haz clic en el bot\xf3n <span class=\\"text-white\\"><i>\u201cRegistrarse\u201d</i></span> completa todos los datos y comienza a participar.","sponsorLogoAlt":"Dimayor patrocinador","participationSuccessTitle":"\xa1Listo!","participationSuccessMsg":"Ya est\xe1s participando por una entrada a la FINAL de la Liga BetPlay Dimayor I-2021 en Tribuna Virtual de BetPlay.","moreInfo":"Recuerda que entre m\xe1s veces apuestes a los partidos de semifinales m\xe1s subir\xe1s en el ranking para entrar a la Tribuna Virtual de BetPlay, \xa1Son 5000 entradas y 60 millones en premios! Conoce m\xe1s en BetPlay.com.co/promociones y a trav\xe9s de las cuentas de RRSS de la Liga BetPlay Dimayor.","premios":"\xa1Son 5000 entradas y 60 millones en premios!","termsAndConditions":"Acepto los t\xe9rminos y condiciones de la promoci\xf3n y deseo participar.","participationButtonText":"\xa1Participar!","loadingButtonText":"Cargando...","selectOption":"-- Selecciona una opci\xf3n --"},"tratamientodatos":{"titulo_aviso":"Autorizaci\xf3n del tratamiento de datos personales","titulo_candado":"Candado","texto_aviso":"Autorizo de manera previa, expresa, voluntaria e informada a CORREDOR EMPRESARIAL S.A., identificada con NIT 900.243.000-8, con domicilio en la AC 26 No. 69D-91, Piso 8, Centro Empresarial Arrecife, Torre Peatonal 2, en la ciudad de Bogot\xe1 D.C., y n\xfamero de contacto 316 580 9078, para que, en su calidad de responsable del tratamiento de datos personales, lleve a cabo el tratamiento de mi informaci\xf3n personal, conforme a lo establecido en la Ley 1581 de 2012, el Decreto 1377 de 2013, el Decreto 1074 de 2015 y dem\xe1s disposiciones complementarias. Los datos recolectados ser\xe1n tratados de acuerdo con lo dispuesto en la Pol\xedtica de Tratamiento de Datos Personales de la Compa\xf1\xeda, disponible para consulta en el sitio web oficial","texto_consentimiento":"As\xed mismo, conozco mis derechos a conocer, actualizar y rectificar mis datos, entre otros, frente a datos parciales, inexactos, incompletos, fraccionados, que induzcan a error, o aquellos cuyo tratamiento est\xe9 expresamente prohibido o no haya sido autorizado; suprimir mi informaci\xf3n personal y revocar total o parcialmente el consentimiento otorgado para su tratamiento, siempre que no exista un mandato legal o contractual que faculte a la compa\xf1\xeda para continuar con el tratamiento de los mismos; acceder de forma gratuita a mis datos personales; solicitar prueba de mi autorizaci\xf3n; ser informado, previa solicitud, del uso que se le ha dado a mis datos personales y presentar quejas ante la Superintendencia de Industria y Comercio por infracciones a la Ley 1581 de 2012 y dem\xe1s normas complementarias, los cuales pueden ser ejercidos presentando su petici\xf3n a protecciondedatos@cempresarial.co o enviando comunicaci\xf3n escrita al domicilio de la Compa\xf1\xeda indicado anteriormente.","boton_ok":"Volver","linkPoliticaProteccionDeDatos":"URL al documento de pol\xedtica de protecci\xf3n de datos","texto_aviso_link":"aqui","texto_cumplimiento":"y tendr\xe1n como finalidades principales: cumplimiento de obligaciones legales ante autoridades administrativas o de control; validaci\xf3n de identidad y aplicaci\xf3n de filtros de seguridad; captura de fotograf\xeda y huella para la prevenci\xf3n del fraude y el cumplimiento del SIPLAFT/FPADM, en virtud de la Resoluci\xf3n 20195100044514 de 2019 emitida por Coljuegos; realizaci\xf3n de estudios de mercado; desarrollo de campa\xf1as de mercadeo; implementaci\xf3n de programas de fidelizaci\xf3n (CRM); identificaci\xf3n de ganadores de premios; monitoreo y control de operaciones a trav\xe9s de la recolecci\xf3n de informaci\xf3n sobre ubicaci\xf3n geogr\xe1fica y direcci\xf3n IP; y la segmentaci\xf3n de campa\xf1as comerciales por regi\xf3n, mediante el tratamiento de bases de datos internas.","texto_cumplimiento2":"Asimismo, autorizo la transferencia y/o transmisi\xf3n de mis datos personales a terceros, en particular a Comunicaciones Empresariales de Colombia S.A.S. \u2013 CEM S.A.S., identificada con NIT 900.530.021-3, sociedad controlada por Corredor Empresarial S.A. y corresponsable del tratamiento, domiciliada en la misma direcci\xf3n, quien podr\xe1 llevar a cabo actividades de procesamiento, almacenamiento, gesti\xf3n y soporte en el marco de la red comercial de la Compa\xf1\xeda. Manifiesto conocer mis derechos como titular de los datos personales, entre ellos: acceder en forma gratuita a los mismos; solicitar su correcci\xf3n, actualizaci\xf3n o supresi\xf3n; revocar total o parcialmente la autorizaci\xf3n otorgada, salvo que exista un deber legal o contractual que lo impida; solicitar prueba de la autorizaci\xf3n; ser informado sobre el uso que se ha dado a mis datos, y presentar quejas ante la Superintendencia de Industria y Comercio en caso de considerar vulnerados mis derechos por el uso indebido de la informaci\xf3n. Para ejercer cualquiera de estos derechos, podr\xe9 dirigirme a protecciondedatos@cempresarial.co o enviar comunicaci\xf3n escrita al domicilio de la Compa\xf1\xeda indicado anteriormente.","titulo_privacidad":"Aviso de privacidad","texto_privacidad":"En cumplimiento de la Ley Estatutaria 1581 de 2012 de Protecci\xf3n de Datos Personales (LEPD), Corredor Empresarial S.A., identificada con el NIT No. 900.243.000\u20138, en adelante \'BetPlay\' ser\xe1 la entidad responsable del tratamiento de sus datos personales. Con el fin de brindarle una atenci\xf3n integral como cliente, los datos personales recabados ser\xe1n tratados con las siguientes finalidades: gesti\xf3n de clientes, realizaci\xf3n de encuestas de opini\xf3n, atenci\xf3n al ciudadano, gesti\xf3n de peticiones, quejas y reclamos, as\xed como gesti\xf3n administrativa, marketing, prospecci\xf3n comercial y publicidad propia, as\xed como el env\xedo de comunicaciones a trav\xe9s de los medios registrados, tales como correo electr\xf3nico, tel\xe9fono celular y sistemas de mensajer\xeda instant\xe1nea.","texto_privacidad2":"Es importante se\xf1alar que la suministraci\xf3n de datos relacionados con informaci\xf3n de Datos Sensibles, entendidos como aquellos que afectan la intimidad o que puedan generar alg\xfan tipo de discriminaci\xf3n, as\xed como datos concernientes a menores de edad, es de car\xe1cter facultativo.","texto_privacidad3":"La pol\xedtica de tratamiento de datos personales del Titular, as\xed como los cambios sustanciales que se puedan presentar en la misma, podr\xe1n ser consultados aqu\xed  El Titular podr\xe1 ejercer sus derechos de acceso, correcci\xf3n, supresi\xf3n, revocaci\xf3n o presentar un reclamo por infracci\xf3n sobre sus datos personales, mediante un escrito dirigido a Corredor Empresarial S.A. a trav\xe9s de correo electr\xf3nico a protecciondedatos@cempresarial.co, o por correo postal a la siguiente direcci\xf3n: Centro Empresarial Arrecife, Avenida 26 #69D-91 Torre 2 Piso 8."},"registryError":{"phoneNumberInUse":"El n\xfamero telef\xf3nico digitado se encuentra en uso por otro usuario.","phoneNumberRegistered":"El tel\xe9fono ingresado ya se encuentra registrado en la plataforma. Finaliza tu proceso de registro con nuestro contact center.","chatWithUs":"Hablamos por chat","weCallYou":"Nosotros te llamamos"},"popUpError":{"title":"Error de Conexi\xf3n","message":"Parece que tienes un problema con tu conexi\xf3n. Por favor, int\xe9ntalo de nuevo m\xe1s tarde.","chatButtonText":"Hablamos por chat","callButtonText":"Nosotros te llamamos"},"ludopathWarning":{"warningIconAlt":"icono advertencia","warningIconTitle":"icono advertencia","warningText":"Se\xf1or Usuario lamentamos informarle que no podemos permitirle el registro en la plataforma; dado que seg\xfan el Acuerdo No. 08 del 16 de septiembre de 2020 emitido por Coljuegos (Art\xedculo 1.7.4 Prohibici\xf3n de Participar en los Juegos Operados por Internet), los operadores de juegos por internet no deben permitir el juego a personas que padezcan enfermedades mentales que hayan sido declaradas interdictos judicialmente.","warningLinkText":"Para consultar el acuerdo completo haga click Aqu\xed","warningLinkURL":"/static/acuerdo-8-16-coljuegos","confirmButtonText":"Confirmar"},"blockedEmailage":{"popupCloseTitle":"Cerrar popup","altExternalRing":"anillo externo","altCross":"cruz","validationFailedMessage":"Hola, lamentamos informarte que por pol\xedticas de validaci\xf3n de BetPlay, tu registro no fue admitido.","okButton":"OK"},"limitsModal":{"defaultLimits":"Por defecto tienes asignados los siguientes l\xedmites de dep\xf3sito:","dailyLimit":"diarios (de las 00:00h a las 24:00h).","weeklyLimit":"semanales (de las 00:00h del lunes a las 24:00h del domingo).","monthlyLimit":"mensuales (de las 00:00h del primer d\xeda del mes a las 24:00h del \xfaltimo d\xeda del mes).","acceptButton":"ACEPTAR"},"RecoveryPassword":{"title":"Restaurar contrase\xf1a","Recovery":"Cambiar contrase\xf1a","DocumentNumber":"C\xe9dula de identificaci\xf3n","Email":"Correo electr\xf3nico","CnfPassword":"Confirmar contrase\xf1a","Password":"Contrase\xf1a","Update":"Aceptar","OK":"OK","Back":"Atr\xe1s","load":"Cargar foto","Success":{"SuccessRecovery":"Hemos enviado al celular # y al correo $, un enlace de restablecimiento para que recuperes el acceso a tu cuenta","SuccessUpdate":"Actualizaci\xf3n realizada con \xe9xito"},"newPasswordText":"Introduce una nueva contrase\xf1a:","NoLess8Caracters":"Recuerda: M\xednimo 8 caracteres y m\xe1ximo 12","NoSpecialCaracters":"*Recuerda que para mayor seguridad , esta debe contener m\xednimo un car\xe1cter especial y una may\xfascula (sin espacios)","NoPersonalData":"No datos personales","Errors":{"AccountBlocked":"El estado de la cuenta no le permite realizar el proceso.","EmptyDocumentNumber":"Ingresa tu n\xfamero de documento","DocumentNumberNotFound":"El n\xfamero de documento ingresado no se encuentra registrado","DocumentNumberLessThan5":"El documento debe contener al menos 5 d\xedgitos","DocumentNumberMaxLength":"El documento debe contener menos de 10 d\xedgitos","DocumentNumberOnlyNumbers":"El n\xfamero de documento s\xf3lo debe contener n\xfameros y no puede iniciar con 0","PasswordNotMatch":"Las contrase\xf1as no coinciden","InvalidEmail":"Ingresa un email v\xe1lido","ErrorRecovery":"Hubo un error al recuperar la contrase\xf1a","EmailNotFound":"El correo no se encuentra registrado","EmptyPassword":"Ingresa tu nueva contrase\xf1a","EmptyCnfPassword":"Confirma tu contrase\xf1a","ErrorUpdate":"Hubo un error al actualizar la contrase\xf1a","PasswordLessThan8":"La contrase\xf1a debe tener al menos 8 caracteres.","PasswordMoreThan12":"La contrase\xf1a no debe tener m\xe1s de 12 caracteres.","InvalidPassword":"La contrase\xf1a es invalida."}},"claim":{"closeButtonAriaLabel":"cerrar","howToComplainTitle":"\xbfC\xf3mo hacer un reclamo?","complaintIntroduction":"El usuario podr\xe1 presentar una reclamaci\xf3n enviando un e-mail con la opci\xf3n Escribenos o una comunicaci\xf3n postal a la direcci\xf3n:","postalAddress":"Corredor Empresarial Bogot\xe1 , Colombia Av Calle 26 No. 69D-91, Centro Empresarial Arrecife, Torre peatonal, Of. 802","complaintGuidelinesIntro":"En dicha reclamaci\xf3n, el usuario deber\xe1 indicar la siguiente informaci\xf3n:","complaintGuidelines":{"reason":"\u2013 Motivo de la reclamaci\xf3n.","username":"\u2013 Nombre de Usuario del portal www.betplay.com.co","betCode":"\u2013 En caso de que proceda, c\xf3digo identificador de la apuesta, partida o sesi\xf3n de juego."},"complaintDeadline":"El plazo m\xe1ximo para la presentaci\xf3n de la reclamaci\xf3n ser\xe1 de tres meses contados desde la fecha de celebraci\xf3n del evento, sesi\xf3n de juego, partida o hecho que la origin\xf3. Dicha reclamaci\xf3n ser\xe1 respondida por Betplay en el plazo m\xe1ximo de un mes a contar desde que sea recibida.","complaintReceiptAcknowledgment":"Betplay emitir\xe1 una comunicaci\xf3n al usuario en la que acusar\xe1 recibo de la reclamaci\xf3n, inform\xe1ndole tambi\xe9n del plazo en el que se le comunicar\xe1 la decisi\xf3n tomada al respecto.","prizeExpirationInterruption":"El plazo de caducidad de premios quedar\xe1 interrumpido desde la fecha de recepci\xf3n de la reclamaci\xf3n por Betplay hasta la fecha en que se hubiera comunicado su decisi\xf3n al usuario.","furtherActionsAfterResolution":"Resuelta la reclamaci\xf3n por Betplay o transcurrido un mes desde la presentaci\xf3n de la reclamaci\xf3n sin que Betplay haya comunicado su decisi\xf3n, el usuario podr\xe1 formular reclamaci\xf3n ante Coljuegos."},"payUApi":{"cardDetailsTitle":"Tus datos","purchaseSummaryTitle":"Resumen de la compra","paymentSelectionTitle":"Selecciona el medio de pago","reference":"Referencia:","description":"Descripci\xf3n:","totalToPay":"Total a pagar:","depositDescription":"D\xe9posito Betplay","creditOrDebitCard":"Tarjeta de cr\xe9dito o d\xe9bito","bankDepositPSE":"Dep\xf3sito bancario PSE","depositSURED":"Dep\xf3sito SURED","verifyPaymentLimit":"Recuerda verificar el monto m\xe1ximo que tienes habilitado para pagos por internet"},"pagoEfectivo":{"title":"Pago en efectivo","cambiarMetodoPago":"Cambiar m\xe9todo de pago","paso1":"1. Has click en el bot\xf3n \\"Generar n\xfamero de pago\\" para obtener el n\xfamero que te pedir\xe1 el cajero V\xeda Baloto","paso2":"2. Realiza el pago en efectivo presentando el n\xfamero que generaste, en cualquier punto V\xeda Baloto de Colombia","paso3":"3. Una vez recibido tu pago V\xeda Baloto,PayU enviar\xe1 la informaci\xf3n de pago a nombre de Fantas\xeda Colombia , que proceder\xe1 a hacer la entrega del producto /servicio que estas adquiriendo","generarNumeroPago":"Generar n\xfamero de pago","cargando":"Cargando...","transaccionEstado":"Tu transacci\xf3n se encuentra en estado {{declined}}","fecha":"Fecha:","referenciaPago":"Referencia de Pago:","medioPago":"Medio de pago","resumenCompra":"Resumen de la compra","referencia":"Referencia:","descripcion":"Descripci\xf3n:","deposito":"D\xe9posito Betplay","totalPagar":"Total a pagar:............................................"},"popUpTransactionDeclined":{"closeAltText":"Cerrar","message":"Hola, te informamos que tu transacci\xf3n ha sido rechazada, te invitamos a revisar los l\xedmites de tu banco.","okButton":"Ok"},"payutarjeta":{"creditoDebitoTitulo":"Tarjeta de cr\xe9dito o d\xe9bito","cambiarMetodoPago":"Cambiar metodo de pago","nombreEnTarjeta":"Nombre en la tarjeta*","documentoIdentificacion":"Documento de identificaci\xf3n*","numeroDeTarjeta":"N\xfamero de tarjeta*","codigoSeguridad":"C\xf3digo de seguridad*","codigoSeguridadInfo":"CVV/CVC","fechaVencimiento":"Fecha de vencimiento*","cuotas":"Cuotas*","telefonoCelular":"Tel\xe9fono celular*","botonPagar":"Pagar","cargando":"Cargando....","transaccionEstado":"Tu transacci\xf3n se encuentra en estado","fecha":"Fecha:","referenciaPago":"Referencia de Pago:","medioPago":"Medio de pago","recordatorioReferenciaPago":"Recuerda guardar la referencia de pago en caso de que desees hacer seguimiento a tu transacci\xf3n en la p\xe1gina de consulta de transacciones de PayU o con nuestro equipo de servicio al cliente.","resumenCompra":"Resumen de la compra","referencia":"Referencia:","descripcion":"Descripci\xf3n:","descripcionContenido":"Dep\xf3sito Betplay","totalPagar":"Total a pagar:","validoHasta":"VALID THRU"},"nuvei":{"printReceiptButton":"Imprimir Comprobante","endTransactionButton":"Finalizar Transacci\xf3n"},"mecanicasLealtadText":{"mecanicaGeneral":"Mec\xe1nica General","debesTenerEnCuenta":"Debes tener en cuenta todas las condiciones expuestas en el siguiente documento para poder redimir premios en el BetPlayers Club:","soloParticipanMayores":"Solo podr\xe1n participar personas mayores de edad, de nacionalidad colombiana y residentes en Colombia legalmente.","soloParticipanActivos":"Solo podr\xe1n participar personas que su estado de cuenta sea ACTIVO.","numeroMaximoBonos":"Se entregar\xe1 un n\xfamero m\xe1ximo de Bonos o Freebet\xb4s seg\xfan como lo considere BetPlay.","inventarioMaximoDia":"BetPlayers contar\xe1 con un inventario M\xe1ximo por d\xeda que podr\xe1 ser redimido por cualquier usuario que cumpla con la condici\xf3n M\xednima de puntos.","excluidosPromocion":"Por reglamentaci\xf3n de Coljuegos se consideran excluidos de la promoci\xf3n, registros, recargas y apuestas en BetPlay.com.co con permiso especial de permanencia (PEP).","puedeHacerseAcreedor":"Una persona podr\xe1 hacerse acreedor de los premios que pueda redimir con los puntos disponibles que tenga en su cuenta.","periodoFinalizacion":"El periodo de finalizaci\xf3n de esta campa\xf1a ser\xe1 definido por Betplay, por el momento est\xe1 vigente mientras este anunciada.","ganadorNoCumpleInfo":"En caso de que alguno de los ganadores acepte el premio, pero no cumpla la informaci\xf3n disponible para recibir el premio, no se permitir\xe1 redimir los puntos hasta que realice actualizaci\xf3n de datos.","premioNoRedimible":"El premio no podr\xe1 redimirse o compensarse de diferente forma a la que sugiere la promoci\xf3n.","premioNoTransferible":"El premio no podr\xe1 ser transferido a otra persona, no estar\xe1 permitida la reventa por los ganadores.","betplayPuedeDescalificar":"BetPlay podr\xe1 descalificar al participante que incurra en conductas irregulares, cometa fraudes o practique acciones contrarias a la ley o contrarias a estos t\xe9rminos y condiciones.","terminosModificables":"Los t\xe9rminos y condiciones de la actividad podr\xe1n ser modificados por BetPlay sin previo aviso.","informacionEnEspanol":"Toda la informaci\xf3n relacionada ser\xe1 suministrada en idioma espa\xf1ol.","aceptacionTerminos":"Al participar en BetPlayers Club, los participantes manifiestan su aceptaci\xf3n a los presentes t\xe9rminos y condiciones.","comoRedimoPremios":"\xbfC\xf3mo redimo los premios?","ahoraVieneMasInteresante":"Ahora viene lo m\xe1s interesante, una vez tengas tus puntos acumulados puedes entrar al catalogo y revisar a cu\xe1les premios puedes acceder y empezar a redimir, teniendo en cuenta los siguientes puntos:","premiosRedimirPuntos":"Los premios los puedes redimir usando tus puntos acumulados. Cada beneficio expuesto en el catalogo de premios tiene un indicador que te confirma cu\xe1ntos puntos vale el premio seg\xfan la categor\xeda en la que te encuentres.","usuarioRecibeBono":"Cuando el usuario redima un bono de juego o apuesta gratis, lo recibir\xe1 de manera inmediata, una vez se descuenten los puntos.","premiosPuedenVariar":"Los premios del BetPlayers Club pueden variar en premios tangibles, elementos oficiales de BetPlay o sus aliados y bonos y apuestas gratis.","usuarioRedimePremioTangible":"Si un usuario quiere redimir un premio tangible, debe tener en cuenta que debe t